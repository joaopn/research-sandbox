#!/usr/bin/env bash
# rs-repo-watch — manual post-auth launcher for the dev repo-watch loop.
#
# Runs /opt/dev/repo-watch.sh in THIS terminal — it blocks until you stop it.
# Background it yourself with `&` if you want the shell back. Deliberately never
# entrypoint-started: dev surfaces boot credential-less, and repo-watch needs a
# logged-in `claude` — run `claude` and complete /login first, then start this.
#
# One watcher at a time: a lock file is created at start and removed on exit.
# Two watchers would both poll the same issues and both drive the agent. The
# lock lives on tmpfs (/dev/shm), so a container restart clears it — after a
# restart nothing is running, so nothing should be locked.
#
# Wiring resolution:
#   - dev BOX: GITEA_URL/TOKEN/USER + REPO_NAME arrive as container env — used
#     as-is.
#   - dev PROJECT (supervisor): read the host-staged non-secret
#     .orchestrator/dev-gitea.json — the row's agent_user/token_file are the
#     PROJECT's OWN consumer identity (per-consumer forks; the row's `user` is
#     the ACTIVE fork for fetch-side readers, not necessarily ours). A dev
#     project's agent works exactly ONE repo, so there is nothing to pick.
#
# Usage: rs-repo-watch
#   Stop it:   Ctrl+C
#   Background it: rs-repo-watch &

set -euo pipefail

WATCH="/opt/dev/repo-watch.sh"

if [[ -z "${GITEA_TOKEN:-}" ]]; then
    # Supervisor path: resolve from the host-staged state.
    DEV_JSON="${RS_WORKSPACE:-/workspace}/.orchestrator/dev-gitea.json"
    if [[ ! -f "$DEV_JSON" ]]; then
        echo "rs-repo-watch: no dev wiring ($DEV_JSON missing);" \
             "run 'research dev attach <project> --repo <repo>' first" >&2
        exit 1
    fi
    OUT="$(python3 - "$DEV_JSON" <<'PYEOF'
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except (OSError, ValueError) as e:
    sys.exit(f"rs-repo-watch: cannot read dev wiring: {e}")
# A dev project's agent works exactly ONE repo. Rows without an agent_user are
# box-only repos — OTHER containers' wiring, where this project's agent has no
# identity — so keep only the agent-bearing row (there is at most one).
repos = [r for r in (data.get("repos") or [])
         if isinstance(r, dict) and r.get("repo") and r.get("agent_user")]
if not repos:
    sys.exit("rs-repo-watch: this project's own agent works no repo "
             "(box-only wiring?); run 'research dev attach' first")
print(repos[0]["repo"], repos[0]["agent_user"],
      repos[0].get("token_file") or repos[0]["agent_user"] + ".token")
PYEOF
)"
    read -r REPO_NAME GITEA_USER TOKEN_BASE <<<"$OUT"
    TOKEN_FILE="$HOME/.dev-tokens/${TOKEN_BASE}"
    if [[ ! -s "$TOKEN_FILE" ]]; then
        echo "rs-repo-watch: token missing at $TOKEN_FILE;" \
             "re-run 'research dev attach' (it re-stages the token)" >&2
        exit 1
    fi
    GITEA_TOKEN="$(cat "$TOKEN_FILE")"
    GITEA_URL="http://rs-gitea:3000"
else
    : "${GITEA_URL:?GITEA_URL must be set alongside GITEA_TOKEN}"
    : "${GITEA_USER:?GITEA_USER must be set alongside GITEA_TOKEN}"
    : "${REPO_NAME:?REPO_NAME must be set alongside GITEA_TOKEN}"
fi
REPO_DIR="${REPO_DIR:-/workspace/${REPO_NAME}}"

if [[ ! -d "${REPO_DIR}/.git" ]]; then
    echo "rs-repo-watch: ${REPO_DIR} is not a git clone; is the repo attached/cloned?" >&2
    exit 1
fi

# tmpfs, not $HOME: /dev/shm is cleared on every container restart, so a
# leftover lock never outlives the watcher that made it (a container stop ends
# in SIGKILL, which runs no trap — a $HOME lock would then survive into the
# next boot and refuse forever).
LOCK="/dev/shm/repo-watch.lock"
if [[ -e "$LOCK" ]]; then
    echo "rs-repo-watch: a watcher is already running here (lock: $LOCK)." \
         "If it is not — a crash, not a restart — delete that file and retry." >&2
    exit 1
fi
touch "$LOCK"
# EXIT covers normal exit; HUP/INT/TERM are the routine ways a foreground
# blocking command ends (ssh drop, Ctrl+C, `research project stop`) and do NOT
# fire an EXIT trap on their own. rm -f is idempotent, so a double fire is safe.
trap 'rm -f "$LOCK"' EXIT HUP INT TERM

# repo-watch.sh reads its wiring from the environment, so every var it
# dereferences must be EXPORTED, not just set: it runs under `set -u` and
# derefs GITEA_URL/GITEA_USER at startup, so a missed export is an
# "unbound variable" death. On the supervisor path these are plain locals,
# and REPO_DIR is a plain assignment on both paths.
export GITEA_URL GITEA_TOKEN GITEA_USER REPO_NAME REPO_DIR

# Run as a CHILD, not exec: exec would clear the EXIT trap above and leak the
# lock. Ctrl+C reaches the child anyway — it is in this foreground process
# group — and the trap then removes the lock.
echo "rs-repo-watch: watching ${GITEA_USER}/${REPO_NAME} (Ctrl+C to stop)"
"$WATCH"

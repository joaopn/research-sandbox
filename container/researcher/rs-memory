def cmd_skill_list(a) -> None:
    root = mem_dir() / "skills"
    uses: "dict[str, list[int]]" = {}
    for p in skill_log():
        if len(p) >= 3 and p[1] in ("used-ok", "used-failed"):
            c = uses.setdefault(p[2], [0, 0])
            c[0 if p[1] == "used-ok" else 1] += 1
    rows = []
    for state in ("active", "candidates"):
        d = root / state
        if d.is_dir():
            for s in sorted(d.iterdir()):
                if s.is_dir():
                    ok, bad = uses.get(s.name, [0, 0])
                    rows.append(f"{s.name} ({'active' if state == 'active' else 'candidate'}): "
                                f"{ok} ok, {bad} failed")
    print("\n".join(rows) if rows else "no skills")



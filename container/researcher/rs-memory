# ---------------------------------------------------------------- reading
def _entry_line(e: dict, st: "dict[str, str]", rec: "dict[str, dict]") -> str:
    s = st.get(e["id"], "staged")
    extra = ""
    u = undermined(rec, st, e["id"]) if e["id"] in rec else []
    if u:
        extra = f"  [rests on {', '.join(u)}]"
    scope = one(e, "scope")
    return f"{e['id']} ({s}) {e['headline']}" + (f" — scope: {scope}" if scope else "") + extra


def knowledge_groups(rec: "dict[str, dict]", st: "dict[str, str]",
                     topic: "str | None" = None) -> dict:
    """The state of knowledge's parts: current findings, current facts (oldest
    first), contested entries and open questions. Read by `view` and `open`,
    and by the pages the PI reads."""
    def keep(e):
        return topic is None or topic in e.get("topic", [])

    cur = [e for i, e in rec.items() if st[i] == "current" and keep(e) and not i.startswith("D-")]
    facts = sorted(((int(i[2:]), e) for i, e in rec.items()
                    if st[i] == "current" and keep(e) and i.startswith("D-")),
                   key=lambda t: t[0])
    return {"findings": cur, "facts": [e for _n, e in facts],
            "contested": [e for i, e in rec.items() if st[i] == "contested" and keep(e)],
            "questions": [e for i, e in rec.items() if st[i] == "open" and keep(e)]}


def knowledge_text(topic: "str | None" = None) -> str:
    rec = record_entries()
    st = standing(rec)
    g = knowledge_groups(rec, st, topic)
    cur, contested, questions = g["findings"], g["contested"], g["questions"]
    facts = [(None, e) for e in g["facts"]]
    out = ["## State of knowledge" + (f" — topic {topic}" if topic else "")]
    out.append("Current findings:" if cur else "Current findings: none")
    out += ["  " + _entry_line(e, st, rec) for e in cur]
    out.append("Current facts about the data:" if facts else "Current facts about the data: none")
    out += ["  " + _entry_line(e, st, rec) for _n, e in facts]
    if contested:
        out.append("Contested (contradict each other):")
        for e in contested:
            others = [o for o in e.get("contradicts", []) if st.get(o) == "contested"]
            out.append("  " + _entry_line(e, st, rec) + (f"  <-> {', '.join(others)}" if others else ""))
    out.append("Open questions:" if questions else "Open questions: none")
    out += ["  " + _entry_line(e, st, rec) for e in questions]
    return "\n".join(out)


def staged_text(checks: bool = False, topic: "str | None" = None) -> str:
    staged = sorted((i, p) for i, (w, p) in claim_files().items() if w == "staged")
    if topic is not None:
        staged = [(i, p) for i, p in staged if topic in parse_entry(p).get("topic", [])]
    if not staged:
        return "## Staged claims\nnone"
    out = ["## Staged claims (waiting for the PI's accept)"]
    for i, p in staged:
        e = parse_entry(p)
        out.append(f"  {i} {e['headline']} — scope: {one(e, 'scope')}; hedge: {one(e, 'hedge')}")
        if checks and i.startswith("F-"):
            out += check_lines(i, e, "      ")
    return "\n".join(out)


def cmd_view(a) -> None:
    if a.id:
        files = claim_files()
        if a.id not in files:
            raise Refused(f"no claim {a.id}")
        where, path = files[a.id]
        rec = record_entries()
        st = standing(rec)
        print(path.read_text(encoding="utf-8").rstrip())
        print(f"\nstanding: {st.get(a.id, where)}")
        u = undermined(rec, st, a.id)
        if u:
            print(f"rests on entries that no longer stand: {', '.join(u)}")
        # The chain: what this entry points at, and what points at it.
        e = parse_entry(path)
        for rel in RELATIONS:
            for o in e.get(rel, []):
                oe = rec.get(o)
                print(f"{rel} {o}: " + (f"{oe['headline']} ({st[o]})" if oe else "(not in the record)"))
        for o, oe in rec.items():
            for rel in RELATIONS:
                if a.id in oe.get(rel, []):
                    print(f"{o} {rel} it: {oe['headline']} ({st[o]})")
        if where == "staged" and a.id.startswith("F-") and checks_kit():
            print("\n".join(check_lines(a.id, e, "")))
        return
    print(knowledge_text(a.topic))
    if checks_kit():
        print("\n" + staged_text(True, a.topic))


def cmd_recall(a) -> None:
    words = [w.lower() for w in a.words]
    hits = []
    for _n, f in journal_files():
        e = parse_entry(f)
        text = e["headline"] + ("\n" + e["body"] if a.body else "")
        if all(w in text.lower() for w in words):
            hits.append(f"{e['id']} [{one(e, 'kind')}] {one(e, 'time')[:10]} {e['headline']}")
    for ident, (where, path) in sorted(claim_files().items()):
        if where == "struck":
            continue
        e = parse_entry(path)
        text = e["headline"] + ("\n" + "\n".join(f"{k}: {' '.join(v)}" for k, v in e.items()
                                                   if isinstance(v, list)) if a.body else "")
        if all(w in text.lower() for w in words):
            hits.append(f"{ident} [{where}] {e['headline']}")
    for e in logbook_state()[0]:
        rel = one(e, "entry")
        text = e["headline"]
        if a.body:
            full = read_logbook_entry(rel)
            text = full if full is not None else text
        if all(w in text.lower() for w in words):
            hits.append(f"{rel} [logbook] {one(e, 'time')[:10]} {e['headline']}")
    print("\n".join(hits) if hits else "nothing matches")


# ------------------------------------------------------------ the PI's pages
# The memory folder is the agent's own. The PI reads pages written from it,
# beside it in the workspace: the front page README.md, staging/<id>.md (a
# claim waiting for the PI), results/<id>/<id>.md (an accepted entry, with a
# frozen copy of its evidence in results/<id>/evidence/) and results/index.md.
# They are views: the store under the memory folder stays the single source
# of truth, and every page is rebuilt from it, under the lock, after each verb
# that changes what a page shows and at open. A page is written only when its
# text changed. rs-memory writes, and removes, only files that carry its
# marker on their first line; anything else at a page's name is left alone and
# reported, every time, until the PI moves it.
PAGE_MARKER = "<!-- rs-memory: a page written from the researcher's record -->"
PAGE_FOOTER = ("*This page is rebuilt by rs-memory from the researcher's record: "
               "an edit made in it is lost at the next change.*")
FRONT_PAGE = "README.md"
# A companion's task folders, one per task, each with its README.md.
TASKS_DIR = "analyses"
STAGING_DIR = "staging"
RESULTS_DIR = "results"
RESULTS_INDEX = "index.md"
EVIDENCE_DIR = "evidence"
# Beside an evidence file's place in evidence/ when no copy could be kept for
# an entry accepted before the copies existed (its file had changed or gone):
# the page reads it instead of hashing the file again at every command.
NOT_KEPT_SUFFIX = ".not-kept.md"
KIND_WORDS = {"F": "finding", "D": "fact about the data", "Q": "open question", "R": "retraction"}
RELATION_WORDS = {"supersedes": "Supersedes", "contradicts": "Contradicts",
                  "withdraws": "Withdraws", "depends-on": "Depends on", "answers": "Answers"}
# CommonMark lets any ASCII punctuation be escaped with a backslash; these are
# the characters that would otherwise turn a statement into markup (a link,
# emphasis, code, a table cell's end, HTML).
_MD_SPECIAL_RE = re.compile(r"([\\`*_\[\]<>|~#])")
_MD_LEAD_RE = re.compile(r"\A(\s*)([-+=]|\d+(?=[.)]))")
_CLAIM_REF_RE = re.compile(r"\b([FQRD]-[1-9][0-9]*)\b")
_EARLIER_RE = re.compile(r"^## Earlier version, amended (\S+)\n\n    # \S+ — (.*)$", re.M)
_BRACKET_PATH_RE = re.compile(r"\[([^\[\]]+)\]\s*\Z")
# The tail of a check record's path, which the record names in full: read
# from this memory folder, so a workspace moved under another parent still
# finds its checks.
_CHECK_TAIL_RE = re.compile(r"/checks/([FQRD]-[1-9][0-9]*)/([1-9][0-9]*)/(verdict|rerun)\.md\Z")
_NARROWER_LINE_RE = re.compile(r"^" + re.escape(NARROWER_MARK) + r" (.*)$", re.M)

# What a verb's page refresh could not do, printed when the verb ends (and by
# open, at every session start, until it is resolved).
PAGE_PROBLEMS: "list[str]" = []


def md_escape(text: str) -> str:
    return _MD_SPECIAL_RE.sub(r"\\\1", text)


def md_lead(text: str) -> str:
    """Keep a line's start from reading as a list item or a heading rule."""
    return _MD_LEAD_RE.sub(lambda m: m.group(1) + m.group(2) + "\\" if m.group(2)[0].isdigit()
                           else m.group(1) + "\\" + m.group(2), text, count=1)


def md(text: str) -> str:
    """Plain text as markdown that shows exactly that text, on one line."""
    return md_lead(md_escape(single_line(text)))


def fmt_time(stamp: str) -> str:
    """2026-11-24T10:03:00Z as 2026-11-24 10:03 UTC."""
    m = re.match(r"\A(\d{4}-\d\d-\d\d)T(\d\d:\d\d)", stamp or "")
    return f"{m.group(1)} {m.group(2)} UTC" if m else (stamp or "?")


def pages_root() -> Path:
    return folder()


def staging_page(ident: str) -> Path:
    return pages_root() / STAGING_DIR / f"{ident}.md"


def result_page(ident: str) -> Path:
    return pages_root() / RESULTS_DIR / ident / f"{ident}.md"


def evidence_copy_dir(ident: str) -> Path:
    return pages_root() / RESULTS_DIR / ident / EVIDENCE_DIR


def in_workspace(path: str) -> bool:
    root = os.path.abspath(str(pages_root()))
    p = os.path.abspath(path)
    try:
        return os.path.commonpath([root, p]) == root
    except ValueError:
        return False


def rel_link(page: Path, target: "str | Path", text: str) -> str:
    """A link from a page to a file, relative to the page's folder."""
    rel = os.path.relpath(os.path.abspath(str(target)), os.path.abspath(str(page.parent)))
    return f"[{md(text)}]({urllib.parse.quote(rel)})"


def file_ref(page: Path, path: str, text: "str | None" = None) -> str:
    """A file the record names: a link when it is in the workspace and there,
    else its path as text."""
    shown = text if text is not None else (
        os.path.relpath(os.path.abspath(path), os.path.abspath(str(pages_root())))
        if in_workspace(path) else path)
    if in_workspace(path) and os.path.isfile(path):
        return rel_link(page, path, shown)
    if in_workspace(path):
        return f"{md(shown)} (not there now)"
    return md(shown)


def page_text(lines: "list[str]") -> str:
    kept: "list[str]" = []
    for line in lines:                          # one blank line between blocks
        if line.strip() or (kept and kept[-1].strip()):
            kept.append(line)
    while kept and not kept[-1].strip():
        kept.pop()
    return "\n".join([PAGE_MARKER, ""] + kept + ["", "---", "", PAGE_FOOTER]) + "\n"


def read_page(path: Path) -> "tuple[str, str]":
    """("absent" | "ours" | "foreign", the text when ours). A link, a folder or
    a pipe at the name is foreign; it is opened without following or
    blocking."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return "absent", ""
    if not stat.S_ISREG(st.st_mode):
        return "foreign", ""
    fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        head = os.read(fd, len(PAGE_MARKER.encode("utf-8")) + 1)
        if head != (PAGE_MARKER + "\n").encode("utf-8"):
            return "foreign", ""
        chunks = [head]
        while True:
            b = os.read(fd, 1 << 16)
            if not b:
                break
            chunks.append(b)
    finally:
        os.close(fd)
    return "ours", b"".join(chunks).decode("utf-8", errors="replace")


def page_folder(d: Path, made: "list[Path] | None" = None) -> "Path | None":
    """Make the folder d (under the workspace) as needed; None when it is a
    folder now, else the path in the way (a file or a link: never followed).
    The folders it made are appended to `made`."""
    root = pages_root()
    cur = root
    for part in d.relative_to(root).parts:
        cur = cur / part
        try:
            st = os.lstat(cur)
        except FileNotFoundError:
            os.mkdir(cur)
            if made is not None:
                made.append(cur)
            continue
        if not stat.S_ISDIR(st.st_mode):
            return cur
    return None


BLOCKED_REMEDY = ("rs-memory leaves it as it is. Tell the PI: once they move or rename it, the "
                  "page is written at the next session start, or sooner at the next change it "
                  "shows.")


def blocked_message(path: Path, what: str) -> str:
    return (f"{what} was not written: {path} is there and rs-memory did not write it (it has no "
            f"rs-memory marker on its first line, or it is not a plain file). {BLOCKED_REMEDY}")


def blocked_folder_message(path: Path, what: str) -> str:
    return (f"{what} could not be written: {path} should be a folder of pages, and a file or a "
            f"link that rs-memory did not write is there. {BLOCKED_REMEDY}")


class PageWriter:
    def __init__(self):
        self.problems: "dict[str, str]" = {}

    def put(self, path: Path, text: str, what: str) -> bool:
        """Write one page when its text changed; False when it could not be."""
        try:
            blocked = page_folder(path.parent)
            if blocked is not None:
                self.problems.setdefault(str(blocked), blocked_folder_message(
                    blocked, f"The pages in {blocked.name}/ ({what} among them)"))
                return False
            state, old = read_page(path)
            if state == "foreign":
                self.problems.setdefault(str(path), blocked_message(path, what))
                return False
            if state == "ours" and old == text:
                return True
            write_text(path, text)
            return True
        except OSError as e:
            self.problems.setdefault(str(path), f"{what} was not written: {path}: "
                                     f"{e.strerror or e}")
            return False

    def remove_stale_staging(self, staged: "set[str]") -> None:
        """A staging page whose claim is no longer staged goes: that file, by
        name, and only when it carries the marker."""
        d = pages_root() / STAGING_DIR
        try:
            if not stat.S_ISDIR(os.lstat(d).st_mode):
                return
            names = os.listdir(d)
        except OSError:
            return
        for name in sorted(names):
            ident = name[:-3] if name.endswith(".md") else ""
            if not CLAIM_ID_RE.match(ident) or ident in staged:
                continue
            p = d / name
            try:
                if read_page(p)[0] == "ours":
                    os.unlink(p)
            except OSError as e:
                self.problems.setdefault(str(p), f"{p} (the page of a claim no longer waiting) "
                                         f"could not be removed: {e.strerror or e}")


# ---------------------------------------------- the PI's pages: evidence
def evidence_names(meta: dict) -> "list[tuple[str, str, str]]":
    """(path, pinned sha256, name of its copy) per evidence file. Names are the
    base names; when two share one, every name gets its place in the list in
    front (1-gaps.csv, 2-gaps.csv), so each copy has a distinct name that the
    same entry always gives again."""
    ev = staged_evidence(meta)
    bases = [Path(p).name for p, _d in ev]
    clash = len(set(bases)) != len(bases)
    return [(p, d, f"{i}-{b}" if clash else b) for i, ((p, d), b) in enumerate(zip(ev, bases), 1)]


def freeze_evidence(ident: str, meta: dict, made_files: "list[Path]",
                    made_dirs: "list[Path]") -> None:
    """Copy each evidence file into results/<id>/evidence/, read-only, and
    check the copy against the hash pinned on the entry; refuse when a copy
    cannot be made. A copy already there with the pinned hash (an accept that
    was refused after it) is kept. An entry without evidence (a question, a
    retraction) gets no folder."""
    if not evidence_names(meta):
        return
    d = evidence_copy_dir(ident)
    try:
        blocked = page_folder(d, made_dirs)
    except OSError as e:
        raise Refused(f"{ident} was not accepted: its evidence cannot be copied into {d} "
                      f"({e.strerror or e}); nothing moved")
    if blocked is not None:
        raise Refused(f"{ident} was not accepted: {blocked} is in the way of the copy of its "
                      "evidence (a file or a link, not a folder), and rs-memory does not move "
                      "it; nothing moved. Tell the PI: once they move or rename it, accept again")
    for path, digest, name in evidence_names(meta):
        dest = d / name
        if os.path.lexists(dest):
            ok = False
            try:
                st = os.lstat(dest)
                ok = stat.S_ISREG(st.st_mode) and sha256_file(str(dest)) == digest
            except OSError:
                pass
            if ok:
                continue
            raise Refused(f"{ident} was not accepted: {dest} is in the way of the copy of its "
                          f"evidence {path}, and rs-memory does not overwrite it; nothing moved. "
                          "Tell the PI: once they move or rename it, accept again")
        try:
            got = copy_hashed(path, dest)
        except OSError as e:
            raise Refused(f"{ident} was not accepted: its evidence {path} could not be copied "
                          f"to {dest} ({e.strerror or e}); nothing moved")
        made_files.append(dest)
        if got != digest:
            raise Refused(f"{ident} was not accepted: its evidence {path} changed while it was "
                          f"copied; check the claim still holds and correct it with rs-memory "
                          f"amend {ident} --evidence <file> …; nothing moved")


def freeze_all_evidence(entries: "list[tuple[str, dict]]") -> None:
    """freeze_evidence for every entry of one accept; on a refusal the copies
    and folders this call made are removed again, by name."""
    made_files: "list[Path]" = []
    made_dirs: "list[Path]" = []
    try:
        for ident, meta in entries:
            freeze_evidence(ident, meta, made_files, made_dirs)
    except Refused:
        for f in made_files:
            try:
                os.unlink(f)
            except OSError:
                pass
        for d in reversed(made_dirs):
            try:
                os.rmdir(d)
            except OSError:
                pass
        raise


def heal_evidence(ident: str, meta: dict, w: PageWriter) -> "dict[str, str]":
    """An accepted entry's frozen copies, made now when one is missing and its
    file still has the pinned hash (an entry accepted before the copies
    existed); else a note that no copy was kept. A copy is never rewritten.
    Returns name -> "copy" | "not-kept" | "blocked"."""
    if not evidence_names(meta):
        return {}
    d = evidence_copy_dir(ident)
    out = {}
    try:
        blocked = page_folder(d)
    except OSError as e:
        w.problems.setdefault(str(d), f"the evidence copies of {ident} were not made: {d}: "
                              f"{e.strerror or e}")
        return {name: "blocked" for _p, _d, name in evidence_names(meta)}
    if blocked is not None:
        w.problems.setdefault(str(blocked), blocked_folder_message(
            blocked, f"The evidence copies of {ident}"))
        return {name: "blocked" for _p, _d, name in evidence_names(meta)}
    for path, digest, name in evidence_names(meta):
        dest, note = d / name, d / (name + NOT_KEPT_SUFFIX)
        if os.path.lexists(dest):
            st = os.lstat(dest)
            out[name] = "copy" if stat.S_ISREG(st.st_mode) else "blocked"
            if out[name] == "blocked":
                w.problems.setdefault(str(dest), blocked_message(
                    dest, f"the evidence copy of {ident}"))
            continue
        if read_page(note)[0] == "ours":
            out[name] = "not-kept"
            continue
        try:
            same = sha256_file(path) == digest
        except OSError:
            same = False
        if same:
            try:
                got = copy_hashed(path, dest)
            except OSError as e:
                w.problems.setdefault(str(dest), f"the evidence copy {dest} was not made: "
                                      f"{e.strerror or e}")
                out[name] = "blocked"
                continue
            if got == digest:
                out[name] = "copy"
                continue
            os.unlink(dest)                     # changed while copied: not the accepted file
        w.put(note, page_text([
            f"# {ident} · {md(name)}: no copy kept", "",
            f"{md(path)} had changed, or was gone, when rs-memory first made the copies of "
            f"{ident}'s evidence, after {ident} was accepted; no copy was kept of a file that is "
            "no longer the one accepted."]), f"the note on {ident}'s evidence")
        out[name] = "not-kept"
    return out


# ------------------------------------------------ the PI's pages: wording
def entry_title(e: dict) -> str:
    """A claim's title; an entry from before titles shows its statement."""
    return one(e, "title") or e["headline"]


class PageContext:
    """What every page is built from, read once per refresh."""

    def __init__(self):
        self.files = claim_files()
        self.rec = record_entries()
        self.st = standing(self.rec)
        self.staged = {i: parse_entry(p) for i, (w, p) in self.files.items() if w == "staged"}
        # The pages are the project's, whichever session writes them: they
        # show a finding's checks wherever the project has them.
        self.checks = checks_kit()
        self.companion = companion_on()
        # The project's top front page lists the work packages when the
        # planner is on; a package's own page names its package.
        self.package = current_package()
        self.planner = self.package is None and planner_read()
        # Who points at whom, for "superseded by" and the like.
        self.by: "dict[tuple[str, str], list[str]]" = {}
        for o, oe in self.rec.items():
            for rel in RELATIONS:
                for t in oe.get(rel, []):
                    self.by.setdefault((rel, t), []).append(o)
        self._checks: "dict[str, tuple[str, list[dict]]]" = {}

    def check_words(self, ident: str) -> "tuple[str, list[dict]]":
        """A staged finding's checks in plain words, worked out once per
        refresh (it hashes the evidence)."""
        if ident not in self._checks:
            e = self.staged[ident]
            fc = finding_checks(ident, e)
            if one(e, "checks") == "off" and not (fc["reruns"] or fc["refs"]):
                self._checks[ident] = (UNCHECKED_STAGED_WORDS, [])
            else:
                self._checks[ident] = staged_check_words(fc)
        return self._checks[ident]

    def page_of(self, ident: str) -> "Path | None":
        if ident in self.rec:
            return result_page(ident)
        if ident in self.staged:
            return staging_page(ident)
        return None

    def entry(self, ident: str) -> "dict | None":
        return self.rec.get(ident) or self.staged.get(ident)

    def ref(self, page: Path, ident: str) -> str:
        """Another entry, linked to its page, with its title."""
        e, target = self.entry(ident), self.page_of(ident)
        if e is None or target is None:
            where = self.files.get(ident, (None,))[0]
            return md(ident) + (" (struck)" if where == "struck" else " (not in the record)")
        return rel_link(page, target, f"{ident} · {entry_title(e)}")

    def refs(self, page: Path, ids: "list[str]") -> str:
        return ", ".join(self.ref(page, i) for i in ids)

    def linkify(self, page: Path, text: str) -> str:
        """Plain text with each claim id it names linked to that entry's page."""
        text = single_line(text)
        out, last = [], 0
        for m in _CLAIM_REF_RE.finditer(text):
            target = self.page_of(m.group(1))
            if target is None:
                continue
            out.append(md_escape(text[last:m.start()]))
            out.append(rel_link(page, target, m.group(1)))
            last = m.end()
        out.append(md_escape(text[last:]))
        return md_lead("".join(out))


# A staged finding staged with the checks off and never checked since.
UNCHECKED_STAGED_WORDS = "not checked (staged with the checks off)"


def rerun_words(rec: dict) -> str:
    """A re-run record in plain words."""
    rc = one(rec, "exit")
    res = [line.rpartition(" -> ") for line in rec.get("compare", [])]
    same = [Path(p).name for p, _s, r in res if r == "same"]
    if rc == "0" and res and len(same) == len(res):
        return f"reproduced exactly, {len(res)} of {len(res)} files"
    out = f"ran (exit {rc}): {len(same)} of {len(res)} files the same"
    for word in ("differs", "not produced"):
        names = [Path(p).name for p, _s, r in res if r == word]
        if names:
            out += f"; {word}: {', '.join(names)}"
    return out


def staged_check_words(fc: dict) -> "tuple[str, list[dict]]":
    """A staged finding's checks in plain words, and the current verdicts that
    object."""
    if fc["changed"]:
        return (f"void: its evidence {Path(fc['changed']).name} changed since it was staged "
                "(the agent amends the claim, then runs both checks again)"), []
    reruns, refs = fc["reruns"], fc["refs"]
    if fc["cur_rerun"]:
        r = rerun_words(fc["cur_rerun"][-1]["rec"])
    elif fc["reason"]:
        r = f"not possible: {fc['reason']}"
    elif any(c["state"] == "running" for c in reruns):
        r = "running"
    elif reruns and reruns[-1]["state"] == "failed":
        r = "the last run ended without a result"
    elif not fc["command"]:
        r = "no re-run command yet"
    else:
        r = "not run yet" if not reruns else "not run for its current command"
    if fc["cur_rerun"] and any(c["state"] == "running" for c in reruns):
        r += " (another run is going)"
    if fc["cur_verdicts"]:
        v = one(fc["cur_verdicts"][-1]["rec"], "verdict")
    elif any(c["state"] == "running" for c in refs):
        v = "running"
    elif refs and (refs[-1]["state"] == "failed"
                   or one(refs[-1]["rec"] or {}, "verdict") not in VERDICTS):
        v = "the last run gave no verdict"
    elif refs:
        v = "void: the claim changed since its verdict"
    else:
        v = "not run yet"
    if fc["cur_verdicts"] and any(c["state"] == "running" for c in refs):
        v += " (another run is going)"
    objecting = [c for c in fc["cur_verdicts"] if one(c["rec"], "verdict") in OBJECTIONS]
    return f"re-run: {r} · referee: {v}", objecting


def record_check(e: dict, key: str) -> "dict | None":
    """The check record an accepted finding's field points at ([path] at its
    end), read when it is still there."""
    for line in e.get(key, []):
        m = _BRACKET_PATH_RE.search(line)
        t = _CHECK_TAIL_RE.search(m.group(1)) if m else None
        if t is None:
            continue
        path = checks_dir(t.group(1)) / t.group(2) / f"{t.group(3)}.md"
        try:
            return parse_entry(path)
        except OSError:
            return None
    return None


def accepted_check_words(e: dict) -> "tuple[str | None, dict | None]":
    """An accepted finding's checks in plain words (None when it has none),
    and the verdict it was accepted over, when it was."""
    if not (e.get("referee") or e.get("rerun-check") or e.get("no-rerun") or e.get("unchecked")):
        return None, None
    missing = unchecked_halves(e)
    if len(missing) == 2:
        return "not checked (accepted with the checks off)", None
    rr = record_check(e, "rerun-check")
    if rr is not None:
        r = rerun_words(rr)
    elif one(e, "no-rerun"):
        r = f"not possible: {one(e, 'no-rerun')}"
    elif UNCHECKED_RERUN in missing:
        r = "not checked"
    else:
        r = "on record" if e.get("rerun-check") else "none"
    verdict = record_check(e, "referee")
    if verdict is not None:
        v = one(verdict, "verdict")
    elif UNCHECKED_REFEREE in missing:
        v = "not checked"
    else:
        m = re.match(r"\Acheck \d+: (\w+)", one(e, "referee"))
        v = m.group(1) if m else "on record"
    return f"re-run: {r} · referee: {v}", verdict if e.get("objection") else None


def unchecked_halves(e: dict) -> "list[str]":
    """The checks an accepted finding was accepted without (its `unchecked`
    field, written when the session's checks were off)."""
    v = one(e, "unchecked")
    return [h for h in (UNCHECKED_RERUN, UNCHECKED_REFEREE) if h in v]


def unchecked_words(e: dict) -> str:
    """" · not checked" (or which check it lacks) for an accepted finding
    accepted without its checks; "" otherwise."""
    missing = unchecked_halves(e)
    if len(missing) == 2:
        return " · not checked"
    if missing:
        return f" · {missing[0]} not checked"
    return ""


def standing_line(page: Path, ident: str, ctx: PageContext) -> str:
    s = ctx.st[ident]
    by = lambda rel: [o for o in ctx.by.get((rel, ident), []) if o in ctx.rec]
    if s == "superseded":
        sup = [o for o in by("supersedes") if ctx.st.get(o) != "withdrawn"]
        out = "superseded by " + ctx.refs(page, sup)
    elif s == "withdrawn":
        out = "withdrawn by " + ctx.refs(page, by("withdraws"))
    elif s == "contested":
        others = sorted({o for o in by("contradicts") + ctx.rec[ident].get("contradicts", [])
                         if ctx.st.get(o) == "contested"})
        out = "contested: it and " + ctx.refs(page, others) + " contradict each other"
    elif s == "answered":
        out = "answered by " + ctx.refs(page, [o for o in by("answers")
                                               if ctx.st.get(o) not in ("withdrawn", "superseded")])
    elif s == "retraction":
        out = "a retraction, in force"
    else:
        out = s
    u = [d for d in ctx.rec[ident].get("depends-on", [])
         if ctx.st.get(d) not in ("current", "contested")]
    if u:
        out += ("; it rests on entries that no longer stand: "
                + ", ".join(f"{ctx.ref(page, d)} ({ctx.st.get(d, 'not accepted')})" for d in u))
    return out


def claim_page(ident: str, e: dict, ctx: PageContext, staged: bool,
               copies: "dict[str, str] | None" = None) -> str:
    page = staging_page(ident) if staged else result_page(ident)
    kind = KIND_WORDS[ident[0]]
    status = "waiting for you" if staged else ctx.st[ident]
    lines = [f"# {ident} · {kind} · {status}", ""]
    if one(e, "title"):                         # an entry from before titles has its statement
        lines += [f"**{md(one(e, 'title'))}**", ""]
    lines += [md(e["headline"]), "", "| | |", "|---|---|"]
    if one(e, "scope"):
        lines.append(f"| Applies to | {md(one(e, 'scope'))} |")
    hedge = one(e, "hedge")
    if hedge and hedge != "(none stated)":
        lines.append(f"| Hedge | {md(hedge)} |")
    if e.get("topic"):
        lines.append(f"| Topics | {md(', '.join(e['topic']))} |")
    objecting, accepted_over = [], None
    if ident[0] != "F":
        lines.append(f"| Checks | none needed (a{'n' if kind[0] in 'aeiou' else ''} {kind}) |")
    elif staged and ctx.checks:
        words, objecting = ctx.check_words(ident)
        lines.append(f"| Checks | {md(words)} |")
    elif not staged:
        words, accepted_over = accepted_check_words(e)
        if words:
            lines.append(f"| Checks | {md(words)} |")
    for rel in RELATIONS:
        if e.get(rel):
            lines.append(f"| {RELATION_WORDS[rel]} | {ctx.refs(page, e[rel])} |")
    if not staged:
        lines.append(f"| Accepted | {md(fmt_time(one(e, 'accepted')))} |")
    lines.append("")
    if not staged:
        lines += [f"**Standing:** {standing_line(page, ident, ctx)}.", ""]
    for c in objecting:
        lines += objection_lines(page, one(c["rec"], "verdict"), c["rec"],
                                 c["dir"] / "verdict.md", "The referee objects")
    if accepted_over is not None:
        lines += objection_lines(page, one(accepted_over, "verdict"), accepted_over,
                                 accepted_over["path"], "Accepted over the referee's objection")
    elif not staged and e.get("objection"):
        # Its verdict file is gone: the record's own copy of the objection.
        narrower = _NARROWER_LINE_RE.search(e.get("body", ""))
        lines += [f"**Accepted over the referee's objection** "
                  f"({md(one(e, 'objection'))})."]
        if narrower:
            lines += ["", f"The narrower claim it would accept: {md(narrower.group(1))}"]
        lines.append("")
    lines += evidence_lines(page, ident, e, staged, copies or {})
    earlier = _EARLIER_RE.findall(e.get("body", ""))
    if earlier:
        lines.append("**Earlier versions** (amended before it was accepted):" if not staged
                     else "**Earlier versions:**")
        lines += [f"- until {md(fmt_time(stamp))}: {md(old)}" for stamp, old in earlier]
        lines.append("")
    if staged:
        lines += decide_lines(ident, objecting)
    return page_text(lines)


def objection_lines(page: Path, verdict: str, rec: dict, path: "Path | None",
                    lead: str) -> "list[str]":
    out = [f"**{lead}** ({md(verdict)})."]
    if one(rec, "narrower"):
        out += ["", f"The narrower claim it would accept: {md(one(rec, 'narrower'))}"]
    if path is not None:
        out += ["", "Its reasons: " + rel_link(page, path, "the referee's verdict")]
    return out + [""]


def evidence_lines(page: Path, ident: str, e: dict, staged: bool,
                   copies: "dict[str, str]") -> "list[str]":
    ev = evidence_names(e)
    if not ev:
        return []
    if staged:
        # Two files of one name are told apart by where they are.
        clash = any(n != Path(p).name for p, _d, n in ev)
        return ["**Evidence:** " + " · ".join(file_ref(page, p, None if clash else Path(p).name)
                                             for p, _d, _n in ev), ""]
    out = ["**Evidence** (a copy kept when it was accepted, and where the file was):"]
    for path, _d, name in ev:
        state = copies.get(name)
        if state == "copy":
            head = rel_link(page, evidence_copy_dir(ident) / name, name)
        elif state == "not-kept":
            head = (f"{md(name)}: no copy was kept, because the file had changed since it "
                    "was accepted (or was gone) when the copies were made")
        else:
            head = f"{md(name)}: no copy (something else is in the way of it)"
        out.append(f"- {head} · where it was: {file_ref(page, path)}")
    return out + [""]


def decide_lines(ident: str, objecting: "list[dict]") -> "list[str]":
    if objecting:
        return [f"**To decide:** say `accept {ident} over the objection`, or `strike {ident}` "
                "and why."]
    return [f"**To decide:** say `accept {ident}`, or `strike {ident}` and why."]


# ------------------------------------------------ the PI's pages: the lists
def topic_groups(entries: "list[dict]") -> "list[tuple[str | None, list[dict]]]":
    """Entries under each of their topics (alphabetical), then those with none."""
    topics = sorted({t for e in entries for t in e.get("topic", [])}, key=str.lower)
    out = [(t, [e for e in entries if t in e.get("topic", [])]) for t in topics]
    rest = [e for e in entries if not e.get("topic")]
    if rest:
        out.append((None, rest))
    return out


def entry_line(page: Path, e: dict, ctx: PageContext, with_standing: bool) -> str:
    ident = e["id"]
    out = f"- {rel_link(page, result_page(ident), f'{ident} · {entry_title(e)}')} — {KIND_WORDS[ident[0]]}"
    if one(e, "scope"):
        out += f"; applies to {md(one(e, 'scope'))}"
    out += unchecked_words(e)
    if with_standing:
        out += f" — {standing_line(page, ident, ctx)}"
    else:
        u = undermined(ctx.rec, ctx.st, ident)
        if u:
            out += f" — rests on entries that no longer stand: {md(', '.join(u))}"
    return out


def index_page(ctx: PageContext) -> str:
    page = pages_root() / RESULTS_DIR / RESULTS_INDEX
    lines = ["# What was accepted", "",
             "Every entry the PI accepted, by topic, with how it stands now. The "
             + rel_link(page, pages_root() / FRONT_PAGE, "front page") + " has what waits for you.",
             ""]
    if not ctx.rec:
        return page_text(lines + ["Nothing has been accepted yet."])
    entries = sorted(ctx.rec.values(), key=lambda e: (e["id"][0], int(e["id"][2:])))
    for topic, es in topic_groups(entries):
        lines += [f"## {md(topic) if topic else 'Without a topic'}", ""]
        lines += [entry_line(page, e, ctx, True) for e in es]
        lines.append("")
    return page_text(lines)


def running_lines(page: Path, ctx: PageContext) -> "list[str]":
    out = []
    for m, state, last in jobs(False):
        line = f"- {md(m['headline'])} ({md(m['id'])}): {state}"
        if state == "ended" and last:
            line += f"; its log's last line: {md(last)}"
        out.append(line + f" · log: {file_ref(page, one(m, 'log'))}")
    if ctx.checks:
        for ident in sorted(ctx.staged, key=lambda i: (i[0], int(i[2:]))):
            if not ident.startswith("F-"):
                continue
            for c in check_list(ident):
                if c["state"] == "running":
                    what = "re-run" if c["kind"] == "rerun" else "referee"
                    out.append(f"- the {what} of {ctx.ref(page, ident)}, running since "
                               f"{md(fmt_time(one(c['info'], 'started')))}")
    return out


def waiting_lines(page: Path, ctx: PageContext) -> "list[str]":
    """The front page's "Waiting for you": each staged claim and the words to
    decide it."""
    lines = ["## Waiting for you", ""]
    staged = sorted(ctx.staged, key=lambda i: (i[0], int(i[2:])))
    if not staged:
        lines.append("Nothing is waiting for you.")
    for ident in staged:
        e = ctx.staged[ident]
        line = (f"- {rel_link(page, staging_page(ident), f'{ident} · {entry_title(e)}')} — "
                f"{KIND_WORDS[ident[0]]}")
        objecting = []
        if ident.startswith("F-") and ctx.checks:
            words, objecting = ctx.check_words(ident)
            line += f" · {md(words)}"
        phrase = f"accept {ident} over the objection" if objecting else f"accept {ident}"
        lines.append(line + f" · say `{phrase}`, or `strike {ident}` and why")
    if len(staged) > 1:
        lines += ["", f"Several at once: say `accept {' '.join(staged)}` (or name the ones "
                  "you accept), and `strike` with the ids and why for the others."]
    return lines


def running_block(page: Path, ctx: PageContext) -> "list[str]":
    lines = ["", "## Running", "",
             "As the agent's last memory command saw it."]
    running = running_lines(page, ctx)
    lines += [""] + (running or ["Nothing is running."])
    return lines


def standing_block(page: Path, ctx: PageContext, w: PageWriter) -> "list[str]":
    """The front page's "Where things stand", from the agent's own front page."""
    lines = ["", "## Where things stand", ""]
    try:
        front = read_front()
    except Refused as e:
        w.problems.setdefault("front", f"the front page's \"Where things stand\" was not "
                              f"written: {e}")
        front = None
    if front is None or not any(front["parts"].values()):
        lines.append("The agent has not written its own front page yet.")
    else:
        for k, heading, _letter, _c in (COMPANION_PARTS if ctx.companion else RESEARCHER_PARTS):
            items = front["parts"][k]
            if items:
                lines += [f"### {heading}", ""]
                lines += [f"- {ctx.linkify(page, text)}" for _i, text in items]
                lines.append("")
    return lines


def known_block(page: Path, ctx: PageContext, g: dict) -> "list[str]":
    """The front page's "What is known": the current findings and facts by
    topic, the contested pairs, the open questions."""
    lines = ["", "## What is known", ""]
    known = g["findings"] + g["facts"]
    if not known:
        lines.append("No current finding or fact has been accepted yet.")
    for topic, es in topic_groups(known):
        lines += [f"### {md(topic) if topic else 'Without a topic'}", ""]
        lines += [entry_line(page, e, ctx, False) for e in es]
        lines.append("")
    if g["contested"]:
        lines += ["", "### Contested", ""]
        pairs = set()
        for e in g["contested"]:
            for o in e.get("contradicts", []):
                if ctx.st.get(o) == "contested":
                    pairs.add((e["id"], o))
        lines += [f"- {ctx.ref(page, a)} and {ctx.ref(page, b)} contradict each other"
                  for a, b in sorted(pairs)]
        lines.append("")
    lines += ["", "### Open questions", ""]
    lines += ([entry_line(page, e, ctx, False) for e in g["questions"]]
              or ["None."])
    lines += ["", "Everything accepted, with how it stands now: "
              + rel_link(page, pages_root() / RESULTS_DIR / RESULTS_INDEX, "results/index.md")]
    return lines


def task_lines(page: Path, w: PageWriter) -> "list[str]":
    """A companion's "Tasks": one line per folder directly under analyses/, by
    name, linked to its README.md when it has one. Links are never followed:
    a link, a file or anything else that is not a folder is no task."""
    lines = ["", "## Tasks", ""]
    d = pages_root() / TASKS_DIR
    names: "list[str]" = []
    try:
        st = os.lstat(d)
    except FileNotFoundError:
        st = None
    try:
        if st is not None and not stat.S_ISDIR(st.st_mode):
            w.problems.setdefault(str(d), f"the front page's \"Tasks\" lists no task: {d} "
                                  "should be the folder of task folders, and it is not a "
                                  "folder (a link or a file). rs-memory leaves it as it is; "
                                  "tell the PI.")
        elif st is not None:
            for name in sorted(os.listdir(d)):
                if stat.S_ISDIR(os.lstat(d / name).st_mode):
                    names.append(name)
    except OSError as e:
        w.problems.setdefault(str(d), f"the front page's \"Tasks\" lists no task: {d} "
                              f"cannot be read ({e.strerror or e}).")
        names = []
    if not names:
        return lines + ["No task folders yet."]
    for name in names:
        readme = d / name / FRONT_PAGE
        try:
            has_readme = stat.S_ISREG(os.lstat(readme).st_mode)
        except OSError:
            has_readme = False
        lines.append(f"- {rel_link(page, readme, name)}" if has_readme else f"- {md(name)}")
    return lines


def package_inflight(name: str) -> "list[str]":
    """The "In flight" items of a package's own front page (memory/front.md),
    read without following a link; [] when there are none or it cannot be
    read."""
    mem = package_dir(name) / "memory"
    if real_folder(mem) is not True:
        return []
    try:
        text = read_small(mem / "front.md", TEXT_MAX_BYTES).decode("utf-8", errors="replace")
    except (OSError, Unreadable):
        return []
    out, cur = [], False
    heading = part_by_key(RESEARCHER_PARTS)["inflight"][0]
    for line in text.split("\n"):
        if line.startswith("## "):
            cur = line[3:].strip() == heading
            continue
        m = re.match(r"\A- \[I-[1-9][0-9]*\] (.*)\Z", line)
        if cur and m:
            out.append(m.group(1))
    return out


def package_latest_logbook(name: str) -> "tuple[Path, str] | None":
    """A package's latest logbook entry (the last filed, by its file's time)
    and its title; None when it has none. Links are never followed."""
    d = package_dir(name) / LOGBOOK_DIR
    if real_folder(d) is not True:
        return None
    best = None
    try:
        for n in os.listdir(d):
            if n.startswith(".") or not n.endswith(".md"):
                continue
            st = os.lstat(d / n)
            if stat.S_ISREG(st.st_mode) and (best is None or (st.st_mtime, n) > best):
                best = (st.st_mtime, n)
    except OSError:
        return None
    if best is None:
        return None
    try:
        head = read_small(d / best[1], TEXT_MAX_BYTES).decode("utf-8", errors="replace")
    except (OSError, Unreadable):
        head = ""
    first = head.split("\n", 1)[0]
    return d / best[1], (first[2:].strip() if first.startswith("# ") else best[1])


def packages_block(page: Path) -> "list[str]":
    """The project's front page's "Packages", with the planner on: one line
    per package with its state, what waits there, what is in flight, its
    latest logbook entry, linked to its own front page. Read only."""
    lines = ["", "## Packages", "",
             "The work is split into work packages, each worked on in a session of its own, "
             "with its own front page.", ""]
    entries, problems = package_entries()
    if not entries and not problems:
        lines.append("No package yet: the planning session adds them.")
    for e in entries:
        n = e["name"]
        readme = package_dir(n) / FRONT_PAGE
        try:
            linked = stat.S_ISREG(os.lstat(readme).st_mode)
        except OSError:
            linked = False
        out = [rel_link(page, readme, n) if linked else md(n), md(state_words(e["status"]))]
        if e["staged"]:
            out.append(f"waiting for you: {e['staged']} staged")
        flight = package_inflight(n)
        if flight:
            out.append("in flight: " + "; ".join(md(t) for t in flight))
        lb = package_latest_logbook(n)
        if lb:
            out.append("latest logbook entry: " + rel_link(page, lb[0], lb[1]))
        lines.append("- " + out[0] + " — " + " · ".join(out[1:]))
    for n, why in problems:
        lines.append(f"- {md(n)}: not a package rs-memory can read: {md(why)}")
    return lines


def front_page(ctx: PageContext, w: PageWriter) -> str:
    if ctx.companion:
        return companion_front_page(ctx, w)
    page = pages_root() / FRONT_PAGE
    lines = ["# The research, for the PI", "",
             "What the researcher has for you: the claims waiting for your decision (each "
             "with its page in staging/), what is running, where the work stands, and what is "
             "known (each accepted entry with its page in results/), and the logbook, the "
             "story of the work (logbook/). The agent keeps its own memory in memory/, and "
             "every page here is written from it.", ""]
    if ctx.package:
        lines[0] = f"# Work package {md(ctx.package)}, for the PI"
        lines += ["This is one work package of the project, worked on in a session of its own: "
                  "its " + rel_link(page, folder() / CHARTER_FILE, "charter") + " says what it "
                  "covers. The " + rel_link(page, workspace() / FRONT_PAGE, "project's front page")
                  + " lists every package.", ""]
    lines += waiting_lines(page, ctx)
    if ctx.planner:
        lines += packages_block(page)
    lines += running_block(page, ctx)
    lines += standing_block(page, ctx, w)
    lines += [""] + logbook_front_lines(page)
    lines += known_block(page, ctx, knowledge_groups(ctx.rec, ctx.st))
    return page_text(lines)


def companion_front_page(ctx: PageContext, w: PageWriter) -> str:
    """A companion's front page: what waits for the PI only when something
    does, the task folders, and what is known only when something is."""
    page = pages_root() / FRONT_PAGE
    lines = ["# The work, for the PI", "",
             "What the agent has for you: what is running, the tasks it worked on (each in "
             "its folder under analyses/), where things stand, and the logbook, the story of "
             "the work (logbook/). The agent keeps its own memory in memory/, and every page "
             "here is written from it.", ""]
    if ctx.staged:
        lines += waiting_lines(page, ctx)
    lines += running_block(page, ctx)
    lines += task_lines(page, w)
    lines += standing_block(page, ctx, w)
    lines += [""] + logbook_front_lines(page)
    g = knowledge_groups(ctx.rec, ctx.st)
    if any(g[k] for k in ("findings", "facts", "contested", "questions")):
        lines += known_block(page, ctx, g)
    return page_text(lines)


def write_pages() -> "list[str]":
    """Bring every page in line with the store; the caller holds the lock."""
    w = PageWriter()
    ctx = PageContext()
    for ident, e in sorted(ctx.staged.items()):
        w.put(staging_page(ident), claim_page(ident, e, ctx, True),
              f"the staging page of {ident}")
    w.remove_stale_staging(set(ctx.staged))
    for ident, e in sorted(ctx.rec.items()):
        copies = heal_evidence(ident, e, w)
        w.put(result_page(ident), claim_page(ident, e, ctx, False, copies),
              f"the result page of {ident}")
    w.put(pages_root() / RESULTS_DIR / RESULTS_INDEX, index_page(ctx), "the list of results")
    w.put(pages_root() / FRONT_PAGE, front_page(ctx, w), "the PI's front page")
    return list(w.problems.values())


def refresh_pages() -> None:
    """write_pages, never failing the verb that calls it: the store is the
    truth and the verb's result stands; what went wrong is printed when the
    verb ends."""
    if under_strict_guard():
        return
    try:
        PAGE_PROBLEMS.extend(write_pages())
    except Exception as e:                      # a view must never undo the verb
        PAGE_PROBLEMS.append(f"the PI's pages were not brought up to date "
                             f"({type(e).__name__}: {e})")
    if current_package() is None:
        return
    # A package's write: the project's front page lists the packages. The
    # package's lock is held here, and the top's is taken after it (never
    # the other way round).
    try:
        with working_in(top_mem_dir()):
            with Lock():
                PAGE_PROBLEMS.extend(write_pages())
    except Exception as e:
        PAGE_PROBLEMS.append(f"the project's front page was not brought up to date "
                             f"({type(e).__name__}: {e})")


def take_page_problems() -> "list[str]":
    out = list(dict.fromkeys(PAGE_PROBLEMS))
    PAGE_PROBLEMS.clear()
    return out


def print_page_problems() -> None:
    for p in take_page_problems():
        print(f"rs-memory: {p}", file=sys.stderr)


def last_run_report() -> "str | None":
    """A consolidation run that ended without applying its delta, by its log."""
    runs = mem_dir() / "runs"
    if not runs.is_dir():
        return None
    logs = sorted(runs.glob("*.log"))
    if not logs:
        return None
    last = logs[-1]
    if marker_live():
        try:
            since = _dt.datetime.fromtimestamp(inflight_marker().stat().st_mtime,
                                               _dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        except OSError:
            since = "?"
        return (f"A consolidation run has been in flight since {since}; its log is {last}.")
    text = last.read_text(encoding="utf-8", errors="replace")
    results = [l for l in text.splitlines() if l.startswith("result: ")]
    if results and not results[-1].startswith("result: not applied"):
        return None
    return (f"The last consolidation run did not apply its delta; its log is {last}. "
            "The front page was not updated from those entries; the next session start or close "
            "tries again.")


def open_text(consolidation: "str | None" = None) -> str:
    """What open prints; `consolidation` is the line on the run this open
    made: it comes first (a hook's cut never drops it) and stands in for
    last_run_report's line."""
    d = mem_dir()
    # The jobs come right after the front page, whose last but one part is
    # In flight: what is still running is read before the rest.
    jobs_part = jobs_section()
    switches = switches_open_line()
    head = open_head()
    if not (d / "front.md").exists() and not journal_files():
        return ("# rs-memory\nNo memory yet in this "
                + ("package" if current_package() else "project")
                + ". Write your first journal entry "
                "with rs-memory note, and the in-flight work with rs-memory checkpoint.\n"
                + (f"\n{consolidation}\n" if consolidation else "")
                + (f"\n{head}\n" if head else "")
                + (f"\n{switches}\n" if switches else "")
                + (f"\n{jobs_part}\n" if jobs_part else ""))
    front = read_front()
    parts = [consolidation] if consolidation else []
    if head:
        parts.append(head)
    if switches:
        parts.append(switches)
    parts.append((d / "front.md").read_text(encoding="utf-8").rstrip()
                 if (d / "front.md").exists() else "# Front page\n(not written yet)")
    if jobs_part:
        parts.append(jobs_part)
    # A companion stages claims only when the PI asks for one: its knowledge
    # and staged blocks show only when they hold something.
    companion = companion_on()
    if not companion or record_entries():
        parts.append(knowledge_text())
    if not companion or any(w == "staged" for w, _p in claim_files().values()):
        parts.append(staged_text(checks_kit()))
    since = entries_since_mark()
    if since:
        lines = ["## Journal since the last consolidation"]
        for _n, f in since:
            e = parse_entry(f)
            lines.append(f"  {e['id']} [{one(e, 'kind')}] {one(e, 'time')} {e['headline']}")
        parts.append("\n".join(lines))
    cps = [parse_entry(f) for _n, f in journal_files()]
    cps = [e for e in cps if one(e, "kind") == "checkpoint"]
    if cps:
        parts.append(f"Last checkpoint: {cps[-1]['id']} at {one(cps[-1], 'time')}")
    parts.append(logbook_open_line())
    active = sorted(p.name for p in (d / "skills" / "active").glob(SKILL_PREFIX + "*")
                    if p.is_dir()) if (d / "skills" / "active").is_dir() else []
    if active:
        parts.append("Earned skills: " + ", ".join(active))
    rep = None if consolidation else last_run_report()
    if rep:
        parts.append(rep)
    del front
    return "\n\n".join(parts) + "\n"


def switches_open_line() -> "str | None":
    """open's line on the switches this session works under, in a project
    that has them; None elsewhere. A switches object that cannot be read is
    said here, never read as the defaults."""
    if not checks_kit():
        return None
    try:
        sw = session_switches()
        sid = session_id()
    except Refused as e:
        return f"Switches: cannot be read: {e}"
    where = ("" if sid else " (this command could not tell which session it runs "
             "in; `rs-memory switch` in the session says what holds there)")
    return (f"Switches: {switch_words(sw)}{where}. The user switches them for one session "
            f"with /rs-mode (pi: /skill:rs-mode).{switches_held(sw)}")


def _utf16_len(s: str) -> int:
    """A string's length as JavaScript counts it (UTF-16 code units), the
    larger of the two ways the limit could be counted."""
    return len(s.encode("utf-16-le")) // 2


def catch_up(agent: "str | None") -> "str | None":
    """At a session's start: a session that ended without its consolidation
    (the window closed, so only the end hook ran) is consolidated now, as
    close does it, before the front page is read. The line on it, or None
    when nothing was owed or a run is already in flight (open's last-run
    line says so)."""
    with Lock():
        ended = any(one(parse_entry(f), "kind") == "session-end"
                    for _n, f in entries_since_mark())
        if not ended or not new_since_mark() or marker_live():
            return None
        if agent is None:
            return ("The last session ended without consolidating its journal, and rs-memory "
                    "could not tell which agent runs here (pass open --agent claude or --agent "
                    "pi), so it did not consolidate now; the next session start or close tries "
                    "again.")
        log, child = launch_consolidation(agent)
    wait_tethered(child)
    outcome, detail = run_outcome(log)
    if outcome == "applied":
        return (f"The last session's journal was consolidated at this start into front page "
                f"{read_front()['page']}; its log is {log}.")
    if outcome == "nothing":
        return None
    return (f"The last session's journal was not consolidated at this start: the run did not "
            f"apply its delta{detail}; its log is {log}. The next session start or close "
            "tries again.")


def hook_text(text: str) -> str:
    """open --hook's text: its first line, and cut to the hook's limit."""
    text = "rs-memory open (start of session):\n\n" + text
    if _utf16_len(text) > HOOK_OUTPUT_LIMIT:
        tail = "\n[cut here; run rs-memory open for the rest]\n"
        room, cut = HOOK_OUTPUT_LIMIT - _utf16_len(tail), 0
        for ch in text:                     # whole characters only
            room -= _utf16_len(ch)
            if room < 0:
                break
            cut += 1
        text = text[:cut] + tail
    return text


def cmd_open(a) -> None:
    if a.hook and under_guard():
        return
    # With the planner on, a session that holds nothing has no memory yet:
    # it is shown the packages, and nothing is consolidated or written.
    if SESSION["planner"] and SESSION["binding"] is None:
        text = open_listing_text()
        sys.stdout.write(hook_text(text) if a.hook else text)
        return
    # A consolidation or referee run reads only, and never starts another.
    consolidation = None
    if not under_guard() and mem_dir().is_dir():
        consolidation = catch_up(a.agent or detect_agent(quiet=True))
        # The pages the PI reads are brought in line here too: this is how an
        # existing project gets them at its first session after an update.
        with Lock():
            refresh_pages()
    problems = take_page_problems()
    text = open_text(consolidation)
    if problems:
        text = ("## The PI's pages\n" + "\n".join(f"- {p}" for p in problems) + "\n\n" + text)
    if a.hook:
        text = hook_text(text)
    sys.stdout.write(text)


# ------------------------------------------------------------------ logbook
# The logbook is the story of the work, for the PI and for a later session:
# what was asked, what came out, what is open, where to pick up. One entry per
# topic, drafted by the agent and filed with `log`, which adds a header it
# computes itself (the date, the journal entries the entry covers) and writes
# it read-only into <workspace>/logbook/. rs-memory never rewrites or removes
# an entry afterwards: a correction is a later entry. Each filing is journalled
# (kind "logbook", one of QUIET_KINDS), and the journal is where the front
# page, open and recall find the entries. The logbook tells the story; the
# record holds the truth: an entry is never read back into the record, and
# where the two disagree, the record's standing holds.
LOGBOOK_DIR = "logbook"
LOGBOOK_KIND = "logbook"
LOGBOOK_SECTIONS = ("The question", "Results", "Open threads", "Where to pick up")
# A topic's slug follows the skill-name rule (SKILL_NAME_RE, SKILL_NAME_MAX), so
# every name the agent makes up obeys one rule; with the date in front and a
# counter behind, the entry's file name stays far inside a file name's 255 bytes.
LOGBOOK_SLUG_MAX = SKILL_NAME_MAX
# An entry is filed read-only: nothing, rs-memory included, edits it after.
LOGBOOK_MODE = 0o444
# How many entries the PI's front page lists, newest first; the folder holds
# the rest, a link away. A /log files one entry per topic, usually one to
# three, so five keeps the last session's entries and the one before it in
# view, while the front page stays a page of what waits and what stands, not
# an archive that grows with every session.
LOGBOOK_FRONT_ENTRIES = 5
_COVERS_RE = re.compile(r"\A(J-[1-9][0-9]*) to (J-[1-9][0-9]*)\Z")
_FENCE_RE = re.compile(r"\A {0,3}(`{3,}|~{3,})")
_CODE_SPAN_RE = re.compile(r"(`+).*?\1")
# A link's target in the draft: inline ([text](target), images too), a
# reference definition ([ref]: target), and HTML's href and src.
_LINK_RES = (re.compile(r"(!?\[[^\]]*\]\(\s*<?([^)\s>]*)[^)]*\))"),
             re.compile(r"\A {0,3}(\[[^\]]+\]:\s*<?([^\s>]+)>?)"),
             re.compile(r"""((?:href|src)\s*=\s*["']?([^"'\s>]+))""", re.I))


def logbook_dir() -> Path:
    return folder() / LOGBOOK_DIR


def logbook_state() -> "tuple[list[dict], list[int]]":
    """The filed entries, oldest first (each its journal entry: the title is
    its headline, `entry` its path in the workspace, `covers` the journal
    entries it covers), and the journal entries since the last of them that
    are new work (not QUIET_KINDS)."""
    entries: "list[dict]" = []
    after: "list[int]" = []
    for n, f in journal_files():
        e = parse_entry(f)
        kind = one(e, "kind")
        if kind == LOGBOOK_KIND and one(e, "entry"):
            entries.append(e)
            after = []
        elif kind not in QUIET_KINDS:
            after.append(n)
    return entries, after


def entries_words(n: int) -> str:
    return f"{n} journal entr{'y' if n == 1 else 'ies'}"


def logbook_covers(entries: "list[dict]", after: "list[int]") -> "tuple[int, int] | None":
    """The journal entries a new logbook entry covers: those since the last
    entry; when there are none, the same as the last entry (another topic of
    the same /log); None when there is no work in the journal at all."""
    if after:
        return after[0], after[-1]
    if entries:
        m = _COVERS_RE.match(one(entries[-1], "covers"))
        if m:
            return int(m.group(1)[2:]), int(m.group(2)[2:])
    return None


def logbook_slug(raw: str) -> str:
    if not SKILL_NAME_RE.match(raw) or len(raw) > LOGBOOK_SLUG_MAX:
        raise Refused(f"--topic {raw!r} is not a topic slug: a few words naming the topic in "
                      f"lowercase letters, digits and single hyphens, at most {LOGBOOK_SLUG_MAX} "
                      "characters, e.g. --topic station-gaps")
    return raw


def read_draft(path: str) -> str:
    p = Path(path)
    try:
        if not stat.S_ISREG(os.stat(p).st_mode):
            raise Refused(f"the draft {path} is not a plain file")
        return p.read_text(encoding="utf-8")
    except FileNotFoundError:
        raise Refused(f"the draft {path} does not exist")
    except OSError as e:
        raise Refused(f"the draft {path} cannot be read ({e.strerror or e})")
    except UnicodeDecodeError:
        raise Refused(f"the draft {path} is not UTF-8 text")


def parse_draft(path: str, text: str) -> "tuple[str, str]":
    """The draft's title and the text below its title line, checked: a title
    line, the four sections in order and none of them empty, and no link to an
    absolute path. A refusal names what is wrong."""
    shape = ("An entry is a first line `# <title>`, then the sections "
             + ", ".join(f"`## {h}`" for h in LOGBOOK_SECTIONS) + ", in this order")
    lines = text.split("\n")
    i = 0
    while i < len(lines) and not lines[i].strip():
        i += 1
    if i == len(lines) or not lines[i].startswith("# ") or not lines[i][2:].strip():
        raise Refused(f"the draft {path} has no title line. {shape}; its title is a natural "
                      "sentence reflecting the question")
    title = single_line(lines[i][2:])
    heads: "list[tuple[str, int]]" = []            # (heading, line index)
    links: "list[str]" = []
    fence = None
    for j in range(i, len(lines)):
        line = lines[j]
        m = _FENCE_RE.match(line)
        if fence is not None:
            if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence):
                fence = None
            continue
        if m:
            fence = m.group(1)
            continue
        if j > i and line.startswith("## "):
            heads.append((line[3:].strip(), j))
        bare = _CODE_SPAN_RE.sub("", line)
        for rx in _LINK_RES:
            for lm in rx.finditer(bare):
                if lm.group(2).startswith("/"):
                    links.append(f"{lm.group(1)} (line {j + 1})")
    names = [h for h, _j in heads]
    missing = [h for h in LOGBOOK_SECTIONS if h not in names]
    other = [h for h in names if h not in LOGBOOK_SECTIONS]
    if missing or other:
        what = []
        if missing:
            what.append("it lacks " + ", ".join(f"`## {h}`" for h in missing))
        if other:
            what.append("it has a section an entry does not: "
                        + ", ".join(f"`## {h}`" for h in other))
        raise Refused(f"the draft {path}: {'; '.join(what)}. {shape}")
    twice = sorted({h for h in names if names.count(h) > 1}, key=LOGBOOK_SECTIONS.index)
    if twice:
        raise Refused(f"the draft {path} has " + ", ".join(f"`## {h}`" for h in twice)
                      + f" more than once. {shape}")
    if names != list(LOGBOOK_SECTIONS):
        raise Refused(f"the draft {path} has its sections in the order "
                      + ", ".join(f"`## {h}`" for h in names) + f". {shape}")
    ends = [j for _h, j in heads[1:]] + [len(lines)]
    empty = [h for (h, j), end in zip(heads, ends) if not any(l.strip() for l in lines[j + 1:end])]
    if empty:
        raise Refused(f"the draft {path} leaves " + ", ".join(f"`## {h}`" for h in empty)
                      + " empty: write it (say so in a sentence when there is nothing to tell)")
    if links:
        raise Refused(f"the draft {path} links to an absolute path: {'; '.join(links)}. A link "
                      "in an entry is relative to the entry, which is filed in "
                      f"{logbook_dir()}/ (e.g. ../results/F-3/F-3.md), so the folder reads the "
                      "same wherever it is")
    return title, "\n".join(lines[i + 1:]).strip("\n")


def logbook_header(page: Path, date: str, covers: "tuple[int, int] | None") -> str:
    """The line rs-memory puts below an entry's title: the date and the
    journal entries it covers, each linked to its file."""
    if covers is None:
        return f"**Date:** {date} · **Journal:** no entries yet"
    paths = dict(journal_files())

    def ref(n: int) -> str:
        return rel_link(page, paths[n], f"J-{n}") if n in paths else f"J-{n}"
    span = ref(covers[0]) if covers[0] == covers[1] else f"{ref(covers[0])} to {ref(covers[1])}"
    return f"**Date:** {date} · **Journal:** {span}"


def file_logbook_entry(slug: str, title: str, body: str,
                       covers: "tuple[int, int] | None") -> Path:
    """Write the entry, read-only, under the first free name of
    <date>-<slug>.md, <date>-<slug>-2.md, …: written whole to a temp file,
    then linked to its name (which fails rather than replaces), so a reader
    never sees half an entry and no file is ever overwritten."""
    d = logbook_dir()
    date = _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%d")
    fd, tmp = tempfile.mkstemp(prefix=".entry.", dir=str(d))
    try:
        k = 1
        name = f"{date}-{slug}.md"
        text = f"# {title}\n\n{logbook_header(d / name, date, covers)}\n\n{body}\n"
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, LOGBOOK_MODE)
        while True:
            try:
                os.link(tmp, d / name)
                return d / name
            except FileExistsError:
                k += 1
                name = f"{date}-{slug}-{k}.md"
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def cmd_log(a) -> None:
    refuse_under_guard("file logbook entries")
    slug = logbook_slug(a.topic)
    title, body = parse_draft(a.file, read_draft(a.file))
    with Lock():
        d = logbook_dir()
        try:
            st = os.lstat(d)
        except FileNotFoundError:
            st = None
        if st is not None and not stat.S_ISDIR(st.st_mode):
            raise Refused(f"{d} is there and is not a folder (a file or a link), so no logbook "
                          "entry can be filed in it; rs-memory moves nothing and wrote nothing. "
                          "Tell the PI: once they move or rename it, file the entry again")
        if st is None:
            os.mkdir(d)
        entries, after = logbook_state()
        covers = logbook_covers(entries, after)
        try:
            path = file_logbook_entry(slug, title, body, covers)
        except OSError as e:
            raise Refused(f"the logbook entry could not be written into {d} "
                          f"({e.strerror or e}); nothing was filed")
        rel = path.relative_to(folder()).as_posix()
        span = ("none" if covers is None else
                f"J-{covers[0]}" if covers[0] == covers[1] else f"J-{covers[0]} to J-{covers[1]}")
        j = add_journal(title, LOGBOOK_KIND, "",
                        [("entry", rel)] + ([("covers", f"J-{covers[0]} to J-{covers[1]}")]
                                            if covers else []))
        refresh_pages()
    print(f"Filed {path} (journal: {span}); {j} journalled. It is never edited: a correction "
          "goes into a later entry.")


def read_logbook_entry(rel: str) -> "str | None":
    """A filed entry's text, by its path in the researcher's folder; None when
    it is not there as a plain file (never followed or blocked on)."""
    p = folder() / rel
    try:
        fd = os.open(str(p), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        chunks = []
        while True:
            b = os.read(fd, 1 << 16)
            if not b:
                break
            chunks.append(b)
    except OSError:
        return None
    finally:
        os.close(fd)
    return b"".join(chunks).decode("utf-8", errors="replace")


def logbook_front_lines(page: Path) -> "list[str]":
    """The front page's Logbook section."""
    entries, after = logbook_state()
    lines = ["## Logbook", "",
             "The story of the work, one entry per topic, written by the agent when you ask "
             "for it; an entry is never changed after it is written.", ""]
    for e in reversed(entries[-LOGBOOK_FRONT_ENTRIES:]):
        lines.append(f"- {file_ref(page, str(folder() / one(e, 'entry')), e['headline'])}"
                     f" — {md(one(e, 'time')[:10])}")
    if len(entries) > LOGBOOK_FRONT_ENTRIES:
        lines += ["", f"All {len(entries)} entries: " + rel_link(page, logbook_dir(), "logbook/")]
    if entries:
        lines.append("")
    n = len(after)
    ask = "type `/log` in the agent's session."
    if not entries:
        lines.append("Nothing has been logged yet"
                     + (f" ({entries_words(n)} so far)" if n else "")
                     + ". To have the agent write the logbook, " + ask)
    elif n:
        lines.append(f"{entries_words(n)} came after the last logbook entry. To have the "
                     "agent write them up, " + ask)
    else:
        lines.append("No journal entry came after the last logbook entry.")
    return lines


def logbook_open_line() -> str:
    """open's one line on the logbook: the latest entry's path, to read when
    the story is needed, and how much came after it."""
    entries, after = logbook_state()
    if not entries:
        return (f"Logbook: no entry yet ({entries_words(len(after))} so far); the PI "
                "asks for it with /log.")
    last = entries[-1]
    return (f"Latest logbook entry: {folder() / one(last, 'entry')} "
            f"({one(last, 'time')[:10]}; {entries_words(len(after))} since); read it when you "
            "need the story of the work.")


# ------------------------------------------------------------------ skills
def skill_name(raw: str) -> str:
    name = raw if raw.startswith(SKILL_PREFIX) else SKILL_PREFIX + raw
    if not SKILL_NAME_RE.match(name) or len(name) > SKILL_NAME_MAX:
        raise Refused(f"skill name {raw!r}: use lowercase letters, digits and single hyphens, "
                      f"at most {SKILL_NAME_MAX - len(SKILL_PREFIX)} characters")
    return name


def skill_dir(state: str, name: str) -> Path:
    return mem_dir() / "skills" / state / name


def skill_state(name: str) -> "str | None":
    for state in ("candidates", "active"):
        if skill_dir(state, name).is_dir():
            return state
    return None


def log_skill(event: str, name: str, detail: str, journal_id: str) -> None:
    p = mem_dir() / "skills.log"
    line = f"{now()} {event} {name} {single_line(detail)} {journal_id}".rstrip() + "\n"
    fd = os.open(str(p), os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "a", encoding="utf-8") as f:
        f.write(line)


def skill_log() -> "list[list[str]]":
    p = mem_dir() / "skills.log"
    try:
        return [l.split(" ", 4) for l in p.read_text(encoding="utf-8").splitlines() if l.strip()]
    except FileNotFoundError:
        return []


def skill_files(name: str) -> "list[str]":
    """The skill's file list, from its last `proposed` line."""
    files: "list[str]" = []
    for parts in skill_log():
        if len(parts) >= 4 and parts[1] == "proposed" and parts[2] == name:
            files = [f for f in parts[3].removeprefix("files=").split(",") if f]
    return files


def cmd_skill_propose(a) -> None:
    refuse_under_guard("change skills outside its delta")
    name = skill_name(a.name)
    if not single_line(a.description or ""):
        raise Refused("a skill needs --description: when an agent should use it")
    body_src = Path(a.body)
    if not body_src.is_file():
        raise Refused(f"{a.body}: the skill's instructions file does not exist")
    extras = []
    for f in a.files or []:
        p = Path(f)
        if p.is_symlink() or not p.is_file() or not SKILL_FILE_RE.match(p.name) or p.name == "SKILL.md":
            raise Refused(f"{f}: a skill file must be a regular file with a plain name "
                          "(letters, digits, dot, dash, underscore), not SKILL.md")
        extras.append(p)
    if len({p.name for p in extras}) != len(extras):
        raise Refused("two skill files share a name")
    with Lock():
        if skill_state(name) == "active":
            raise Refused(f"{name} is active; retire it first to change it")
        d = skill_dir("candidates", name)
        listed = ["SKILL.md"] + [p.name for p in extras]
        old = skill_files(name) if d.is_dir() else []
        for stale in old:
            if stale not in listed and (d / stale).is_file():
                raise Refused(f"{name} already has {stale}, which this proposal does not list; "
                              "propose it under another name")
        text = (f"---\nname: {name}\ndescription: {json.dumps(single_line(a.description))}\n---\n\n"
                + body_src.read_text(encoding="utf-8").strip() + "\n")
        write_text(d / "SKILL.md", text)
        for p in extras:
            write_text(d / p.name, p.read_text(encoding="utf-8"))
        j = add_journal(f"skill {name} proposed", "skill", a.description)
        log_skill("proposed", name, "files=" + ",".join(listed), j)
    print(f"{name} proposed (a candidate: no agent loads it). Log each use with "
          f"rs-memory skill used {name} --ok|--failed; it can be promoted after a successful use.")


def cmd_skill_used(a) -> None:
    refuse_under_guard("change skills outside its delta")
    name = skill_name(a.name)
    if a.ok == a.failed:
        raise Refused("say how the use went: --ok or --failed")
    with Lock():
        if not skill_state(name):
            raise Refused(f"no skill {name}")
        event = "used-ok" if a.ok else "used-failed"
        j = add_journal(f"skill {name} {event}", "skill", a.note or "")
        log_skill(event, name, a.note or "", j)
    print(f"{name}: {event} logged ({j}).")


def _copy_skill_home(name: str, home: Path, files: "list[str]") -> "str | None":
    """Copy the listed files into one agent's skills folder. Returns a problem
    to report, or None."""
    target = home / name
    if target.is_symlink() or (target.exists() and not target.is_dir()):
        return f"{target} is not a folder; {name} was not placed there"
    target.mkdir(parents=True, exist_ok=True)
    for f in files:
        src = skill_dir("active", name) / f
        write_text(target / f, src.read_text(encoding="utf-8"))
    return None


def sync_skills() -> "list[str]":
    """Copy every active skill's listed files into both agents' homes."""
    problems = []
    root = mem_dir() / "skills" / "active"
    if not root.is_dir():
        return problems
    for d in sorted(root.iterdir()):
        if not d.is_dir() or not d.name.startswith(SKILL_PREFIX):
            continue
        files = skill_files(d.name)
        for home in skill_homes():
            p = _copy_skill_home(d.name, home, files)
            if p:
                problems.append(p)
    return problems


def cmd_skill_promote(a) -> None:
    refuse_under_guard("change skills outside its delta")
    name = skill_name(a.name)
    with Lock():
        if skill_state(name) != "candidates":
            raise Refused(f"{name} is not a candidate skill")
        ok_since_change = False
        for p in skill_log():
            if len(p) >= 3 and p[2] == name:
                if p[1] in ("proposed", "retired"):
                    ok_since_change = False         # a changed or retired skill is proven again
                elif p[1] == "used-ok":
                    ok_since_change = True
        if not ok_since_change:
            raise Refused(f"{name} has no successful use logged since it was last proposed or "
                          f"retired; promote it after rs-memory skill used {name} --ok")
        listed = set(skill_files(name))
        extra = sorted(f.name for f in skill_dir("candidates", name).iterdir()
                       if f.name not in listed and not f.name.startswith("."))
        if extra:
            raise Refused(f"{name} holds {', '.join(extra)}, which its proposal does not list; "
                          "propose it again with every file it needs")
        os.replace(skill_dir("candidates", name), skill_dir("active", name))
        problems = []
        for home in skill_homes():
            p = _copy_skill_home(name, home, skill_files(name))
            if p:
                problems.append(p)
        j = add_journal(f"skill {name} promoted", "skill")
        log_skill("promoted", name, "", j)
    print(f"{name} promoted: it is in the agents' skills folders from now on.")
    for p in problems:
        print(f"warning: {p}")


def cmd_skill_retire(a) -> None:
    refuse_under_guard("change skills outside its delta")
    name = skill_name(a.name)
    if not single_line(a.reason or ""):
        raise Refused("retiring a skill needs --reason")
    with Lock():
        if skill_state(name) != "active":
            raise Refused(f"{name} is not an active skill")
        files = skill_files(name)
        kept = []
        for home in skill_homes():
            target = home / name
            if target.is_symlink() or not target.is_dir():
                continue
            for f in files:
                p = target / f
                if p.is_file() or p.is_symlink():
                    p.unlink()
            try:
                target.rmdir()
            except OSError:
                kept.append(str(target))
        os.replace(skill_dir("active", name), skill_dir("candidates", name))
        j = add_journal(f"skill {name} retired", "skill", a.reason)
        log_skill("retired", name, a.reason, j)
    print(f"{name} retired: back among the candidates, gone from the agents' skills folders.")
    for k in kept:
        print(f"note: {k} still holds files the skill does not list, so the folder was left in place")


def cmd_skill_sync(a) -> None:

DELTA_ITEM_KEYS = {"add": ("part", "text"), "edit": ("id", "text"),
                   "claims": ("kind", "title", "statement", "scope", "hedge", "evidence", "relations",
                              "topics"),
                   "skills": ("name", "description", "body")}

# The front page's parts: heading, id letter, and whether consolidation edits it.
PARTS = (
    ("inquiry", "Line of inquiry", "L", True),
    ("beliefs", "Beliefs", "B", True),
    ("inflight", "In flight", "I", False),
    ("threads", "Open threads", "T", True),
)
PART_BY_KEY = {k: (h, letter, c) for k, h, letter, c in PARTS}
CONSOLIDATED_PARTS = tuple(k for k, _h, _l, c in PARTS if c)

RELATIONS = ("supersedes", "contradicts", "withdraws", "depends-on", "answers")
# Claim prefixes: F a finding, Q an open question, R a retraction, D a fact
# about the data.
CLAIM_ID_RE = re.compile(r"\A[FQRD]-[1-9][0-9]*\Z")
CLAIM_KINDS = {"F": "finding", "Q": "question", "R": "retraction", "D": "fact"}
JOURNAL_ID_RE = re.compile(r"\AJ-([1-9][0-9]*)\Z")
# The Agent Skills naming rule pi and Claude Code share: lowercase letters,
# digits and single hyphens, at most 64 characters.
SKILL_NAME_RE = re.compile(r"\A[a-z0-9]+(-[a-z0-9]+)*\Z")
SKILL_NAME_MAX = 64
SKILL_PREFIX = "earned-"
SKILL_FILE_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]*\Z")

# A long run the agent left going: its entry file's id, and how much of the
# end of its log is read to show its last line. The log can be gigabytes and
# is read at every `job list`; a last line longer than this shows cut, and the
# log's path is printed beside it for the rest.
JOB_ID_RE = re.compile(r"\Ajob-([1-9][0-9]*)\Z")
JOB_LOG_TAIL_BYTES = 4096

FRONT_MARK_RE = re.compile(r"<!-- rs-memory page=(\d+) next=(\d+) -->")
# The front page's last section, the current accepted facts: computed from the
# record at every write of the page, never held as items, and skipped when the
# page is read back (its heading is no part's, and its lines are no items).
FACTS_HEADING = "What we know about the data"
ITEM_LINE_RE = re.compile(r"\A- \[([LBIT]-[1-9][0-9]*)\] (.*)\Z")


class Refused(Exception):
    """A refusal: the message names what is wrong and the next step."""


# --------------------------------------------------------------------- paths
def mem_dir() -> Path:
    return Path(os.environ.get("RS_MEMORY_DIR") or DEFAULT_DIR)


def runtime_dir() -> Path:
    # A tmpfs: an in-flight marker left by a run killed with its container is
    # gone at the next start, when nothing can be running.
    return Path(os.environ.get("RS_MEMORY_RUNTIME_DIR") or "/dev/shm")


def inflight_marker() -> Path:
    return runtime_dir() / f"rs-memory-consolidating-{os.getuid()}"


def now() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def under_guard() -> bool:
    return os.environ.get(GUARD) == "1" or under_strict_guard()


def under_strict_guard() -> bool:
    return os.environ.get(STRICT_GUARD) == "1"


def workspace() -> Path:
    """The project's workspace: the memory folder lives directly in it."""
    return mem_dir().parent


def record_path() -> Path:
    return workspace() / ".orchestrator" / "project.json"


def project_record() -> dict:
    """RS's record of this project; {} when there is none (outside a project)."""
    p = record_path()
    try:
        text = p.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {}
    except OSError as e:
        raise Refused(f"cannot read the project's record {p} ({e.strerror}), so rs-memory "
                      "cannot tell whether a finding's checks apply; tell the PI")
    try:
        data = json.loads(text)
    except (ValueError, RecursionError):
        raise Refused(f"the project's record {p} is not JSON, so rs-memory cannot tell "
                      "whether a finding's checks apply; tell the PI")
    if not isinstance(data, dict):
        raise Refused(f"the project's record {p} is not a JSON object, so rs-memory cannot "
                      "tell whether a finding's checks apply; tell the PI")
    return data


def checks_on() -> bool:
    return project_record().get(CHECKS_KEY) is True


def require_checks(what: str) -> None:
    if not checks_on():
        raise Refused(f"{what} is for researcher-subagents projects only: this project's "
                      f"record ({record_path()}) does not say \"{CHECKS_KEY}\": true")


def ensure_layout() -> Path:
    d = mem_dir()
    for sub in ("front", "journal", "staged", "record", "struck",
                "skills/candidates", "skills/active", "runs"):
        (d / sub).mkdir(parents=True, exist_ok=True)
    return d


def write_text(path: Path, text: str, mode: "int | None" = None) -> None:
    """Write through a fresh temp file and a rename, so a reader never sees a
    half file and a link at the name is replaced, never followed."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        if mode is not None:
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class Lock:
    """The memory folder's lock file (flock). `wait=False` raises BlockingIOError
    when another writer holds it."""

    def __init__(self, wait: bool = True):
        self.wait = wait
        self.fd = None

    def __enter__(self):
        d = ensure_layout()
        self.fd = os.open(str(d / ".lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o644)
        flags = fcntl.LOCK_EX | (0 if self.wait else fcntl.LOCK_NB)
        try:
            fcntl.flock(self.fd, flags)
        except BaseException:
            os.close(self.fd)
            raise
        return self

    def __exit__(self, *a):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)
        return False


# ------------------------------------------------------------------- journal
def journal_files() -> "list[tuple[int, Path]]":
    root = mem_dir() / "journal"
    out = []
    if not root.is_dir():
        return out
    for month in root.iterdir():
        if not month.is_dir():
            continue
        for f in month.glob("J-*.md"):
            m = JOURNAL_ID_RE.match(f.stem)
            if m:
                out.append((int(m.group(1)), f))
    out.sort()
    return out


def parse_entry(path: Path) -> dict:
    """An entry or claim file: a `# <id> — <headline>` line, `key: value`
    lines, a blank line, then the body. Repeated keys collect into lists."""
    text = path.read_text(encoding="utf-8")
    lines = text.split("\n")
    head = lines[0][2:] if lines and lines[0].startswith("# ") else ""
    ident, _, headline = head.partition(" — ")
    meta: dict = {"id": ident.strip(), "headline": headline.strip(), "path": path}
    i = 1
    while i < len(lines) and lines[i].strip():
        k, sep, v = lines[i].partition(": ")
        if sep:
            meta.setdefault(k.strip(), []).append(v)
        i += 1
    meta["body"] = "\n".join(lines[i + 1:]).strip()
    return meta


def one(meta: dict, key: str, default: str = "") -> str:
    v = meta.get(key)
    return v[0] if isinstance(v, list) and v else default


def render_entry(ident: str, headline: str, fields: "list[tuple[str, str]]", body: str) -> str:
    out = [f"# {ident} — {single_line(headline)}"]
    for k, v in fields:
        out.append(f"{k}: {v.strip() if k in RAW_FIELDS else single_line(v)}")
    out.append("")
    if body.strip():
        out.append(body.strip())
        out.append("")
    return "\n".join(out)


def single_line(s: str) -> str:
    return " ".join(str(s).split())


def session_label() -> str:
    agent = detect_agent(quiet=True) or "unknown"
    sid = os.environ.get("PI_SESSION_ID") or ""
    return f"{agent} {sid}".strip()


def add_journal(headline: str, kind: str, body: str = "") -> str:
    """Append one entry; the caller holds the lock. Returns its id."""
    files = journal_files()
    n = (files[-1][0] + 1) if files else 1
    ident = f"J-{n}"
    month = _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m")
    path = mem_dir() / "journal" / month / f"{ident}.md"
    write_text(path, render_entry(ident, headline, [
        ("kind", kind), ("session", session_label()), ("time", now())], body))
    return ident


def consolidated_mark() -> int:
    p = mem_dir() / "consolidated"
    try:
        m = JOURNAL_ID_RE.match(p.read_text(encoding="utf-8").strip())
    except FileNotFoundError:
        return 0
    return int(m.group(1)) if m else 0


def entries_since_mark() -> "list[tuple[int, Path]]":
    mark = consolidated_mark()
    return [(n, f) for n, f in journal_files() if n > mark]


def new_since_mark() -> "list[tuple[int, Path]]":
    """Entries since the mark that call for a consolidation: a consolidation's
    own entries and a session's end never do (QUIET_KINDS)."""
    return [(n, f) for n, f in entries_since_mark()
            if one(parse_entry(f), "kind") not in QUIET_KINDS]


# ---------------------------------------------------------------- front page
def empty_front() -> dict:
    return {"page": 0, "next": 1, "parts": {k: [] for k, *_ in PARTS}}


def read_front(p: "Path | None" = None) -> dict:
    p = p or mem_dir() / "front.md"
    try:
        text = p.read_text(encoding="utf-8")
    except FileNotFoundError:
        return empty_front()
    m = FRONT_MARK_RE.search(text)
    if not m:
        raise Refused(f"{p} has no rs-memory header line; it was not written by "
                      "rs-memory. Move it aside and run the command again.")
    front = {"page": int(m.group(1)), "next": int(m.group(2)),
             "parts": {k: [] for k, *_ in PARTS}}
    heading_to_key = {h: k for k, h, *_ in PARTS}
    cur = None
    for line in text.split("\n"):
        if line.startswith("## "):
            # Any other heading, the facts section's included, holds no items.
            cur = heading_to_key.get(line[3:].strip())
            continue
        im = ITEM_LINE_RE.match(line)
        if im and cur:
            front["parts"][cur].append((im.group(1), im.group(2)))
    return front


def render_front(front: dict) -> str:
    """The page from its parts, then the facts section computed from the
    record as it is now (absent when no fact is current)."""
    out = ["# Front page", "",
           f"<!-- rs-memory page={front['page']} next={front['next']} -->", ""]
    for k, heading, _letter, _c in PARTS:
        out.append(f"## {heading}")
        for ident, text in front["parts"][k]:
            out.append(f"- [{ident}] {text}")
        out.append("")
    facts = fact_lines(record_entries())
    if facts:
        out.append(f"## {FACTS_HEADING}")
        out += facts
        out.append("")
    return "\n".join(out)


def fact_lines(rec: "dict[str, dict]") -> "list[str]":
    """The front page's lines for the current accepted facts, oldest first."""
    st = standing(rec)
    facts = sorted((int(i[2:]), i) for i in rec if i.startswith("D-") and st[i] == "current")
    return [f"- ({i}) {rec[i]['headline']} — scope: {one(rec[i], 'scope')}" for _n, i in facts]


def new_item_id(front: dict, part: str) -> str:
    ident = f"{PART_BY_KEY[part][1]}-{front['next']}"
    front["next"] += 1
    return ident


# --------------------------------------------------------------------- claims
def claim_files() -> "dict[str, tuple[str, Path]]":
    """id -> (where, path) over staged/, record/ and struck/."""
    out = {}
    for where in ("staged", "record", "struck"):
        d = mem_dir() / where
        if d.is_dir():
            for f in d.glob("*.md"):
                if CLAIM_ID_RE.match(f.stem):
                    out[f.stem] = (where, f)
    return out


def next_claim_id(prefix: str) -> str:
    nums = [int(i[2:]) for i in claim_files() if i.startswith(prefix + "-")]
    return f"{prefix}-{max(nums) + 1 if nums else 1}"


def sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def record_entries() -> "dict[str, dict]":
    out = {}
    d = mem_dir() / "record"
    if d.is_dir():
        for f in sorted(d.glob("*.md")):
            if CLAIM_ID_RE.match(f.stem):
                out[f.stem] = parse_entry(f)
    return out


def standing(rec: "dict[str, dict]") -> "dict[str, str]":
    """Standing of every accepted entry, from the relations alone."""
    st: "dict[str, str]" = {}
    withdrawn = set()
    for e in rec.values():
        if e["id"].startswith("R-"):
            withdrawn.update(e.get("withdraws", []))
    superseded = set()
    for e in rec.values():
        if e["id"] not in withdrawn:
            superseded.update(e.get("supersedes", []))
    answered = set()
    for e in rec.values():
        if e["id"] not in withdrawn and e["id"] not in superseded:
            answered.update(e.get("answers", []))
    for ident in rec:
        if ident.startswith("R-"):
            st[ident] = "retraction"
        elif ident in withdrawn:
            st[ident] = "withdrawn"
        elif ident in superseded:
            st[ident] = "superseded"
        elif ident.startswith("Q-"):
            st[ident] = "answered" if ident in answered else "open"
        else:
            st[ident] = "current"
    live = {i for i, s in st.items() if s == "current"}
    for e in rec.values():
        a = e["id"]
        for b in e.get("contradicts", []):
            if a in live and b in live:
                st[a] = st[b] = "contested"
    return st


def undermined(rec: "dict[str, dict]", st: "dict[str, str]", ident: str) -> "list[str]":
    """The entries this one depends on that no longer stand (current, or
    contested, is standing; anything else is not)."""
    out = []
    for dep in rec.get(ident, {}).get("depends-on", []):
        if st.get(dep) not in ("current", "contested"):
            out.append(f"{dep} ({st.get(dep, 'not accepted')})")
    return out


# -------------------------------------------------------------------- agents
def detect_agent(quiet: bool = False) -> "str | None":
    claude = os.environ.get("CLAUDECODE") == "1"
    pi = bool(os.environ.get("PI_SESSION_ID"))
    if claude and pi:
        if quiet:
            return None
        raise Refused("both a Claude session (CLAUDECODE) and a pi session "
                      "(PI_SESSION_ID) are in this shell's environment; pass "
                      "--agent claude or --agent pi")
    if claude:
        return "claude"
    if pi:
        return "pi"
    if quiet:
        return None
    raise Refused("cannot tell which agent is running; pass --agent claude or --agent pi")


def skill_homes() -> "list[Path]":
    homes = [Path.home() / ".claude" / "skills"]
    pi_dir = os.environ.get("PI_CODING_AGENT_DIR")
    if pi_dir:
        homes.append(Path(pi_dir) / "skills")
    return homes


# ===================================================================== verbs
def refuse_under_guard(verb: str) -> None:
    """A consolidation run writes only through consolidate --apply: the session
    owns the journal, the In-flight part, the PI's accepts and the skills."""
    if under_strict_guard():
        raise Refused(f"a referee run does not {verb}: it writes nothing, it reads its "
                      "folder and answers")
    if under_guard():
        raise Refused(f"a consolidation run does not {verb}; write the delta and run "
                      "rs-memory consolidate --apply")


def cmd_note(a) -> None:
    refuse_under_guard("write journal entries")
    if not a.headline.strip():
        raise Refused("a note needs a headline: rs-memory note \"<what happened>\" --kind <kind>")
    if a.kind not in NOTE_KINDS:
        raise Refused(f"unknown kind {a.kind!r}; use one of: {', '.join(NOTE_KINDS)}")
    with Lock():
        ident = add_journal(a.headline, a.kind, a.body or "")
    print(f"{ident} journalled ({a.kind}).")


def cmd_checkpoint(a) -> None:
    refuse_under_guard("checkpoint")
    items = [single_line(x) for x in a.items if x.strip()]
    with Lock():
        front = read_front()
        front["parts"]["inflight"] = [(new_item_id(front, "inflight"), t) for t in items]
        write_text(mem_dir() / "front.md", render_front(front))
        ident = add_journal("checkpoint", "checkpoint",
                            "\n".join(f"- {t}" for t in items) or "(nothing in flight)")
        refresh_pages()
    print(f"In flight replaced ({len(items)} item(s)); {ident} journalled.")


def _claim_prefix(a) -> str:
    if a.fact:
        if a.withdraws or a.question:
            raise Refused("a claim is one kind: --fact stages a fact about the data, so drop "
                          + ("--withdraws (a retraction is a claim of its own)" if a.withdraws
                             else "--question"))
        return "D"
    if a.withdraws:
        if a.question:
            raise Refused("a claim is one kind: --question stages an open question and "
                          "--withdraws a retraction naming what it withdraws, so drop one of them")
        return "R"
    return "Q" if a.question else "F"


def refuse_fact_rerun(prefix: str) -> None:
    if prefix == "D":
        raise Refused("a fact needs no checks, so it has no re-run command; "
                      "drop --rerun / --no-rerun")


def validate_claim(statement: str, scope: str, evidence: "list[str]",
                   relations: "dict[str, list[str]]", prefix: str,
                   known: "set[str]") -> "list[tuple[str, str]]":
    """Check a claim before any write; returns its evidence as (path, sha256)."""
    if not single_line(statement):
        raise Refused("a claim needs a statement: what you found, as a sentence that could be wrong")
    if prefix != "R" and not single_line(scope):
        raise Refused("a claim needs --scope: where the statement holds (data, period, conditions)")
    if prefix == "F" and not evidence:
        raise Refused("a finding needs --evidence: the notebook, code or output it rests on")
    if prefix == "D" and not evidence:
        raise Refused("a fact needs --evidence: the file that shows it (the inventory, "
                      "table or output)")
    out = []
    for e in evidence:
        p = Path(e)
        if not p.is_absolute():
            p = Path.cwd() / p
        if p.is_symlink() or not p.is_file():
            raise Refused(f"evidence {e!r} leads nowhere: name a file that exists "
                          "(not a folder or a link)")
        out.append((str(p), sha256_file(str(p))))
    for rel, ids in relations.items():
        for i in ids:
            if i not in known:
                raise Refused(f"--{rel} {i}: no claim {i} exists (see rs-memory view)")
    if prefix == "R" and not relations.get("withdraws"):
        raise Refused("a retraction names what it withdraws: --withdraws <id> (a finding or a fact)")
    return out


def check_title(title: "str | None") -> str:
    """A claim's title, a few words naming the result: the pages the PI reads
    list claims by it. Not part of what the checks are bound to."""
    t = single_line(title or "")
    if not t:
        raise Refused("a claim needs --title: a few words naming the result (the pages the PI "
                      "reads list claims by it), e.g. --title \"Gaps in the hourly archives\"")
    return t


def write_claim(prefix: str, title: str, statement: str, scope: str, hedge: str,
                evidence: "list[tuple[str, str]]", relations: "dict[str, list[str]]",
                topics: "list[str]", rerun: "tuple[str, str] | None" = None) -> str:
    ident = next_claim_id(prefix)
    fields = [("kind", CLAIM_KINDS[prefix]), ("title", title),
              ("scope", scope), ("hedge", hedge or "(none stated)"),
              ("staged", now()), ("session", session_label())]
    for path, digest in evidence:
        fields.append(("evidence", f"{path} sha256={digest}"))
    if rerun:
        fields.append(rerun)
    for rel in RELATIONS:
        for i in relations.get(rel, []):
            fields.append((rel, i))
    for t in topics:
        fields.append(("topic", t))
    write_text(mem_dir() / "staged" / f"{ident}.md",
               render_entry(ident, statement, fields, ""))
    return ident


def _relations_from(a) -> "dict[str, list[str]]":
    return {r: list(getattr(a, r.replace("-", "_")) or []) for r in RELATIONS}


def rerun_field(a) -> "tuple[str, str] | None":
    """The finding's re-run command or the reason it has none, checked."""
    if a.rerun is not None:
        cmd = a.rerun.strip()
        if not cmd:
            raise Refused("--rerun needs the command that reproduces the finding")
        if "\n" in cmd or "\r" in cmd:
            raise Refused("--rerun is one line; put a longer command in a script and "
                          "give the line that runs it")
        return ("rerun", cmd)
    if a.no_rerun is not None:
        reason = single_line(a.no_rerun)
        if not reason:
            raise Refused("--no-rerun needs the reason the finding cannot be re-run")
        return ("no-rerun", reason)
    return None


def cmd_claim(a) -> None:
    refuse_under_guard("stage claims outside its delta")
    title = check_title(a.title)
    prefix = _claim_prefix(a)
    rels = _relations_from(a)
    rerun = None
    if a.rerun is not None or a.no_rerun is not None:
        refuse_fact_rerun(prefix)
        require_checks("--rerun and --no-rerun")
        if prefix != "F":
            raise Refused("only a finding has a re-run command; drop --rerun / --no-rerun")
        rerun = rerun_field(a)
    elif prefix == "F" and checks_on():
        raise Refused("a finding here needs --rerun CMD, the command that reproduces it "
                      "(it writes its outputs into the folder $RS_RERUN_OUT), or "
                      "--no-rerun REASON, why it cannot be re-run")
    with Lock():
        known = set(claim_files())
        ev = validate_claim(a.statement, a.scope or "", a.evidence or [], rels, prefix, known)
        ident = write_claim(prefix, title, a.statement, a.scope or "", a.hedge or "", ev,
                            rels, [single_line(t) for t in (a.topic or []) if t.strip()],
                            rerun)
        refresh_pages()
    print(f"{ident} staged. It enters the record when the PI accepts it "
          f"(they say \"accept {ident}\", you run rs-memory accept {ident}).")
    if rerun:
        print(f"Before the PI can accept it, it needs its checks: "
              + (f"rs-memory rerun {ident} (the re-run) and " if rerun[0] == "rerun" else "")
              + f"rs-memory referee {ident} (the referee's verdict).")


# The fields a staged claim carries, in the order write_claim writes them.
CLAIM_FIELDS = ("kind", "title", "scope", "hedge", "staged", "session", "amended", "evidence",
                "rerun", "no-rerun") + RELATIONS + ("topic",)


def cmd_amend(a) -> None:
    refuse_under_guard("amend claims")
    ident = a.id
    rels_given = {r: getattr(a, r.replace("-", "_")) for r in RELATIONS}
    if all(v is None for v in (a.statement, a.title, a.scope, a.hedge, a.evidence, a.topic,
                               a.rerun, a.no_rerun, *rels_given.values())):
        raise Refused(f"amend {ident}: say what to change: --statement, --title, --scope, --hedge, "
                      "--evidence, --topic, a relation (" + ", ".join(f"--{r}" for r in RELATIONS)
                      + "), or for a finding --rerun / --no-rerun")
    with Lock():
        where, path = claim_files().get(ident, (None, None))
        if where == "record":
            raise Refused(f"{ident} is accepted, and the record is never edited: correct it with "
                          f"a new claim that supersedes it (rs-memory claim \"<statement>\" … "
                          f"--supersedes {ident})")
        if where == "struck":
            raise Refused(f"{ident} was struck by the PI and is not amended; when it still "
                          "matters, stage a new claim with rs-memory claim")
        if where != "staged":
            raise Refused(f"no claim {ident} (rs-memory view lists the staged claims)")
        prefix = ident[0]
        rerun = None
        if a.rerun is not None or a.no_rerun is not None:
            refuse_fact_rerun(prefix)
            require_checks("--rerun and --no-rerun")
            if prefix != "F":
                raise Refused("only a finding has a re-run command; drop --rerun / --no-rerun")
            rerun = rerun_field(a)
        if prefix != "R" and rels_given["withdraws"] is not None:
            raise Refused(f"{ident} is not a retraction, so it withdraws nothing; a retraction is "
                          "a claim of its own: rs-memory claim … --withdraws <id>")
        old_text = path.read_text(encoding="utf-8")
        meta = parse_entry(path)
        statement = a.statement if a.statement is not None else meta["headline"]
        scope = a.scope if a.scope is not None else one(meta, "scope")
        hedge = a.hedge if a.hedge is not None else one(meta, "hedge")
        rels = {r: list(v) if v is not None else list(meta.get(r, []))
                for r, v in rels_given.items()}
        for r, ids in rels.items():
            if ident in ids:
                raise Refused(f"--{r} {ident}: a claim does not name itself")
        old_paths = [p for p, _d in staged_evidence(meta)]
        ev = validate_claim(statement, scope, a.evidence if a.evidence is not None else old_paths,
                            rels, prefix, set(claim_files()))
        # Evidence not named again keeps the hashes it was staged with, so a
        # file changed since then still shows as changed.
        ev_lines = ([f"{p} sha256={d}" for p, d in ev] if a.evidence is not None
                    else list(meta.get("evidence", [])))
        topics = ([single_line(t) for t in a.topic if t.strip()] if a.topic is not None
                  else list(meta.get("topic", [])))
        # A title is a label, like a topic: changing it voids no check. An
        # entry staged before titles existed keeps none until one is given.
        title = [check_title(a.title)] if a.title is not None else list(meta.get("title", []))
        stamp = now()
        new = {"kind": meta.get("kind", []), "title": title, "scope": [scope],
               "hedge": [hedge if single_line(hedge) else "(none stated)"],
               "staged": meta.get("staged", []), "session": meta.get("session", []),
               "amended": [stamp], "evidence": ev_lines, "topic": topics, **rels}
        if rerun:
            new["rerun" if rerun[0] == "rerun" else "no-rerun"] = [rerun[1]]
        else:
            new["rerun"], new["no-rerun"] = meta.get("rerun", []), meta.get("no-rerun", [])
        fields = [(k, v) for k in CLAIM_FIELDS for v in new.get(k, [])]
        # A field this version does not know is carried over as it is.
        fields += [(k, v) for k, vs in meta.items()
                   if k not in CLAIM_FIELDS and k not in ("id", "headline", "path", "body")
                   for v in vs]
        earlier = old_text.partition("\n\n")[0].rstrip("\n")
        section = (f"## Earlier version, amended {stamp}\n\n"
                   + "\n".join("    " + line for line in earlier.split("\n")))
        body = "\n\n".join(x for x in (meta["body"], section) if x.strip())
        write_text(path, render_entry(ident, statement, fields, body))
        after = parse_entry(path)
        refresh_pages()
    print(f"{ident} amended; its earlier version is kept on the entry "
          f"(rs-memory view {ident}).")
    if prefix == "F" and checks_on():
        claim_moved = (claim_sha(meta) != claim_sha(after)
                       or meta.get("evidence", []) != after.get("evidence", []))
        cmd = one(after, "rerun")
        if claim_moved:
            print("Changing the claim or its evidence voids both checks: start both again: "
                  + (f"rs-memory rerun {ident} and " if cmd else "")
                  + f"rs-memory referee {ident}.")
        elif cmd != one(meta, "rerun"):
            print(f"Its re-run command changed, which voids the re-run: start it again with "
                  f"rs-memory rerun {ident}.")


def _evidence_changed(meta: dict) -> "str | None":
    for line in meta.get("evidence", []):
        path, _, digest = line.rpartition(" sha256=")
        try:
            now_digest = sha256_file(path)
        except OSError:
            return path
        if now_digest != digest:
            return path
    return None


def cmd_accept(a) -> None:
    refuse_under_guard("accept claims (only the PI does)")
    a.ids = list(dict.fromkeys(a.ids))
    checks = checks_on()
    if a.over_objection and not checks:
        require_checks("--over-objection")
    with Lock():
        files = claim_files()
        metas = []
        for ident in a.ids:
            where, path = files.get(ident, (None, None))
            if where != "staged":
                raise Refused(f"{ident} is not a staged claim "
                              f"({'already ' + where if where else 'no such claim'})")
            meta = parse_entry(path)
            changed = _evidence_changed(meta)
            if changed:
                raise Refused(f"{ident}: its evidence {changed} changed since it was staged; "
                              "check the finding still holds and correct it with "
                              f"rs-memory amend {ident} --evidence <file> …, which hashes "
                              "the evidence again")
            # A finding's two checks, in a project that has them.
            extra = accept_checks(ident, meta, a.over_objection) \
                if checks and ident.startswith("F-") else None
            metas.append((ident, path, extra))
        # The front page's facts section follows the record: when this accept
        # changes it (a fact accepted, withdrawn or superseded), the page is
        # read now, so an unreadable page refuses before anything moves, and
        # written again after the moves.
        rec = record_entries()
        after = dict(rec)
        after.update((ident, parse_entry(path)) for ident, path, _e in metas)
        front = read_front() if fact_lines(rec) != fact_lines(after) else None
        # The frozen copy of each entry's evidence, beside its result page:
        # made and checked now, so a copy that cannot be made refuses the
        # accept before anything moves.
        freeze_all_evidence([(ident, parse_entry(path)) for ident, path, _e in metas])
        stamp = now()
        objected = []
        for ident, path, extra in metas:
            dest = mem_dir() / "record" / f"{ident}.md"
            os.replace(path, dest)                      # a move: the staged file IS the record
            text = dest.read_text(encoding="utf-8")
            head, sep, rest = text.partition("\n\n")
            if extra is None:
                write_text(dest, head.rstrip("\n") + f"\naccepted: {stamp}{sep or chr(10)}{rest}",
                           mode=0o444)
                continue
            fields, objection = extra
            head = head.rstrip("\n") + f"\naccepted: {stamp}" + "".join(
                f"\n{k}: {single_line(v)}" for k, v in fields)
            body = "\n\n".join(x for x in (rest.strip(), objection.strip()) if x)
            write_text(dest, head + "\n" + (f"\n{body}\n" if body else ""), mode=0o444)
            if objection.strip():
                objected.append(ident)
        if front is not None:
            # The same page number: only the computed section moved, and a
            # consolidation built from this page still applies.
            write_text(mem_dir() / "front.md", render_front(front))
        j = add_journal("accepted " + " ".join(i for i, _p, _e in metas), "accept",
                        ("over the referee's objection: " + " ".join(objected)) if objected else "")
        refresh_pages()
    print(f"Accepted into the record: {' '.join(i for i, _p, _e in metas)} ({j}).")
    if objected:
        print(f"Accepted over the referee's objection, which stays on the entry: {' '.join(objected)}.")


def cmd_strike(a) -> None:
    refuse_under_guard("strike claims (only the PI does)")
    a.ids = list(dict.fromkeys(a.ids))
    if not single_line(a.reason or ""):
        raise Refused("strike needs --reason: why the PI dropped it")
    with Lock():
        files = claim_files()
        for ident in a.ids:
            if files.get(ident, (None,))[0] != "staged":
                raise Refused(f"{ident} is not a staged claim")
        for ident in a.ids:
            os.replace(files[ident][1], mem_dir() / "struck" / f"{ident}.md")
        j = add_journal("struck " + " ".join(a.ids), "strike", a.reason)
        refresh_pages()
    print(f"Struck: {' '.join(a.ids)} ({j}).")


# -------------------------------------------------------------------- checks
# A finding's two checks, in a researcher-subagents project only: a re-run of
# its stated command, and a referee's verdict on its claim and evidence. Each
# check is a folder checks/<id>/<n>/ of its own, never deleted: check.md
# (what was started, bound to the claim's and evidence's hashes), pid, a log,
# and the record the run leaves when it ends (rerun.md or verdict.md).
def claim_sha(meta: dict) -> str:
    """The claim as the PI reads it: statement, scope and hedge."""
    text = json.dumps([meta["headline"], one(meta, "scope"), one(meta, "hedge")],
                      ensure_ascii=False)
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def staged_evidence(meta: dict) -> "list[tuple[str, str]]":
    out = []
    for line in meta.get("evidence", []):
        path, _, digest = line.rpartition(" sha256=")
        out.append((path, digest))
    return out


def binding_fields(meta: dict) -> "list[tuple[str, str]]":
    return [("claim-sha256", claim_sha(meta))] + [
        ("evidence", f"{p} sha256={d}") for p, d in staged_evidence(meta)]


def bound_to(info: dict, meta: dict) -> bool:
    """Whether a check was made on the claim and evidence as staged now."""
    return (one(info, "claim-sha256") == claim_sha(meta)
            and info.get("evidence", []) == meta.get("evidence", []))


def staged_finding(ident: str) -> "tuple[Path, dict]":
    where, path = claim_files().get(ident, (None, None))
    if where != "staged":
        raise Refused(f"{ident} is not a staged claim "
                      f"({'already ' + where if where else 'no such claim'})")
    if not ident.startswith("F-"):
        raise Refused(f"{ident} is not a finding; only findings (F-) have checks")
    return path, parse_entry(path)


def refuse_changed(ident: str, meta: dict) -> None:
    changed = _evidence_changed(meta)
    if changed:
        raise Refused(f"{ident}: its evidence {changed} changed since it was staged, which voids "
                      "its checks; check the finding still holds, correct it with "
                      f"rs-memory amend {ident} --evidence <file> … (it hashes the evidence "
                      "again), then start its checks again")


def checks_dir(ident: str) -> Path:
    return mem_dir() / "checks" / ident


def new_check(ident: str, kind: str, fields: "list[tuple[str, str]]") -> "tuple[int, Path]":
    """A fresh numbered folder for one check; the caller holds the lock."""
    root = checks_dir(ident)
    root.mkdir(parents=True, exist_ok=True)
    nums = [int(p.name) for p in root.iterdir() if p.is_dir() and p.name.isdigit()]
    n = max(nums, default=0) + 1
    d = root / str(n)
    d.mkdir()
    write_text(d / "check.md", render_entry(f"{ident} check {n}", kind,
                                            [("kind", kind), ("started", now())] + fields, ""))
    return n, d


def child_verb(kind: str) -> str:
    return "_rerun" if kind == "rerun" else "_referee"


def check_live(d: Path, kind: str, ident: str, n: int) -> bool:
    try:
        pid = int((d / "pid").read_text().strip())
        cmd = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (OSError, ValueError):
        return False
    return f"\0{child_verb(kind)}\0{ident}\0{n}\0".encode() in cmd


def start_check(ident: str, n: int, d: Path, kind: str, log_name: str) -> Path:
    """Start the check's run detached, in a session of its own (as close
    starts a consolidation), and note its pid."""
    log = d / log_name
    fd = os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o644)
    me = os.path.realpath(sys.argv[0])
    try:
        child = subprocess.Popen([sys.executable, me, child_verb(kind), ident, str(n)],
                                 stdin=subprocess.DEVNULL, stdout=fd, stderr=fd,
                                 start_new_session=True, close_fds=True)
    finally:
        os.close(fd)
    write_text(d / "pid", f"{child.pid}\n")
    return log


def check_list(ident: str) -> "list[dict]":
    """Every check of a claim, oldest first, with its state: done (its record
    is written), running, or failed (it ended without a record)."""
    root = checks_dir(ident)
    if not root.is_dir():
        return []
    out = []
    for n in sorted(int(p.name) for p in root.iterdir() if p.is_dir() and p.name.isdigit()):
        d = root / str(n)
        try:
            info = parse_entry(d / "check.md")
        except FileNotFoundError:
            continue
        kind = one(info, "kind")
        rec_file = d / ("rerun.md" if kind == "rerun" else "verdict.md")
        rec = parse_entry(rec_file) if rec_file.is_file() else None
        if rec is not None:
            state = "done"
        elif check_live(d, kind, ident, n):
            state = "running"
        else:
            state = "failed"
        out.append({"n": n, "dir": d, "kind": kind, "info": info, "rec": rec, "state": state,
                    "log": d / ("rerun.log" if kind == "rerun" else "referee.log")})
    return out


def accepted_record_text() -> str:
    """The accepted record as a referee reads it: every entry, with its standing."""
    rec = record_entries()
    st = standing(rec)
    out = ["# The project's accepted record", ""]
    if not rec:
        out.append("(nothing accepted yet)")
    for ident, e in rec.items():
        out.append(e["path"].read_text(encoding="utf-8").rstrip())
        out.append(f"standing: {st[ident]}")
        out.append("")
    return "\n".join(out).rstrip() + "\n"


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


# --------------------------------------------------- checks: state and accept
def finding_checks(ident: str, meta: dict) -> dict:
    """What a staged finding's checks say now."""
    cs = check_list(ident)
    cmd = one(meta, "rerun")
    reruns = [c for c in cs if c["kind"] == "rerun"]
    refs = [c for c in cs if c["kind"] == "referee"]
    cur_rerun = [c for c in reruns if c["state"] == "done" and bound_to(c["info"], meta)
                 and one(c["info"], "command") == cmd and cmd]
    cur_verdicts = [c for c in refs if c["state"] == "done" and bound_to(c["info"], meta)
                    and one(c["rec"], "verdict") in VERDICTS]
    return {"reruns": reruns, "refs": refs, "cur_rerun": cur_rerun,
            "cur_verdicts": cur_verdicts, "command": cmd, "reason": one(meta, "no-rerun"),
            "changed": _evidence_changed(meta)}


def rerun_summary(c: dict) -> str:
    rec = c["rec"]
    files = []
    for line in rec.get("compare", []):
        path, _, result = line.rpartition(" -> ")
        files.append(f"{Path(path).name} {result}")
    return (f"check {c['n']}: exit {one(rec, 'exit')}"
            + (f"; {', '.join(files)}" if files else ""))


def verdict_summary(c: dict) -> str:
    rec = c["rec"]
    v = one(rec, "verdict")
    out = f"check {c['n']}: {v} ({one(rec, 'model')})"
    if one(rec, "narrower"):
        out += f"; narrower claim: {one(rec, 'narrower')}"
    if one(rec, "accepted-sha256") != sha256_text(accepted_record_text()):
        out += "; the record changed since this verdict"
    return out


def rerun_state_lines(fc: dict) -> "list[str]":
    if fc["changed"]:
        return [f"void: its evidence {fc['changed']} changed since it was staged"]
    out = []
    if fc["reason"]:
        out.append(f"none: {fc['reason']}")
    for c in fc["reruns"]:
        if c["state"] == "running":
            out.append(f"check {c['n']}: running since {one(c['info'], 'started')}; "
                       f"its log is {c['log']}")
    if fc["cur_rerun"]:
        out.append(rerun_summary(fc["cur_rerun"][-1]))
    last = fc["reruns"][-1] if fc["reruns"] else None
    if last and last["state"] == "failed":
        out.append(f"check {last['n']} failed: it ended without a record; its log is {last['log']}")
    if not out:
        if not fc["command"]:
            out.append("not run: no re-run command and no reason "
                       "(rs-memory rerun-command)")
        elif fc["reruns"]:
            out.append("not run for its current command")
        else:
            out.append("not run")
    return out


def referee_state_lines(fc: dict) -> "list[str]":
    if fc["changed"]:
        return [f"void: its evidence {fc['changed']} changed since it was staged"]
    out = []
    for c in fc["refs"]:
        if c["state"] == "running":
            out.append(f"check {c['n']}: running since {one(c['info'], 'started')}; "
                       f"its log is {c['log']}")
    out += [verdict_summary(c) for c in fc["cur_verdicts"]]
    last = fc["refs"][-1] if fc["refs"] else None
    if last and last["state"] == "failed":
        out.append(f"check {last['n']} failed: it ended without a record; its log is {last['log']}")
    elif last and last["state"] == "done" and one(last["rec"], "verdict") not in VERDICTS:
        out.append(f"check {last['n']} gave no verdict: {one(last['rec'], 'failed')}; "
                   f"its log is {last['log']}")
    if not out:
        out.append("void: the claim changed since its verdict" if fc["refs"] else "not run")
    return out


def check_lines(ident: str, meta: dict, indent: str) -> "list[str]":
    fc = finding_checks(ident, meta)
    out = []
    for label, lines in (("re-run", rerun_state_lines(fc)), ("referee", referee_state_lines(fc))):
        for line in lines:
            out.append(f"{indent}{label}: {line}")
    return out


def accept_checks(ident: str, meta: dict, over: bool) -> "tuple[list, str]":
    """Refuse a finding whose checks are missing or object (without the PI's
    --over-objection); else the fields and body its record entry gets."""
    fc = finding_checks(ident, meta)
    missing = []
    if not fc["cur_verdicts"]:
        missing.append(f"no current referee verdict (none on the claim and evidence as staged; "
                       f"run rs-memory referee {ident})")
    if not fc["cur_rerun"] and not fc["reason"]:
        missing.append(f"no re-run record for its command and no reason it cannot be re-run "
                       + (f"(run rs-memory rerun {ident})" if fc["command"] else
                          f"(give one with rs-memory rerun-command {ident} --rerun CMD "
                          "or --no-rerun REASON)"))
    if missing:
        raise Refused(f"{ident} cannot be accepted yet: " + "; ".join(missing))
    objections = [c for c in fc["cur_verdicts"] if one(c["rec"], "verdict") in OBJECTIONS]
    if objections and not over:
        raise Refused(f"{ident}: the referee objects ("
                      + "; ".join(verdict_summary(c) for c in objections)
                      + "). Accept it over the objection only when the PI says so: "
                      f"rs-memory accept {ident} --over-objection")
    fields = [("referee", verdict_summary(c) + f" [{c['dir'] / 'verdict.md'}]")
              for c in fc["cur_verdicts"]]
    if fc["cur_rerun"]:
        c = fc["cur_rerun"][-1]
        fields.append(("rerun-check", rerun_summary(c) + f" [{c['dir'] / 'rerun.md'}]"))
    body = []
    for c in objections:
        fields.append(("objection", f"check {c['n']}: {one(c['rec'], 'verdict')}"))
        body.append(f"Accepted over the referee's objection (check {c['n']}, "
                    f"{one(c['rec'], 'verdict')}, {one(c['rec'], 'model')}):")
        body.append(c["rec"]["body"].strip())       # the narrower claim and the findings
        body.append("")
    return fields, "\n".join(body)



def cmd_plan(a) -> None:
    """Take the project's top: this session plans (one at a time)."""
    refuse_under_guard("take the project's top")
    require_planner("rs-memory plan")
    src = need_session("plans")
    sid = src[1]
    holder = holder_record(src)
    agent = a.agent or detect_agent(quiet=True)
    with Lock(d=top_mem_dir()):
        h = read_planning()
        if h is not None and h["session"] != sid and holder_alive(h):
            raise Refused(f"another session plans: session {h['session']} holds the project's top "
                          f"since {fmt_time(h['since'])}, and one session plans at a time. Ask "
                          "the user to end that one first, or take a package (rs-memory take "
                          "<package>)")
        b, _lost = binding(sid)
        if b is not None and b[0] == "package":
            raise Refused(f"this session works in package {b[1]}: give it back first with "
                          "rs-memory release, then plan")
        write_planning(holder)
        data = session_data(sid)
        data[HOLDS_KEY] = HOLDS_TOP
        write_session_data(sid, data)
        SESSION["binding"], SESSION["lost"] = ("top", None), None
        refresh_pages()
    line = catch_up(agent)
    print(take_lines(f"This session now plans: it holds the project's top ({top_mem_dir()}). "
                     "Define the task with the user and write the packages and their charters "
                     "with rs-memory package add (rs-memory --help lists the package verbs). "
                     "rs-memory release gives the top back.", line), end="")


def cmd_take(a) -> None:
    """Take a package: this session works in it, and only in it."""
    refuse_under_guard("take a package")
    require_planner("rs-memory take")
    src = need_session("takes the package")
    sid = src[1]
    name = valid_package_name(a.package)
    mem = package_memory(name)
    holder = holder_record(src)
    agent = a.agent or detect_agent(quiet=True)
    with working_in(mem):
        with Lock():
            st = read_status(name)
            if st["state"] != "open":
                raise Refused(f"package {name} is {st['state']}: it is kept as history and is not "
                              "taken again. rs-memory open lists the open ones")
            h = st["holder"]
            if h is not None and h["session"] != sid and holder_alive(h):
                raise Refused(f"package {name} is being worked on in another live session "
                              f"({h['session']}, since {fmt_time(h['since'])}); one session "
                              "works in a package at a time. Take another package, or ask the "
                              "user to end that session first")
            with Lock(d=top_mem_dir()):
                b, _lost = binding(sid)
                if b is not None and b != ("package", name):
                    raise Refused("this session " + ("plans" if b[0] == "top" else
                                                     f"works in package {b[1]}")
                                  + ": give that back first with rs-memory release, then take "
                                  f"{name}")
                st["holder"], st["changed"] = holder, now()
                write_status(name, st)
                data = session_data(sid)
                data[HOLDS_KEY] = {HOLDS_PACKAGE: name}
                write_session_data(sid, data)
                SESSION["binding"], SESSION["lost"] = ("package", name), None
            refresh_pages()
        line = catch_up(agent)
        text = take_lines(f"This session now works in package {name}. Work only inside its "
                          f"charter, {package_dir(name) / CHARTER_FILE}; bring an idea outside it "
                          "to the user as a suggestion. rs-memory release gives the package back.",
                          line)
    print(text, end="")


def release_hold(sid: str, holds: object) -> str:
    """Give back what a session's file says it holds: the holder record when
    it still names this session, and the session's own note of it. Returns
    a line on it."""
    if holds == HOLDS_TOP:
        with Lock(d=top_mem_dir()):
            h = read_planning()
            if h is not None and h["session"] == sid:
                write_planning(None)
            data = session_data(sid)
            data.pop(HOLDS_KEY, None)
            write_session_data(sid, data)
        return "This session gave the project's top back: it no longer plans."
    name = holds[HOLDS_PACKAGE]
    try:
        mem = package_memory(name)
    except Refused:
        mem = None
    if mem is not None:
        with working_in(mem):
            with Lock():
                try:
                    st = read_status(name)
                except Refused:
                    st = None
                if st is not None and st["holder"] and st["holder"]["session"] == sid:
                    st["holder"], st["changed"] = None, now()
                    write_status(name, st)
                with Lock(d=top_mem_dir()):
                    data = session_data(sid)
                    data.pop(HOLDS_KEY, None)
                    write_session_data(sid, data)
                refresh_pages()
    else:
        with Lock(d=top_mem_dir()):
            data = session_data(sid)
            data.pop(HOLDS_KEY, None)
            write_session_data(sid, data)
    return f"This session gave package {name} back."


def cmd_release(a) -> None:
    refuse_under_guard("give back what a session holds")
    sid = need_session("gives back what it holds")[1]
    holds = session_data(sid).get(HOLDS_KEY)
    if holds is None:
        print("This session holds nothing.")
        return
    print(release_hold(sid, holds))



def run_rerun(ident: str, n: int) -> int:
    """The detached re-run: the command in the workspace, then its record."""
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    d = checks_dir(ident) / str(n)
    info = parse_entry(d / "check.md")
    cmd = one(info, "command")
    out_dir = d / "rerun"
    env = {k: v for k, v in os.environ.items() if k not in SESSION_VARS}
    env["RS_RERUN_OUT"] = str(out_dir)
    print(f"command: {cmd}\nRS_RERUN_OUT={out_dir}", flush=True)
    try:
        rc = str(subprocess.run(["bash", "-c", cmd], cwd=str(workspace()), env=env,
                                stdin=subprocess.DEVNULL).returncode)
    except OSError as e:
        rc = f"none (could not start bash: {e.strerror})"
    print(f"exit: {rc}", flush=True)
    compare = []
    for path, digest in staged_evidence(info):
        f = out_dir / Path(path).name
        if f.is_symlink() or not f.is_file():
            result = "not produced"
        else:
            result = "same" if sha256_file(str(f)) == digest else "differs"
        compare.append(("compare", f"{path} -> {result}"))
    fields = ([("kind", "rerun"), ("command", cmd), ("exit", rc), ("started", one(info, "started")),
               ("ended", now()), ("out", str(out_dir)), ("log", str(d / "rerun.log"))]
              + [(k, v) for k in ("claim-sha256", "evidence") for v in info.get(k, [])] + compare)
    write_text(d / "rerun.md", render_entry(f"{ident} re-run {n}", f"exit {rc}", fields, ""))
    return 0


def referee_model(agent: str) -> "list[str]":
    """The model flags for the referee, from the project's record; no model
    recorded is an error, never a fallback to the agent's default."""
    data = project_record()
    if agent == "claude":
        models = data.get("models") if isinstance(data.get("models"), dict) else {}
        pair = models.get("referee")
        m = pair.get("model") if isinstance(pair, dict) else None
        if not isinstance(m, str) or not m.strip():
            raise Refused("no referee model is set for this project: its record "
                          f"({record_path()}) has no models.referee model for Claude; the PI "
                          "sets it in the project's settings")
        e = pair.get("effort") or ""
        if not isinstance(e, str):
            raise Refused(f"the referee's effort in {record_path()} is not text: {e!r}")
        return ["--model", m.strip()] + (["--effort", e.strip()] if e.strip() else [])
    blk = data.get("pi_models") if isinstance(data.get("pi_models"), dict) else {}
    pair = blk.get("agent")
    m = pair.get("model") if isinstance(pair, dict) else None
    if not isinstance(m, str) or not m.strip():
        raise Refused("no referee model is set for this project: its record "
                      f"({record_path()}) has no pi model (pi_models.agent.model); the PI "
                      "sets pi's model in the project's settings")
    t = pair.get("thinking") or ""
    if not isinstance(t, str):
        raise Refused(f"pi's thinking level in {record_path()} is not text: {t!r}")
    return ["--model", m.strip()] + (["--thinking", t.strip()] if t.strip() else [])


def referee_argv(agent: str, prompt: str, model_flags: "list[str]") -> "list[str]":
    """The lean headless run: no RS text, no memory rules, no front page, no
    session kept, read-only tools; the model passed explicitly."""
    if agent == "claude":
        return ["claude", "-p", prompt, "--restricted", "--tools", CLAUDE_REFEREE_TOOLS,
                "--system-prompt", REFEREE_SYSTEM, "--no-session-persistence",
                "--strict-mcp-config", "--disable-slash-commands", "--output-format", "json",
                *model_flags]
    return ["pi", "-p", prompt, "-ne", "-ns", "-nc", "-np", "--no-mcp", "--offline",
            "--no-session", "--tools", PI_REFEREE_TOOLS, "--system-prompt", REFEREE_SYSTEM,
            "--mode", "json", *model_flags]


def copy_hashed(src: str, dest: Path) -> str:
    """Copy a file through a temp file and a rename, read-only; returns the
    sha256 of the bytes copied."""
    h = hashlib.sha256()
    fd, tmp = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
    try:
        with open(src, "rb") as fi, os.fdopen(fd, "wb") as fo:
            for chunk in iter(lambda: fi.read(1 << 20), b""):
                h.update(chunk)
                fo.write(chunk)
        os.chmod(tmp, 0o444)
        os.replace(tmp, dest)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return h.hexdigest()


def claim_text(ident: str, meta: dict, names: "list[str]") -> str:
    out = [f"# Claim {ident} (staged, waiting for the PI)", "",
           f"Statement: {meta['headline']}", f"Scope: {one(meta, 'scope')}",
           f"Hedge: {one(meta, 'hedge')}", ""]
    rels = [f"- {rel} {i}" for rel in RELATIONS for i in meta.get(rel, [])]
    if rels:
        out += ["Relations to other claims:"] + rels + [""]
    out.append("Evidence (a copy of each file is in this folder):")
    for (path, digest), name in zip(staged_evidence(meta), names):
        out.append(f"- {name}: the author's {path} (sha256 {digest})")
    if one(meta, "rerun"):
        out += ["", f"The command the author says reproduces it: {one(meta, 'rerun')}"]
    elif one(meta, "no-rerun"):
        out += ["", f"Why the author says it cannot be re-run: {one(meta, 'no-rerun')}"]
    return "\n".join(out) + "\n"


def cmd_referee(a) -> None:
    refuse_under_guard("start a referee run")
    require_checks("referee")
    agent = a.agent or detect_agent()
    model_flags = referee_model(agent)
    try:
        instruction = REFEREE_FILE.read_text(encoding="utf-8")
    except OSError as e:
        raise Refused(f"the referee's instruction {REFEREE_FILE} cannot be read ({e.strerror}); "
                      "this project's image predates the referee: tell the PI")
    with Lock():
        _path, meta = staged_finding(a.id)
        refuse_changed(a.id, meta)
        fc = finding_checks(a.id, meta)
        rerun = fc["reruns"][-1] if fc["reruns"] and fc["reruns"][-1]["state"] == "done" else None
        accepted = accepted_record_text()
        n, d = new_check(a.id, "referee", [("agent", agent), ("model-flags", json.dumps(model_flags))]
                         + binding_fields(meta)
                         + [("accepted-sha256", sha256_text(accepted)),
                            ("rerun-check", str(rerun["n"]) if rerun else "none")])
        snap = d / "snapshot"
        (snap / "evidence").mkdir(parents=True)
        names = [f"evidence/{i}-{Path(p).name}" for i, (p, _d) in
                 enumerate(staged_evidence(meta), 1)]
        manifest = {}
        for (path, digest), name in zip(staged_evidence(meta), names):
            got = copy_hashed(path, snap / name)
            if got != digest:
                write_verdict(a.id, n, None, f"its evidence {path} changed while the snapshot "
                              "was taken", {}, "")
                raise Refused(f"{a.id}: its evidence {path} changed while its snapshot was "
                              "taken; check the finding still holds, correct it with "
                              f"rs-memory amend {a.id} --evidence <file> …, then start its "
                              "checks again")
            manifest[name] = got
        texts = {"claim.md": claim_text(a.id, meta, names), "accepted.md": accepted,
                 "REFEREE.md": instruction.replace("{folder}", str(snap))}
        if rerun:
            texts["rerun.md"] = (rerun["dir"] / "rerun.md").read_text(encoding="utf-8")
        for name, text in texts.items():
            write_text(snap / name, text, mode=0o444)
            manifest[name] = sha256_text(text)
        write_text(snap / "MANIFEST.sha256",
                   "".join(f"{h}  {name}\n" for name, h in sorted(manifest.items())), mode=0o444)
        log = start_check(a.id, n, d, "referee", "referee.log")
        refresh_pages()
    print(f"Referee of {a.id} started in the background (check {n}, {agent} "
          f"{' '.join(model_flags)}), reading only {snap}; its log is {log}. "
          f"Its verdict lands in {d / 'verdict.md'} and shows in rs-memory view {a.id}.")


def parse_claude_output(text: str) -> dict:
    try:
        d = json.loads(text)
    except (ValueError, RecursionError):
        return {"error": "its output is not the JSON record Claude writes"}
    if not isinstance(d, dict) or d.get("type") != "result":
        return {"error": "its output has no result record"}
    usage = d.get("usage") if isinstance(d.get("usage"), dict) else {}
    out = {"models": sorted(d.get("modelUsage") or {}) if isinstance(d.get("modelUsage"), dict) else [],
           "cost": d.get("total_cost_usd"),
           "usage": ", ".join(f"{k.replace('_input_tokens', '').replace('_tokens', '')} {usage[k]}"
                              for k in ("input_tokens", "output_tokens", "cache_read_input_tokens",
                                        "cache_creation_input_tokens") if k in usage)}
    if d.get("is_error") or not isinstance(d.get("result"), str):
        out["error"] = f"the run failed ({d.get('terminal_reason')}): {single_line(str(d.get('result')))}"
        return out
    out["answer"] = d["result"]
    return out


def parse_pi_output(text: str) -> dict:
    last = None
    totals = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
    cost = 0.0
    for line in text.splitlines():
        try:
            d = json.loads(line)
        except (ValueError, RecursionError):
            continue
        msg = d.get("message") if isinstance(d, dict) and d.get("type") == "message_end" else None
        if not isinstance(msg, dict) or msg.get("role") != "assistant":
            continue
        last = msg
        u = msg.get("usage") if isinstance(msg.get("usage"), dict) else {}
        for k in totals:
            if isinstance(u.get(k), int):
                totals[k] += u[k]
        c = u.get("cost") if isinstance(u.get("cost"), dict) else {}
        if isinstance(c.get("total"), (int, float)):
            cost += c["total"]
    if last is None:
        return {"error": "pi's output has no answer from the model"}
    out = {"models": [f"{last.get('provider')}/{last.get('model')}"], "cost": cost,
           "usage": ", ".join(f"{k} {v}" for k, v in totals.items())}
    if last.get("stopReason") in ("error", "aborted"):
        out["error"] = f"the run failed ({last.get('stopReason')}): {single_line(str(last.get('errorMessage')))}"
        return out
    content = last.get("content")
    out["answer"] = "".join(b.get("text", "") for b in content if isinstance(b, dict)
                            and b.get("type") == "text") if isinstance(content, list) else ""
    return out


def parse_verdict(answer: str) -> dict:
    """The verdict is the answer's last line, exactly; anything else is none."""
    lines = answer.rstrip().split("\n")
    m = VERDICT_RE.match(lines[-1].strip()) if lines else None
    if not m:
        return {"error": "its last line is not VERDICT: supported, overreaches or unsupported"}
    verdict = m.group(1)
    body = "\n".join(lines[:-1]).strip()
    findings, mark, narrower = body.partition(NARROWER_MARK)
    if mark:
        findings = findings.rstrip()
        # The marker's own line may carry a list number ("2.") before it.
        findings = re.sub(r"\n\W*\d*\W*\Z", "", findings).rstrip()
    narrower = single_line(narrower) if mark else ""
    if verdict == "overreaches" and not narrower:
        return {"error": f"an overreaches verdict without its narrower claim ({NARROWER_MARK})"}
    return {"verdict": verdict, "narrower": narrower if verdict == "overreaches" else "",
            "findings": findings.strip()}


def write_verdict(ident: str, n: int, result: "dict | None", failed: str, run: dict,
                  answer: str) -> None:
    d = checks_dir(ident) / str(n)
    info = parse_entry(d / "check.md")
    verdict = result["verdict"] if result else "none"
    fields = [("kind", "referee"), ("verdict", verdict)]
    if result and result["narrower"]:
        fields.append(("narrower", result["narrower"]))
    if failed:
        fields.append(("failed", failed))
    fields += [("agent", one(info, "agent")), ("asked", " ".join(json.loads(one(info, "model-flags") or "[]"))),
               ("model", ", ".join(run.get("models") or []) or "(not reported)"),
               ("cost-usd", str(run.get("cost")) if run.get("cost") is not None else "(not reported)"),
               ("usage", run.get("usage") or "(not reported)"),
               ("started", one(info, "started")), ("ended", now())]
    fields += [(k, v) for k in ("claim-sha256", "evidence", "accepted-sha256", "rerun-check")
               for v in info.get(k, [])]
    fields += [("snapshot", str(d / "snapshot")), ("output", str(d / "referee.out")),
               ("log", str(d / "referee.log"))]
    body = ""
    if result:
        body = (f"{NARROWER_MARK} {result['narrower']}\n\n" if result["narrower"] else "") \
            + "Findings:\n" + result["findings"].removeprefix("Findings:").strip()
    elif answer.strip():
        body = "The referee's answer, which gave no verdict:\n\n" + answer.strip()
    write_text(d / "verdict.md", render_entry(f"{ident} referee {n}",
                                              verdict if result else "no verdict", fields, body))


def run_referee(ident: str, n: int) -> int:
    """The detached referee: the lean agent run in the snapshot folder, its
    answer parsed, the verdict written."""
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    d = checks_dir(ident) / str(n)
    info = parse_entry(d / "check.md")
    agent = one(info, "agent")
    snap = d / "snapshot"
    prompt = (f"Read the file {snap / 'REFEREE.md'} and do exactly what it says. "
              "It is the whole task.")
    argv = referee_argv(agent, prompt, json.loads(one(info, "model-flags")))
    env = {k: v for k, v in os.environ.items() if k not in SESSION_VARS}
    env[GUARD] = "1"
    env[STRICT_GUARD] = "1"
    print("agent: " + " ".join(a if a not in (prompt, REFEREE_SYSTEM) else repr(a) for a in argv),
          flush=True)
    out_path = d / "referee.out"
    try:
        fd = os.open(str(out_path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
        with os.fdopen(fd, "wb") as out:
            rc = subprocess.run(argv, cwd=str(snap), env=env, stdin=subprocess.DEVNULL,
                                stdout=out).returncode
    except OSError as e:
        write_verdict(ident, n, None, f"could not start {argv[0]}: {e.strerror}", {}, "")
        print(f"result: no verdict (could not start {argv[0]})", flush=True)
        return 1
    print(f"agent exit: {rc}", flush=True)
    text = out_path.read_text(encoding="utf-8", errors="replace")
    run = parse_claude_output(text) if agent == "claude" else parse_pi_output(text)
    if "error" not in run and rc != 0:
        run["error"] = f"the agent exited {rc}"
    if "error" in run:
        write_verdict(ident, n, None, run["error"], run, run.get("answer", ""))
        print(f"result: no verdict ({run['error']})", flush=True)
        return 1
    result = parse_verdict(run["answer"])
    if "error" in result:
        write_verdict(ident, n, None, result["error"], run, run["answer"])
        print(f"result: no verdict ({result['error']})", flush=True)
        return 1
    write_verdict(ident, n, result, "", run, run["answer"])
    print(f"result: {result['verdict']}", flush=True)
    return 0


def cmd_check_child(a) -> None:

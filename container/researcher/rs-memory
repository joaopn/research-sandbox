def cmd_package_charter(a) -> None:
    refuse_under_guard("change charters")
    require_planner("rs-memory package charter")
    require_planning("changes a charter")
    name = valid_package_name(a.name)
    draft, new = charter_draft(a.charter)
    with working_in(package_memory(name)):
        with Lock():
            st = read_status(name)
            if st["state"] == "closed":
                raise Refused(f"package {name} is closed: its charter is kept as it was")
            old = charter_sections(read_charter(name), f"the charter of package {name}")
            changed = [("its title and introduction" if k == "" else k)
                       for k in ("",) + CHARTER_SECTIONS if old.get(k) != new.get(k)]
            if not changed:
                raise Refused(f"the charter draft {a.charter} says what package {name}'s charter "
                              "says already; nothing changed")
            write_text(package_dir(name) / CHARTER_FILE, charter_text(draft))
            st["changed"] = now()
            write_status(name, st)
            j = add_journal(f"charter changed: {', '.join(changed)}", "charter",
                            f"The planning session changed this package's charter "
                            f"({', '.join(changed)}). Read it again: "
                            f"{package_dir(name) / CHARTER_FILE}")
            refresh_pages()
    print(f"The charter of package {name} changed ({', '.join(changed)}); {j} journalled in the "
          "package, so its session sees it at its next rs-memory open.")



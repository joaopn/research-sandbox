NOTE_KINDS = ("did", "dead-end", "decision", "surprise", "correction")
# Entries that never call for a consolidation on their own: a consolidation's
# own entry (else every run would owe another), and a session's end (a second
# close, or one written while a run works, would otherwise owe a run for it).
QUIET_KINDS = ("consolidation", "session-end")
NOTHING_NEW = "nothing new since the last consolidation"

class Refused(Exception):
    """A refusal: the message names what is wrong and the next step."""


# --------------------------------------------------------------------- paths
# The memory this call works in when it is not the top: a package's, chosen
# from what the session holds (choose_memory), or set for a while by a verb
# that works in another package's memory (working_in).
_CURRENT: "dict[str, Path | None]" = {"dir": None}


def top_mem_dir() -> Path:
    """The project's top memory, RS_MEMORY_DIR (default /workspace/memory)."""
    return Path(os.environ.get("RS_MEMORY_DIR") or DEFAULT_DIR)


def mem_dir() -> Path:
    """The memory this call works in: the top, or a package's."""
    return _CURRENT["dir"] or top_mem_dir()


class working_in:
    """Work in another memory folder for a while (a package's, or the top)."""

    def __init__(self, d: Path):
        self.d = d

    def __enter__(self):
        self.old = _CURRENT["dir"]
        _CURRENT["dir"] = None if self.d == top_mem_dir() else self.d
        return self

    def __exit__(self, *a):
        _CURRENT["dir"] = self.old
        return False


def current_package() -> "str | None":
    """The package whose memory this call works in; None at the top."""
    d = _CURRENT["dir"]
    return d.parent.name if d is not None else None


def runtime_dir() -> Path:
    # A tmpfs: an in-flight marker left by a run killed with its container is
    # gone at the next start, when nothing can be running.
    return Path(os.environ.get("RS_MEMORY_RUNTIME_DIR") or "/dev/shm")


def inflight_marker() -> Path:
    """The in-flight marker of this memory's consolidation: one per memory,
    so a run in one package never holds up another's."""
    pkg = current_package()
    return runtime_dir() / (f"rs-memory-consolidating-{os.getuid()}"
                            + (f"-package-{pkg}" if pkg else ""))


def now() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def under_guard() -> bool:
    return os.environ.get(GUARD) == "1" or under_strict_guard()


def under_strict_guard() -> bool:
    return os.environ.get(STRICT_GUARD) == "1"


def workspace() -> Path:
    """The project's workspace: the top memory folder lives directly in it.
    Its record, the referee's model and a re-run's folder are the
    workspace's, in a package too."""
    return top_mem_dir().parent


def folder() -> Path:
    """The researcher's folder of the memory in use, where its pages are:
    the workspace for the top, packages/<name>/ for a package."""
    return mem_dir().parent


def record_path() -> Path:
    return workspace() / ".orchestrator" / "project.json"


def project_record() -> dict:
    """RS's record of this project; {} when there is none (outside a project)."""
    p = record_path()
    try:
        text = p.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {}
    except OSError as e:
        raise Refused(f"cannot read the project's record {p} ({e.strerror}), so rs-memory "
                      "cannot tell whether a finding's checks apply; tell the PI")
    try:
        data = json.loads(text)
    except (ValueError, RecursionError):
        raise Refused(f"the project's record {p} is not JSON, so rs-memory cannot tell "
                      "whether a finding's checks apply; tell the PI")
    if not isinstance(data, dict):
        raise Refused(f"the project's record {p} is not a JSON object, so rs-memory cannot "
                      "tell whether a finding's checks apply; tell the PI")
    return data


def companion_on() -> bool:
    """Whether this project's record makes the agent a companion; a record
    that also turns the finding checks on is refused."""
    rec = project_record()
    companion = rec.get(COMPANION_KEY) is True
    if companion and rec.get(CHECKS_KEY) is True:
        raise Refused(f"the project's record {record_path()} says both \"{COMPANION_KEY}\": true "
                      f"and \"{CHECKS_KEY}\": true, which cannot be set together: a companion "
                      "has no finding checks, and a researcher-subagents project is no "
                      "companion, so rs-memory cannot tell how this project's memory is kept. "
                      "It does nothing in this project until one of the two is gone from the "
                      "record; tell the PI")
    return companion


def refuse_both_kinds() -> None:
    """Every verb's first step: a record that makes the project both a
    companion and a researcher-subagents project refuses before anything is
    written. A record that cannot be read is refused where a verb reads it,
    as it always was."""
    try:
        project_record()
    except Refused:
        return
    companion_on()


def checks_kit() -> bool:
    """Whether this project has the finding checks at all (a researcher-
    subagents project): their verbs and options work there whatever the
    session's checks switch, so a check the PI asks for can always run."""
    companion_on()                      # refuses a record that sets both
    return project_record().get(CHECKS_KEY) is True


def checks_on() -> bool:
    """Whether a finding needs both its checks before the PI can accept it in
    THIS session: a researcher-subagents project whose session's checks switch
    is not off (the session's own, else the record's, else the default)."""
    return checks_kit() and session_switches()["checks"][0] != "off"


def checked_switches(raw: object, where: str,
                     known: "dict[str, tuple[str, ...]]" = SWITCHES) -> "dict[str, str]":
    """A switches object as written in the record (`known`: RECORD_SWITCHES)
    or a session's file (SWITCHES): an object whose keys are switches and
    whose values are among each switch's values. Anything else is refused,
    never read as a default."""
    if not isinstance(raw, dict):
        raise Refused(f"{where} holds the subagents and checks switches as something other "
                      "than an object, so rs-memory cannot tell how this session works; "
                      "tell the PI")
    for k, v in raw.items():
        if k not in known:
            raise Refused(f"{where} holds a switch rs-memory does not know ({single_line(k)!r}; "
                          f"it knows {', '.join(known)}); tell the PI")
        if v not in known[k]:
            raise Refused(f"{where} sets the {k} switch to {v!r}, which is not one of "
                          f"{', '.join(known[k])}; tell the PI")
    return dict(raw)


def record_switches() -> "dict[str, str]":
    """The switches the project's record sets ({} when it sets none), the
    planner among them; session_switches reads the session switches only."""
    rec = project_record()
    if SWITCHES_KEY not in rec:
        return {}
    return checked_switches(rec[SWITCHES_KEY], f"the project's record {record_path()}",
                            RECORD_SWITCHES)


def planner_on() -> bool:
    """Whether this project works in packages: a researcher-subagents project
    whose record sets the planner on."""
    return checks_kit() and record_switches().get(PLANNER) == "on"


def planner_read() -> bool:
    """planner_on for the pages, which are views: a record whose switches
    cannot be read writes them as without the planner, as before the
    planner existed (open and every verb that reads the switches say what is
    wrong with them)."""
    try:
        return planner_on()
    except Refused:
        return False


def session_source() -> "tuple[str, str] | None":
    """The session this command runs in and its agent: ("claude", Claude
    Code's CLAUDE_CODE_SESSION_ID) or ("pi", pi's PI_SESSION_ID); None outside
    a session (a terminal, a start hook that is not given the id). Both set:
    the agent detect_agent names."""
    claude = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    pi = os.environ.get("PI_SESSION_ID") or ""
    src = ("claude", claude) if claude else ("pi", pi)
    if claude and pi:
        agent = detect_agent(quiet=True)
        if agent is None:
            raise Refused("both a Claude session (CLAUDE_CODE_SESSION_ID) and a pi session "
                          "(PI_SESSION_ID) are in this shell's environment, so rs-memory "
                          "cannot tell which session's switches apply")
        src = ("claude", claude) if agent == "claude" else ("pi", pi)
    if not src[1]:
        return None
    if not SESSION_ID_RE.match(src[1]):
        raise Refused("this session's id holds characters rs-memory does not use in a file "
                      "name (only letters, digits, '.', '_' and '-'), so it cannot tell this "
                      "session's switches; tell the PI")
    return src


def session_id() -> "str | None":
    """The session this command runs in (session_source's id); None outside
    a session."""
    src = session_source()
    return src[1] if src else None


def session_file(sid: str) -> Path:
    """A session's file: always in the top memory, so its switches survive a
    package taken, and what it holds is found before its memory is chosen."""
    return top_mem_dir() / SESSIONS_DIR / f"{sid}.json"


def session_data(sid: str) -> dict:
    """A session's file as written: its switches and (planner on) what it
    holds, both checked ({} when it has none)."""
    p = session_file(sid)
    try:
        text = p.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        raise Refused(f"this session's switches {p} cannot be read ({e}); tell the PI")
    try:
        raw = json.loads(text)
    except (ValueError, RecursionError):
        raise Refused(f"this session's switches {p} are not JSON; tell the PI")
    if isinstance(raw, dict) and HOLDS_KEY in raw:
        raw = dict(raw)
        holds = raw.pop(HOLDS_KEY)
        if not (holds == HOLDS_TOP or (isinstance(holds, dict) and list(holds) == [HOLDS_PACKAGE]
                                       and isinstance(holds[HOLDS_PACKAGE], str)
                                       and PACKAGE_NAME_RE.match(holds[HOLDS_PACKAGE]))):
            raise Refused(f"this session's file {p} says it holds something rs-memory does not "
                          "know; tell the PI")
        return {**checked_switches(raw, f"this session's switches {p}"), HOLDS_KEY: holds}
    return checked_switches(raw, f"this session's switches {p}")


def session_record(sid: str) -> "dict[str, str]":
    """The switches a session recorded for itself ({} when it recorded none)."""
    return {k: v for k, v in session_data(sid).items() if k != HOLDS_KEY}


def write_session_data(sid: str, data: dict) -> None:
    """Write a session's file; the caller holds the top memory's lock."""
    try:
        write_text(session_file(sid), json.dumps(data, sort_keys=True) + "\n")
    except OSError as e:
        raise Refused(f"this session's file could not be written to {session_file(sid)} "
                      f"({e.strerror or e}); tell the PI")


def session_switches() -> "dict[str, tuple[str, str]]":
    """Each switch as this session works under it, and where that comes from:
    "session" (switched for this session), "project" (the project's record)
    or "default" (a record that does not set it: today's behaviour)."""
    rec = record_switches()
    sid = session_id()
    mine = session_record(sid) if sid else {}
    out = {}
    for k in SWITCHES:
        if k in mine:
            out[k] = (mine[k], "session")
        elif k in rec:
            out[k] = (rec[k], "project")
        else:
            out[k] = (SWITCH_DEFAULTS[k], "default")
    return out


def switches_held(sw: "dict[str, tuple[str, str]]") -> str:
    """" For a switch switched for this session, …" (with a leading space)
    when any switch comes from the session, "" otherwise: where the text the
    session now works under is (open and switch print it)."""
    if all(src != "session" for _v, src in sw.values()):
        return ""
    return (" For a switch switched for this session, the rs-mode skill's text for its value "
            "holds over your instructions' text for it (its SKILL.md, in ~/.claude/skills/"
            "harness/ under Claude Code and in skills/harness/ of pi's agent folder).")


def switch_words(sw: "dict[str, tuple[str, str]]") -> str:
    """The switches in plain words: "subagents on (the project's setting),
    checks off (switched for this session)"."""
    return ", ".join(f"{k} {v} ("
                     + ("switched for this session" if src == "session" else "the project's setting")
                     + ")" for k, (v, src) in sw.items())


def front_parts() -> tuple:
    """The front page's parts in this project: (key, heading, id letter,
    whether consolidation edits it), in page order."""
    return COMPANION_PARTS if companion_on() else RESEARCHER_PARTS


def part_by_key(parts: tuple) -> dict:
    return {k: (h, letter, c) for k, h, letter, c in parts}


def consolidated_parts(parts: tuple) -> tuple:
    return tuple(k for k, _h, _l, c in parts if c)


def item_line_re(parts: tuple) -> "re.Pattern":
    """A front page item line, `- [<letter>-<n>] <text>`, for these parts' letters."""
    letters = "".join(letter for _k, _h, letter, _c in parts)
    return re.compile(r"\A- \[([" + letters + r"]-[1-9][0-9]*)\] (.*)\Z")


def require_checks(what: str) -> None:
    if not checks_kit():
        raise Refused(f"{what} is for researcher-subagents projects only: this project's "
                      f"record ({record_path()}) does not say \"{CHECKS_KEY}\": true")


def ensure_layout() -> Path:
    d = mem_dir()
    for sub in ("front", "journal", "staged", "record", "struck",
                "skills/candidates", "skills/active", "runs"):
        (d / sub).mkdir(parents=True, exist_ok=True)
    return d


def write_text(path: Path, text: str, mode: "int | None" = None) -> None:
    """Write through a fresh temp file and a rename, so a reader never sees a
    half file and a link at the name is replaced, never followed."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        if mode is not None:
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class Lock:
    """A memory folder's lock file (flock): the memory in use, or the one
    named (`d`, e.g. the top's from inside a package). `wait=False` raises
    BlockingIOError when another writer holds it. Taken again in the same
    process (a package's write refreshing the top's pages while a take holds
    the top's lock), it is already held: a second flock on another descriptor
    of the same file would wait for this process itself."""

    _held: "dict[str, int]" = {}

    def __init__(self, wait: bool = True, d: "Path | None" = None):
        self.wait = wait
        self.d = d
        self.fd = None

    def __enter__(self):
        with working_in(self.d or mem_dir()):
            d = ensure_layout()
        self.key = os.path.abspath(str(d))
        if self.key in Lock._held:
            Lock._held[self.key] += 1
            return self
        self.fd = os.open(str(d / ".lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o644)
        flags = fcntl.LOCK_EX | (0 if self.wait else fcntl.LOCK_NB)
        try:
            fcntl.flock(self.fd, flags)
        except BaseException:
            os.close(self.fd)
            raise
        Lock._held[self.key] = 1
        return self

    def __exit__(self, *a):
        Lock._held[self.key] -= 1
        if Lock._held[self.key]:
            return False
        del Lock._held[self.key]
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)
        return False


# --------------------------------------------------------- tethered runs
def tethered(own_group: bool = False) -> "callable":
    """The preexec_fn of every process rs-memory starts: the new process asks
    the kernel for SIGTERM when the process that started it ends, and exits
    at once when that one already went before the request was in place;
    with `own_group`, it first becomes the leader of a process group of its
    own (run_group). Made in the starting process, so libc is loaded before
    the fork."""
    prctl = ctypes.CDLL(None, use_errno=True).prctl
    parent = os.getpid()

    def preexec() -> None:
        if own_group:
            os.setpgid(0, 0)
        # `close` ignores a hang-up while it starts its run; an ignored
        # signal is inherited, so the run gets the default back.
        signal.signal(signal.SIGHUP, signal.SIG_DFL)
        if prctl(PR_SET_PDEATHSIG, int(signal.SIGTERM), 0, 0, 0) != 0:
            os.write(2, f"rs-memory: the kernel refused to tie this run to its caller "
                        f"(prctl errno {ctypes.get_errno()}); it was not started\n".encode())
            os._exit(127)
        if os.getppid() != parent:
            os._exit(1)
    return preexec


class _Stopped(BaseException):
    """The waiting caller was told to stop (raised from its signal handler)."""


def start_tethered(argv: "list[str]", log: Path) -> subprocess.Popen:
    """Start one of this command's own runs tied to its caller: in the
    caller's process group, no input, its output appended to its log, and
    stopped by the kernel when the caller ends. The caller waits for it
    with wait_tethered. It works in the caller's memory: a package's is
    named to it in PACKAGE_ENV."""
    env = dict(os.environ)
    env.pop(PACKAGE_ENV, None)
    if current_package():
        env[PACKAGE_ENV] = current_package()
    fd = os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o644)
    try:
        return subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=fd, stderr=fd,
                                close_fds=True, preexec_fn=tethered(), env=env)
    finally:
        os.close(fd)


def run_group(argv: "list[str]", timeout: "float | None" = None, **kw) -> "int | None":
    """Run what a run starts (the re-run's command, an agent) under a keeper
    (`_keep`, keep()): the keeper leads a process group of its own, tied to
    this run, and starts the command inside that group. The whole group is
    ended whatever happens: here when the command ends (so nothing it left
    in the background keeps going), at `timeout` (then None is returned), and
    when this run is told to stop (SIGTERM, SIGINT, SIGHUP: what the parent-
    death request and wait_tethered send it; it then exits non-zero); and by
    the keeper itself when this run dies in a way no handler sees (a SIGKILL
    to the caller's whole process group, which is how pi stops a call): the
    keeper's parent-death signal then takes its group down. The group is the
    keeper's own because a runtime that kills the caller's group would
    otherwise kill this run and leave the command's children running. A
    command that cannot be found raises FileNotFoundError here, as starting
    it directly would."""
    env = kw.get("env", os.environ)
    if shutil.which(argv[0], path=env.get("PATH", os.defpath)) is None:
        raise FileNotFoundError(2, os.strerror(2), argv[0])
    sigs = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)

    def stop(signum, _frame):
        raise _Stopped(signum)
    old = {s: signal.signal(s, stop) for s in sigs}
    child = None
    me = os.path.realpath(sys.argv[0])
    try:
        child = subprocess.Popen([sys.executable, me, KEEP_VERB, "--", *argv],
                                 preexec_fn=tethered(own_group=True), **kw)
        try:
            return child.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            return None
    except _Stopped as e:
        for s in sigs:
            signal.signal(s, signal.SIG_IGN)
        sys.exit(128 + e.args[0])
    finally:
        if child is not None:
            stop_group(child)
        for s, h in old.items():
            signal.signal(s, h)


KEEP_VERB = "_keep"


def keep(argv: "list[str]") -> int:
    """The keeper (`rs-memory _keep -- ARGV...`), started by run_group as the
    leader of a process group of its own: a stop signal (SIGTERM, SIGINT,
    SIGHUP; its parent-death signal is SIGTERM) ends the whole group with
    SIGKILL, the keeper included. Its handlers are in place before ARGV is
    started, so a signal that comes earlier ends the keeper before ARGV
    exists. ARGV runs in the keeper's group, tied to the keeper, and the
    keeper exits with its status (128 + the signal when a signal ended it).
    It reads no project record and prints nothing on stdout (which may be a
    referee's answer file)."""
    def end(_signum, _frame):
        os.killpg(os.getpgrp(), signal.SIGKILL)
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, end)
    try:
        child = subprocess.Popen(argv, preexec_fn=tethered())
    except (OSError, IndexError) as e:
        print(f"rs-memory: the keeper could not start {argv[:1]}: {e}", file=sys.stderr)
        return 127
    rc = child.wait()
    return 128 - rc if rc < 0 else rc


def stop_group(child: subprocess.Popen) -> None:
    """End every process left in the group `child` leads, then reap `child`.
    SIGKILL straight away, with no grace for SIGTERM: everything in the group
    is a run rs-memory ends on purpose and nothing in it is kept beyond the
    files it already wrote (rs-memory writes the check's record and the
    consolidation's result itself, after the group is gone, and every
    rs-memory write is a temp file and a rename, never half a file); and
    SIGKILL cannot be caught or ignored, so the stop is certain and needs no
    wait of a chosen length. The group's id stays the leader's pid while any
    member is alive (the kernel never hands out a pid still in use as a
    group's id), so this never signals a stranger."""
    try:
        os.killpg(child.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass                            # the group is empty: nothing left
    child.wait()


def wait_tethered(child: subprocess.Popen) -> int:
    """Wait for a run start_tethered started. A caller told to stop (SIGTERM,
    SIGINT, SIGHUP) stops the run, waits for it to go, and exits non-zero."""
    return wait_all_tethered([child])[0]


def wait_all_tethered(children: "list[subprocess.Popen]") -> "list[int]":
    """Wait for every run start_tethered started (they run side by side), and
    return their exit codes. A caller told to stop (SIGTERM, SIGINT, SIGHUP)
    stops every run, waits for them all to go, and exits non-zero."""
    sigs = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)

    def stop(signum, _frame):
        raise _Stopped(signum)
    old = {s: signal.signal(s, stop) for s in sigs}
    try:
        return [child.wait() for child in children]
    except _Stopped as e:
        for s in sigs:
            signal.signal(s, signal.SIG_IGN)
        for child in children:
            if child.poll() is None:
                child.terminate()
        for child in children:
            child.wait()
        sys.exit(128 + e.args[0])
    finally:
        for s, h in old.items():
            signal.signal(s, h)


# ------------------------------------------------------------------- journal
def journal_files() -> "list[tuple[int, Path]]":
    root = mem_dir() / "journal"
    out = []
    if not root.is_dir():
        return out
    for month in root.iterdir():
        if not month.is_dir():
            continue
        for f in month.glob("J-*.md"):
            m = JOURNAL_ID_RE.match(f.stem)
            if m:
                out.append((int(m.group(1)), f))
    out.sort()
    return out


def parse_entry(path: Path) -> dict:
    """An entry or claim file: a `# <id> — <headline>` line, `key: value`
    lines, a blank line, then the body. Repeated keys collect into lists."""
    text = path.read_text(encoding="utf-8")
    lines = text.split("\n")
    head = lines[0][2:] if lines and lines[0].startswith("# ") else ""
    ident, _, headline = head.partition(" — ")
    meta: dict = {"id": ident.strip(), "headline": headline.strip(), "path": path}
    i = 1
    while i < len(lines) and lines[i].strip():
        k, sep, v = lines[i].partition(": ")
        if sep:
            meta.setdefault(k.strip(), []).append(v)
        i += 1
    meta["body"] = "\n".join(lines[i + 1:]).strip()
    return meta


def one(meta: dict, key: str, default: str = "") -> str:
    v = meta.get(key)
    return v[0] if isinstance(v, list) and v else default


def render_entry(ident: str, headline: str, fields: "list[tuple[str, str]]", body: str) -> str:
    out = [f"# {ident} — {single_line(headline)}"]
    for k, v in fields:
        out.append(f"{k}: {v.strip() if k in RAW_FIELDS else single_line(v)}")
    out.append("")
    if body.strip():
        out.append(body.strip())
        out.append("")
    return "\n".join(out)


def single_line(s: str) -> str:
    return " ".join(str(s).split())


def session_label() -> str:
    agent = detect_agent(quiet=True) or "unknown"
    sid = os.environ.get("PI_SESSION_ID") or ""
    return f"{agent} {sid}".strip()


def add_journal(headline: str, kind: str, body: str = "",
                fields: "list[tuple[str, str]] | None" = None) -> str:
    """Append one entry; the caller holds the lock. Returns its id. `fields`
    are written after the standard ones."""
    files = journal_files()
    n = (files[-1][0] + 1) if files else 1
    ident = f"J-{n}"
    month = _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m")
    path = mem_dir() / "journal" / month / f"{ident}.md"
    write_text(path, render_entry(ident, headline, [
        ("kind", kind), ("session", session_label()), ("time", now()), *(fields or [])], body))
    return ident


def consolidated_mark() -> int:
    p = mem_dir() / "consolidated"
    try:
        m = JOURNAL_ID_RE.match(p.read_text(encoding="utf-8").strip())
    except FileNotFoundError:
        return 0
    return int(m.group(1)) if m else 0


def entries_since_mark() -> "list[tuple[int, Path]]":
    mark = consolidated_mark()
    return [(n, f) for n, f in journal_files() if n > mark]


def new_since_mark() -> "list[tuple[int, Path]]":
    """Entries since the mark that call for a consolidation: a consolidation's
    own entries and a session's end never do (QUIET_KINDS)."""
    return [(n, f) for n, f in entries_since_mark()
            if one(parse_entry(f), "kind") not in QUIET_KINDS]


# ---------------------------------------------------------------- front page
def empty_front() -> dict:
    return {"page": 0, "next": 1, "parts": {k: [] for k, *_ in front_parts()}}


def read_front(p: "Path | None" = None) -> dict:
    p = p or mem_dir() / "front.md"
    try:
        text = p.read_text(encoding="utf-8")
    except FileNotFoundError:
        return empty_front()
    m = FRONT_MARK_RE.search(text)
    if not m:
        raise Refused(f"{p} has no rs-memory header line; it was not written by "
                      "rs-memory. Move it aside and run the command again.")
    parts = front_parts()
    front = {"page": int(m.group(1)), "next": int(m.group(2)),
             "parts": {k: [] for k, *_ in parts}}
    heading_to_key = {h: k for k, h, *_ in parts}
    item_re = item_line_re(parts)
    cur = None
    for line in text.split("\n"):
        if line.startswith("## "):
            # Any other heading, the facts section's included, holds no items.
            cur = heading_to_key.get(line[3:].strip())
            continue
        im = item_re.match(line)
        if im and cur:
            front["parts"][cur].append((im.group(1), im.group(2)))
    return front


def render_front(front: dict) -> str:
    """The page from its parts, then the facts section computed from the
    record as it is now (absent when no fact is current)."""
    out = ["# Front page", "",
           f"<!-- rs-memory page={front['page']} next={front['next']} -->", ""]
    for k, heading, _letter, _c in front_parts():
        out.append(f"## {heading}")
        for ident, text in front["parts"][k]:
            out.append(f"- [{ident}] {text}")
        out.append("")
    facts = fact_lines(record_entries())
    if facts:
        out.append(f"## {FACTS_HEADING}")
        out += facts
        out.append("")
    return "\n".join(out)


def fact_lines(rec: "dict[str, dict]") -> "list[str]":
    """The front page's lines for the current accepted facts, oldest first."""
    st = standing(rec)
    facts = sorted((int(i[2:]), i) for i in rec if i.startswith("D-") and st[i] == "current")
    return [f"- ({i}) {rec[i]['headline']} — scope: {one(rec[i], 'scope')}" for _n, i in facts]


def new_item_id(front: dict, part: str) -> str:
    ident = f"{part_by_key(front_parts())[part][1]}-{front['next']}"
    front["next"] += 1
    return ident



# ------------------------------------------------------------ work packages
# The shape of `package list --json`, kept stable: RS and the browser read it.
PACKAGES_JSON_DOC = """\
`rs-memory package list --json` prints, for RS and the browser, one object (paths are
relative to the workspace; "alive": whether the holder's process runs):
  {"version": 1, "planner": "on"|"off",
   "planning": null | {"session": ID, "alive": BOOL, "since": TIME},
   "packages": [{"name": NAME, "state": "open"|"done"|"closed",
                 "holder": null | {"session": ID, "alive": BOOL, "since": TIME},
                 "charter": "packages/NAME/charter.md",
                 "page": "packages/NAME/README.md",
                 "staged": N, "accepted": N}],
   "problems": [{"name": ENTRY, "problem": TEXT}]}
"problems" names what under packages/ is not a package rs-memory can read.
"""
# With the planner on (the record's research_switches object), the work is
# split into packages under <workspace>/packages/ (the module docstring says
# how). What each call does in them follows from what its session holds,
# chosen once per call before the verb runs (choose_memory).
SESSION: dict = {"planner": False, "binding": None, "lost": None, "sid": None}
# The verbs rs-memory runs as its own children: they work in the memory
# their caller names (PACKAGE_ENV), never by what a session holds.
INTERNAL_VERBS = ("_run", "_rerun", "_referee")


class Unreadable(Exception):
    """A file that is there and is not one rs-memory can read: why."""


def valid_package_name(raw: str) -> str:
    if not isinstance(raw, str) or not PACKAGE_NAME_RE.match(raw):
        raise Refused(f"{raw!r} is not a package name: letters, digits, '-' and '_', a letter "
                      "or digit first (like a project's name), e.g. station-gaps")
    return raw


def packages_root() -> Path:
    return workspace() / PACKAGES_DIR


def package_dir(name: str) -> Path:
    return packages_root() / name


def real_folder(p: Path) -> "bool | None":
    """None when nothing is at p; True for a folder; False for anything else
    (a link, a file): links are never followed."""
    try:
        return stat.S_ISDIR(os.lstat(p).st_mode)
    except FileNotFoundError:
        return None


def read_small(path: Path, cap: int) -> bytes:
    """A plain file's bytes, opened without following a link or waiting on a
    pipe; FileNotFoundError when nothing is there, Unreadable when it is not
    a plain file or holds more than `cap` bytes."""
    try:
        fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        raise
    except OSError as e:
        raise Unreadable(f"it cannot be opened as a plain file ({e.strerror or e})")
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Unreadable("it is not a plain file")
        chunks, size = [], 0
        while size <= cap:
            b = os.read(fd, 1 << 16)
            if not b:
                break
            chunks.append(b)
            size += len(b)
        if size > cap:
            raise Unreadable(f"it holds more than {cap} bytes")
        return b"".join(chunks)
    except OSError as e:
        raise Unreadable(f"it cannot be read ({e.strerror or e})")
    finally:
        os.close(fd)


def package_memory(name: str) -> Path:
    """A package's memory folder, packages/<name>/memory under the workspace,
    each level a real folder: anything else is refused, naming it."""
    name = valid_package_name(name)
    for p in (packages_root(), package_dir(name), package_dir(name) / "memory"):
        st = real_folder(p)
        if st is None:
            raise Refused(f"there is no package {name}: {p} does not exist "
                          "(rs-memory package list lists the packages)")
        if st is False:
            raise Refused(f"{p} is not a folder (a link or a file is there), so it is no work "
                          f"package's memory: rs-memory works only in the top memory "
                          f"{top_mem_dir()} and in {packages_root()}/<name>/memory; tell the PI")
    return package_dir(name) / "memory"


def refuse_package_as_top(top: Path) -> None:
    """RS_MEMORY_DIR naming a package's memory would make it the top: the
    record and the other packages would be looked for in the wrong place."""
    ws = top.parent.parent.parent
    if (top.name == "memory" and top.parent.parent.name == PACKAGES_DIR
            and os.path.lexists(ws / ".orchestrator" / "project.json")):
        raise Refused(f"RS_MEMORY_DIR names {top}, a work package's memory, not the project's "
                      f"top memory ({ws / 'memory'}): a session works in a package's memory by "
                      f"taking the package (rs-memory take {top.parent.name}), with RS_MEMORY_DIR "
                      "left at the top memory")


def check_holder(h: object, where: str) -> "dict | None":
    if h is None:
        return None
    if (not isinstance(h, dict) or sorted(h) != sorted(HOLDER_KEYS)
            or not isinstance(h["session"], str) or not SESSION_ID_RE.match(h["session"])
            or type(h["pid"]) is not int or h["pid"] <= 0
            or type(h["start"]) is not int or h["start"] < 0
            or not isinstance(h["since"], str)):
        raise Refused(f"{where} names its holder in a shape rs-memory does not write; tell the PI")
    return h


def read_json_small(path: Path, what: str) -> object:
    """A status file's JSON; FileNotFoundError when absent."""
    try:
        raw = read_small(path, STATUS_MAX_BYTES)
    except Unreadable as e:
        raise Refused(f"{what}, {path}, cannot be read: {e}; tell the PI")
    try:
        return json.loads(raw.decode("utf-8"))
    except (ValueError, RecursionError):
        raise Refused(f"{what}, {path}, is not JSON; tell the PI")


def read_status(name: str) -> dict:
    """A package's status (package.json), checked."""
    d = package_dir(name)
    if real_folder(d) is not True:
        raise Refused(f"there is no package {name} ({d} is not a folder); rs-memory package "
                      "list lists the packages")
    p = d / PACKAGE_STATUS
    try:
        data = read_json_small(p, f"the status of package {name}")
    except FileNotFoundError:
        raise Refused(f"{d} has no {PACKAGE_STATUS}, so it is no work package rs-memory made; "
                      "tell the PI")
    if (not isinstance(data, dict) or sorted(data) != sorted(PACKAGE_KEYS)
            or data["name"] != name or data["state"] not in PACKAGE_STATES
            or not isinstance(data["created"], str) or not isinstance(data["changed"], str)):
        raise Refused(f"the status of package {name}, {p}, is not one rs-memory writes; tell "
                      "the PI")
    check_holder(data["holder"], f"the status of package {name}, {p},")
    return data


def write_status(name: str, data: dict) -> None:
    """The caller holds the package's lock."""
    write_text(package_dir(name) / PACKAGE_STATUS, json.dumps(data, indent=2, sort_keys=True) + "\n")


def planning_path() -> Path:
    return top_mem_dir() / PLANNING_FILE


def read_planning() -> "dict | None":
    """The holder of the project's top (the planning session), or None."""
    p = planning_path()
    try:
        data = read_json_small(p, "the planning session's file")
    except FileNotFoundError:
        return None
    if not isinstance(data, dict) or list(data) != ["holder"]:
        raise Refused(f"the planning session's file {p} is not one rs-memory writes; tell the PI")
    return check_holder(data["holder"], f"the planning session's file {p}")


def write_planning(holder: "dict | None") -> None:
    """The caller holds the top memory's lock."""
    write_text(planning_path(), json.dumps({"holder": holder}, indent=2, sort_keys=True) + "\n")


def proc_stat(pid: int) -> "list[str] | None":
    """/proc/<pid>/stat's fields after the command name (the third field on):
    the state first, then the parent's pid; None when there is no such
    process."""
    if pid <= 0:
        return None
    try:
        text = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    return text.rpartition(")")[2].split()


def proc_start(pid: int) -> "int | None":
    """A running process's start time (clock ticks after boot, stat's 22nd
    field); None when there is no such process or it has ended (a zombie)."""
    f = proc_stat(pid)
    try:
        return None if f is None or f[0] in ("Z", "X") else int(f[19])
    except (IndexError, ValueError):
        return None


def holder_alive(h: "dict | None") -> bool:
    """Whether a holder's agent still runs: its pid is there with the start
    time recorded at the take (a pid reused after a restart is not it)."""
    return h is not None and proc_start(h["pid"]) == h["start"]


def agent_process(src: "tuple[str, str]") -> "tuple[int, int]":
    """This session's agent process and its start time: CLAUDE_PID under
    Claude Code; under pi the first process above this command whose
    environment does not carry this PI_SESSION_ID (pi's bash tool sets it for
    the commands it runs; pi's own process does not have it)."""
    agent, sid = src
    if agent == "claude":
        try:
            pid = int(os.environ.get("CLAUDE_PID") or "")
        except ValueError:
            raise Refused("CLAUDE_PID is not set in this shell (Claude Code sets it in every "
                          "command its session runs), so rs-memory cannot tell which process is "
                          "this session's agent; run it from the agent's session")
        start = proc_start(pid)
        if start is None:
            raise Refused(f"CLAUDE_PID names process {pid}, which is not running, so it cannot "
                          "hold anything; run it from the agent's session")
        return pid, start
    want = f"PI_SESSION_ID={sid}".encode()
    pid = os.getppid()
    while pid > 1:
        try:
            env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        except OSError as e:
            raise Refused(f"rs-memory cannot read the environment of process {pid}, above it, so "
                          f"it cannot tell which process is this pi session ({e.strerror or e}); "
                          "tell the PI")
        if want not in env:
            start = proc_start(pid)
            if start is None:
                break
            return pid, start
        f = proc_stat(pid)
        try:
            pid = int(f[1]) if f else 0
        except (IndexError, ValueError):
            pid = 0
    raise Refused("rs-memory found no process above it that is this pi session's own (each "
                  "carries its PI_SESSION_ID), so it cannot tell which process holds what this "
                  "session takes; run it from pi's bash tool")


def holder_record(src: "tuple[str, str]") -> dict:
    pid, start = agent_process(src)
    return {"session": src[1], "pid": pid, "start": start, "since": now()}


def binding(sid: str) -> "tuple[tuple[str, str | None] | None, str | None]":
    """What this session holds now, checked against the holder's record:
    ("top", None), ("package", NAME) or None; and, when its file names
    something it no longer holds, a sentence on that."""
    holds = session_data(sid).get(HOLDS_KEY)
    if holds is None:
        return None, None
    if holds == HOLDS_TOP:
        h = read_planning()
        if h is not None and h["session"] == sid:
            return ("top", None), None
        return None, ("this session planned, but "
                      + (f"session {h['session']} took the project's top after this session's "
                         "agent ended" if h else "it gave the project's top back")
                      + "; take it again with rs-memory plan")
    name = holds[HOLDS_PACKAGE]
    try:
        h = read_status(name)["holder"]
    except Refused as e:
        return None, f"this session held package {name}, whose status cannot be read now: {e}"
    if h is not None and h["session"] == sid:
        return ("package", name), None
    return None, (f"this session held package {name}, but "
                  + (f"session {h['session']} took it after this session's agent ended"
                     if h else "it was given back")
                  + "; take a package again (rs-memory take <package>)")


def claims_count(name: str, where: str) -> int:
    """How many claims a package's staged/ or record/ holds (0 when it cannot
    be read: the listing never fails on it); links are never followed."""
    d = package_dir(name) / "memory" / where
    if real_folder(package_dir(name) / "memory") is not True or real_folder(d) is not True:
        return 0
    try:
        return sum(1 for n in os.listdir(d) if n.endswith(".md") and CLAIM_ID_RE.match(n[:-3]))
    except OSError:
        return 0


def package_entries() -> "tuple[list[dict], list[tuple[str, str]]]":
    """Every package under packages/, by name, with its status and claim
    counts; and what is there that is no package rs-memory can read (name,
    why). Read only, never following a link."""
    root = packages_root()
    st = real_folder(root)
    if st is None:
        return [], []
    if st is False:
        return [], [(PACKAGES_DIR, f"{root} is not a folder (a link or a file is there)")]
    try:
        names = sorted(os.listdir(root))
    except OSError as e:
        return [], [(PACKAGES_DIR, f"{root} cannot be read ({e.strerror or e})")]
    entries, problems = [], []
    for n in names:
        if not PACKAGE_NAME_RE.match(n):
            problems.append((n, f"{root / n} is no package rs-memory made (not a package name)"))
            continue
        try:
            status = read_status(n)
            package_memory(n)           # its memory a real folder, never a link elsewhere
        except Refused as e:
            problems.append((n, str(e)))
            continue
        entries.append({"name": n, "status": status, "staged": claims_count(n, "staged"),
                        "accepted": claims_count(n, "record")})
    return entries, problems


def state_words(status: dict, sid: "str | None" = None) -> str:
    """A package's state in plain words."""
    if status["state"] != "open":
        return status["state"]
    h = status["holder"]
    if h is None:
        return "open, not taken"
    if not holder_alive(h):
        return "open, free (the session that held it has ended)"
    if sid and h["session"] == sid:
        return "open, held by this session"
    return f"open, being worked on in a live session ({h['session']}, since {fmt_time(h['since'])})"


def planning_words(sid: "str | None" = None) -> str:
    try:
        h = read_planning()
    except Refused as e:
        return f"Planning (the project's top): cannot be read: {e}"
    if h is None or not holder_alive(h):
        return "Planning (the project's top): free"
    who = "this session" if sid and h["session"] == sid else f"a live session ({h['session']})"
    return f"Planning (the project's top): held by {who} since {fmt_time(h['since'])}"


def packages_text(sid: "str | None" = None) -> str:
    """The packages, one line each, and the planning session."""
    entries, problems = package_entries()
    lines = ["## Packages"]
    if not entries:
        lines.append("none yet: the planning session adds them (rs-memory package add)")
    for e in entries:
        n = e["name"]
        lines.append(f"- {n}: {state_words(e['status'], sid)}; charter "
                     f"{package_dir(n) / CHARTER_FILE}; {e['staged']} staged, "
                     f"{e['accepted']} accepted")
    for n, why in problems:
        lines.append(f"- {n}: not a package rs-memory can read: {why}")
    lines += ["", planning_words(sid)]
    return "\n".join(lines)


def holder_json(h: "dict | None") -> "dict | None":
    if h is None:
        return None
    return {"session": h["session"], "alive": holder_alive(h), "since": h["since"]}


def packages_json() -> dict:
    """package list --json: the shape the module docstring documents."""
    entries, problems = package_entries()
    try:
        planning = holder_json(read_planning())
    except Refused as e:
        planning = None
        problems.append((PLANNING_FILE, str(e)))
    return {"version": 1, "planner": record_switches().get(PLANNER, "off"),
            "planning": planning,
            "packages": [{"name": e["name"], "state": e["status"]["state"],
                          "holder": holder_json(e["status"]["holder"]),
                          "charter": f"{PACKAGES_DIR}/{e['name']}/{CHARTER_FILE}",
                          "page": f"{PACKAGES_DIR}/{e['name']}/README.md",
                          "staged": e["staged"], "accepted": e["accepted"]} for e in entries],
            "problems": [{"name": n, "problem": why} for n, why in problems]}


def choose_memory(a) -> None:
    """Before every verb: the memory this call works in. rs-memory's own runs
    work in the memory their caller named; a consolidation's or referee's run
    too. Otherwise, with the planner on, the memory of what the session
    holds (a package's, or the top); with it off, the top."""
    if a.fn is cmd_analyst_check:
        return              # reads only, and any failure there is silence
    refuse_package_as_top(top_mem_dir())
    pkg = os.environ.get(PACKAGE_ENV)
    if under_guard() or a.verb in INTERNAL_VERBS:
        if pkg:
            _CURRENT["dir"] = package_memory(pkg)
        return
    if pkg is not None:
        raise Refused(f"{PACKAGE_ENV} is set in this shell: rs-memory sets it only for its own "
                      "runs, and a session reaches a package's memory by taking the package "
                      f"(rs-memory take <package>). Run it without {PACKAGE_ENV}")
    try:
        on = planner_on()
    except Refused:
        return              # the verb meets the same refusal where it reads the record
    if not on:
        return
    SESSION["planner"] = True
    src = session_source()
    if src is None:
        return
    SESSION["sid"] = src[1]
    SESSION["binding"], SESSION["lost"] = binding(src[1])
    if SESSION["binding"] and SESSION["binding"][0] == "package":
        _CURRENT["dir"] = package_memory(SESSION["binding"][1])


def take_first() -> str:
    lost = f" ({SESSION['lost']})" if SESSION["lost"] else ""
    return ("this project works in work packages, and this session holds none yet, so it "
            "writes nothing: take the project's top to plan (rs-memory plan) or a package to "
            "work in (rs-memory take <package>) first; rs-memory open lists the packages" + lost)


def refuse_unheld_write(a) -> None:
    """With the planner on, a session that holds nothing writes nothing, and
    the session that holds a closed package writes nothing into it."""
    if not SESSION["planner"] or under_guard() or a.verb in INTERNAL_VERBS:
        return
    writes = (a.fn in WRITE_VERBS
              or (a.fn is cmd_switch and (a.subagents is not None or a.checks is not None))
              or (a.fn is cmd_consolidate and a.apply))
    if not writes:
        return
    b = SESSION["binding"]
    if b is None:
        raise Refused(take_first())
    if b[0] == "package" and read_status(b[1])["state"] == "closed":
        raise Refused(f"package {b[1]} is closed: it takes no more writes. Give it back with "
                      "rs-memory release, and ask the user what to take next")


def require_planner(verb: str) -> None:
    if not planner_on():
        raise Refused(f"{verb} is for a project that works in work packages, and this project's "
                      "planner is off: every session works at the project's top. The PI turns "
                      "the planner on in the project's settings")


def need_session(what: str) -> "tuple[str, str]":
    src = session_source()
    if src is None:
        raise Refused(f"rs-memory cannot tell which session {what}: neither "
                      "CLAUDE_CODE_SESSION_ID (Claude Code) nor PI_SESSION_ID (pi) is set in "
                      "this shell. Run it from the agent's session")
    return src


def require_planning(what: str) -> None:
    b = SESSION["binding"]
    if b == ("top", None):
        return
    now_ = (f"works in package {b[1]}" if b else "does not plan") + (
        f" ({SESSION['lost']})" if SESSION["lost"] else "")
    raise Refused(f"only the planning session {what}, and this session {now_}. The planning "
                  "session is the one that took the project's top with rs-memory plan")


def charter_sections(text: str, where: str) -> "dict[str, str]":
    """A charter's parts: "" for the text above its first section, then each
    of CHARTER_SECTIONS, checked (each once, not empty, no other section)."""
    shape = ("A charter has the sections " + ", ".join(f"`## {h}`" for h in CHARTER_SECTIONS)
             + ", each once and none of them empty (anything above the first is free)")
    parts: "dict[str, list[str]]" = {"": []}
    cur, seen = "", []
    for line in text.split("\n"):
        if line.startswith("## "):
            cur = line[3:].strip()
            if cur not in CHARTER_SECTIONS:
                raise Refused(f"{where} has a section a charter does not: `## {cur}`. {shape}")
            if cur in parts:
                raise Refused(f"{where} has `## {cur}` more than once. {shape}")
            parts[cur], seen = [], seen + [cur]
            continue
        parts[cur].append(line)
    missing = [h for h in CHARTER_SECTIONS if h not in parts]
    if missing:
        raise Refused(f"{where} lacks " + ", ".join(f"`## {h}`" for h in missing) + f". {shape}")
    empty = [h for h in CHARTER_SECTIONS if not "\n".join(parts[h]).strip()]
    if empty:
        raise Refused(f"{where} leaves " + ", ".join(f"`## {h}`" for h in empty)
                      + f" empty. {shape}")
    return {k: "\n".join(v).strip() for k, v in parts.items()}


def charter_text(draft: str) -> str:
    return f"{CHARTER_MARK}\n\n{draft.strip()}\n"


def read_charter(name: str) -> str:
    """A package's charter as rs-memory wrote it, its mark line removed."""
    p = package_dir(name) / CHARTER_FILE
    try:
        text = read_small(p, TEXT_MAX_BYTES).decode("utf-8")
    except FileNotFoundError:
        raise Refused(f"package {name} has no charter ({p} is not there); tell the PI")
    except (Unreadable, UnicodeDecodeError) as e:
        raise Refused(f"the charter of package {name}, {p}, cannot be read ({e}); tell the PI")
    first, _sep, rest = text.partition("\n")
    if first != CHARTER_MARK:
        raise Refused(f"{p} was not written by rs-memory (its first line is not rs-memory's "
                      "mark), so rs-memory does not change it; tell the PI")
    return rest



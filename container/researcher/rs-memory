#!/opt/conda/bin/python
"""rs-memory — a research agent's memory, kept as plain files the PI can read.

Everything lives under /workspace/memory/ (RS_MEMORY_DIR overrides it):

  front.md                      the front page: line of inquiry, beliefs, in
                                flight, open threads; one item per line, each
                                with an id; its number in the header
  front/<n>.md                  every earlier front page, never deleted
  journal/<yyyy-mm>/J-<n>.md    one entry per unit of work
  staged/F-<n>.md, Q-, R-       claims waiting for the PI
  record/F-<n>.md, Q-, R-       accepted findings, questions, retractions
  struck/                       staged claims the PI struck
  skills/candidates/earned-*/   proposed skills, loaded by no agent
  skills/active/earned-*/       promoted skills, copied into the agents' homes
  skills.log                    one line per skill event
  consolidated                  the last journal entry a consolidation covered
  runs/                         consolidation runs: brief, delta, log
  checks/<id>/<n>/              a finding's checks, in a researcher-subagents
                                project only: a re-run (rerun/, rerun.md) or a
                                referee run (snapshot/, verdict.md); never
                                deleted, the audit trail

Verbs:
  open [--hook]                 what to read at the start of a session
  note HEADLINE --kind K [--body TEXT]
  checkpoint ITEM...            replace the "In flight" part of the front page
  claim STATEMENT --scope S --evidence FILE... [--hedge H] [relations] [--topic T]
        [--rerun CMD | --no-rerun REASON]
  rerun-command ID (--rerun CMD | --no-rerun REASON)
  rerun ID  /  referee ID [--agent claude|pi]
  accept ID... [--over-objection]  /  strike ID... --reason R
  view [ID | --topic T]         the state of knowledge, computed at every call
  recall WORD... [--body]
  skill propose|used|promote|retire|sync|list
  consolidate --prompt [--out FILE]  /  consolidate --apply DELTA
  close [--hook] [--agent claude|pi]
  analyst-check [--hook claude]  whether an analyst's reply names a results
                                folder holding its writeup.md (reads only)

The checks (--rerun, rerun-command, rerun, referee, --over-objection and
accept's conditions on a finding) exist only in a project whose record,
/workspace/.orchestrator/project.json, says "subagents": true; anywhere else
every verb behaves as it always has.

It never deletes anything under the memory folder: a struck claim moves to
struck/, an old front page to front/. Ids and the front page are written under
one lock file, so two sessions never hand out the same number.

Standard library only; run by RS's own interpreter.
"""
from __future__ import annotations

import argparse
import datetime as _dt
import fcntl
import hashlib
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

# ----------------------------------------------------------------- constants
DEFAULT_DIR = "/workspace/memory"
GUARD = "RS_MEMORY_CONSOLIDATING"
# The referee run's guard, stricter than GUARD: under it every verb that
# writes refuses, consolidate included (a consolidation run needs consolidate
# --apply; a referee writes nothing). The referee gets both.
STRICT_GUARD = "RS_MEMORY_REFEREEING"
# The project record's key that turns the finding checks on.
CHECKS_KEY = "subagents"
# What a fresh process drops from the session's environment, as the
# consolidation run does: the child is no part of the agent's session.
SESSION_VARS = ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "PI_SESSION_ID", "PI_SESSION_FILE")
VERDICTS = ("supported", "overreaches", "unsupported")
OBJECTIONS = ("overreaches", "unsupported")
VERDICT_RE = re.compile(r"\AVERDICT: (supported|overreaches|unsupported)\Z")
NARROWER_MARK = "Narrower claim:"
# The referee's instruction ships beside this command (the PATH link resolved).
REFEREE_FILE = Path(os.path.realpath(__file__)).parent / "rs-memory-referee.md"
REFEREE_SYSTEM = ("You are an independent research referee. Use only the file-reading "
                  "tools you are given, and answer in plain text.")
# Read-only tools only: the referee reads its snapshot folder and answers.
CLAUDE_REFEREE_TOOLS = "Read,Grep,Glob"
PI_REFEREE_TOOLS = "read,grep,find,ls"
# Fields written as given, never folded onto one line by spaces: a shell
# command's spacing can matter (a command holding a newline is refused).
# "rerun" is the claim's command, "command" the one a re-run check ran.
RAW_FIELDS = ("rerun", "command")
# Claude Code adds a SessionStart hook's output to the context only up to this
# many characters (its documented hook-output limit); `open --hook` stays under
# it and says how to read the rest.
HOOK_OUTPUT_LIMIT = 10_000
# An analyst's write-up (a researcher-subagents project): the file its results
# folder holds, the line of its reply that names the folder, and the reminder
# it is held back with, once, when it ends without that file.
WRITEUP_FILE = "writeup.md"
RESULTS_LINE_RE = re.compile(r"\A\s*Results:\s*(.*?)\s*\Z")
WRITEUP_REMINDER = (
    f"Before you finish: write your full write-up (method, results, caveats, dead ends, "
    f"surprises) to {WRITEUP_FILE} in your results folder. Then end your reply with a short "
    f"summary, your dead ends and surprises one line each, and a last line exactly "
    f"`Results: <folder>` naming that folder.")

NOTE_KINDS = ("did", "dead-end", "decision", "surprise", "correction")
# Entries that never call for a consolidation on their own: a consolidation's
# own entry (else every run would owe another), and a session's end (a second
# close, or one written while a run works, would otherwise owe a run for it).
QUIET_KINDS = ("consolidation", "session-end")
NOTHING_NEW = "nothing new since the last consolidation"
DELTA_KEYS = ("page", "through", "add", "edit", "retire", "claims", "skills")
DELTA_ITEM_KEYS = {"add": ("part", "text"), "edit": ("id", "text"),
                   "claims": ("kind", "statement", "scope", "hedge", "evidence", "relations", "topics"),
                   "skills": ("name", "description", "body")}

# The front page's parts: heading, id letter, and whether consolidation edits it.
PARTS = (
    ("inquiry", "Line of inquiry", "L", True),
    ("beliefs", "Beliefs", "B", True),
    ("inflight", "In flight", "I", False),
    ("threads", "Open threads", "T", True),
)
PART_BY_KEY = {k: (h, letter, c) for k, h, letter, c in PARTS}
CONSOLIDATED_PARTS = tuple(k for k, _h, _l, c in PARTS if c)

RELATIONS = ("supersedes", "contradicts", "withdraws", "depends-on", "answers")
CLAIM_ID_RE = re.compile(r"\A[FQR]-[1-9][0-9]*\Z")
JOURNAL_ID_RE = re.compile(r"\AJ-([1-9][0-9]*)\Z")
# The Agent Skills naming rule pi and Claude Code share: lowercase letters,
# digits and single hyphens, at most 64 characters.
SKILL_NAME_RE = re.compile(r"\A[a-z0-9]+(-[a-z0-9]+)*\Z")
SKILL_NAME_MAX = 64
SKILL_PREFIX = "earned-"
SKILL_FILE_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]*\Z")

FRONT_MARK_RE = re.compile(r"<!-- rs-memory page=(\d+) next=(\d+) -->")
ITEM_LINE_RE = re.compile(r"\A- \[([LBIT]-[1-9][0-9]*)\] (.*)\Z")


class Refused(Exception):
    """A refusal: the message names what is wrong and the next step."""


# --------------------------------------------------------------------- paths
def mem_dir() -> Path:
    return Path(os.environ.get("RS_MEMORY_DIR") or DEFAULT_DIR)


def runtime_dir() -> Path:
    # A tmpfs: an in-flight marker left by a run killed with its container is
    # gone at the next start, when nothing can be running.
    return Path(os.environ.get("RS_MEMORY_RUNTIME_DIR") or "/dev/shm")


def inflight_marker() -> Path:
    return runtime_dir() / f"rs-memory-consolidating-{os.getuid()}"


def now() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def under_guard() -> bool:
    return os.environ.get(GUARD) == "1" or under_strict_guard()


def under_strict_guard() -> bool:
    return os.environ.get(STRICT_GUARD) == "1"


def workspace() -> Path:
    """The project's workspace: the memory folder lives directly in it."""
    return mem_dir().parent


def record_path() -> Path:
    return workspace() / ".orchestrator" / "project.json"


def project_record() -> dict:
    """RS's record of this project; {} when there is none (outside a project)."""
    p = record_path()
    try:
        text = p.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {}
    except OSError as e:
        raise Refused(f"cannot read the project's record {p} ({e.strerror}), so rs-memory "
                      "cannot tell whether a finding's checks apply; tell the PI")
    try:
        data = json.loads(text)
    except (ValueError, RecursionError):
        raise Refused(f"the project's record {p} is not JSON, so rs-memory cannot tell "
                      "whether a finding's checks apply; tell the PI")
    if not isinstance(data, dict):
        raise Refused(f"the project's record {p} is not a JSON object, so rs-memory cannot "
                      "tell whether a finding's checks apply; tell the PI")
    return data


def checks_on() -> bool:
    return project_record().get(CHECKS_KEY) is True


def require_checks(what: str) -> None:
    if not checks_on():
        raise Refused(f"{what} is for researcher-subagents projects only: this project's "
                      f"record ({record_path()}) does not say \"{CHECKS_KEY}\": true")


def ensure_layout() -> Path:
    d = mem_dir()
    for sub in ("front", "journal", "staged", "record", "struck",
                "skills/candidates", "skills/active", "runs"):
        (d / sub).mkdir(parents=True, exist_ok=True)
    return d


def write_text(path: Path, text: str, mode: "int | None" = None) -> None:
    """Write through a fresh temp file and a rename, so a reader never sees a
    half file and a link at the name is replaced, never followed."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        if mode is not None:
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class Lock:
    """The memory folder's lock file (flock). `wait=False` raises BlockingIOError
    when another writer holds it."""

    def __init__(self, wait: bool = True):
        self.wait = wait
        self.fd = None

    def __enter__(self):
        d = ensure_layout()
        self.fd = os.open(str(d / ".lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o644)
        flags = fcntl.LOCK_EX | (0 if self.wait else fcntl.LOCK_NB)
        try:
            fcntl.flock(self.fd, flags)
        except BaseException:
            os.close(self.fd)
            raise
        return self

    def __exit__(self, *a):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)
        return False


# ------------------------------------------------------------------- journal
def journal_files() -> "list[tuple[int, Path]]":
    root = mem_dir() / "journal"
    out = []
    if not root.is_dir():
        return out
    for month in root.iterdir():
        if not month.is_dir():
            continue
        for f in month.glob("J-*.md"):
            m = JOURNAL_ID_RE.match(f.stem)
            if m:
                out.append((int(m.group(1)), f))
    out.sort()
    return out


def parse_entry(path: Path) -> dict:
    """An entry or claim file: a `# <id> — <headline>` line, `key: value`
    lines, a blank line, then the body. Repeated keys collect into lists."""
    text = path.read_text(encoding="utf-8")
    lines = text.split("\n")
    head = lines[0][2:] if lines and lines[0].startswith("# ") else ""
    ident, _, headline = head.partition(" — ")
    meta: dict = {"id": ident.strip(), "headline": headline.strip(), "path": path}
    i = 1
    while i < len(lines) and lines[i].strip():
        k, sep, v = lines[i].partition(": ")
        if sep:
            meta.setdefault(k.strip(), []).append(v)
        i += 1
    meta["body"] = "\n".join(lines[i + 1:]).strip()
    return meta


def one(meta: dict, key: str, default: str = "") -> str:
    v = meta.get(key)
    return v[0] if isinstance(v, list) and v else default


def render_entry(ident: str, headline: str, fields: "list[tuple[str, str]]", body: str) -> str:
    out = [f"# {ident} — {single_line(headline)}"]
    for k, v in fields:
        out.append(f"{k}: {v.strip() if k in RAW_FIELDS else single_line(v)}")
    out.append("")
    if body.strip():
        out.append(body.strip())
        out.append("")
    return "\n".join(out)


def single_line(s: str) -> str:
    return " ".join(str(s).split())


def session_label() -> str:
    agent = detect_agent(quiet=True) or "unknown"
    sid = os.environ.get("PI_SESSION_ID") or ""
    return f"{agent} {sid}".strip()


def add_journal(headline: str, kind: str, body: str = "") -> str:
    """Append one entry; the caller holds the lock. Returns its id."""
    files = journal_files()
    n = (files[-1][0] + 1) if files else 1
    ident = f"J-{n}"
    month = _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m")
    path = mem_dir() / "journal" / month / f"{ident}.md"
    write_text(path, render_entry(ident, headline, [
        ("kind", kind), ("session", session_label()), ("time", now())], body))
    return ident


def consolidated_mark() -> int:
    p = mem_dir() / "consolidated"
    try:
        m = JOURNAL_ID_RE.match(p.read_text(encoding="utf-8").strip())
    except FileNotFoundError:
        return 0
    return int(m.group(1)) if m else 0


def entries_since_mark() -> "list[tuple[int, Path]]":
    mark = consolidated_mark()
    return [(n, f) for n, f in journal_files() if n > mark]


def new_since_mark() -> "list[tuple[int, Path]]":
    """Entries since the mark that call for a consolidation: a consolidation's
    own entries and a session's end never do (QUIET_KINDS)."""
    return [(n, f) for n, f in entries_since_mark()
            if one(parse_entry(f), "kind") not in QUIET_KINDS]


# ---------------------------------------------------------------- front page
def empty_front() -> dict:
    return {"page": 0, "next": 1, "parts": {k: [] for k, *_ in PARTS}}


def read_front(p: "Path | None" = None) -> dict:
    p = p or mem_dir() / "front.md"
    try:
        text = p.read_text(encoding="utf-8")
    except FileNotFoundError:
        return empty_front()
    m = FRONT_MARK_RE.search(text)
    if not m:
        raise Refused(f"{p} has no rs-memory header line; it was not written by "
                      "rs-memory. Move it aside and run the command again.")
    front = {"page": int(m.group(1)), "next": int(m.group(2)),
             "parts": {k: [] for k, *_ in PARTS}}
    heading_to_key = {h: k for k, h, *_ in PARTS}
    cur = None
    for line in text.split("\n"):
        if line.startswith("## "):
            cur = heading_to_key.get(line[3:].strip())
            continue
        im = ITEM_LINE_RE.match(line)
        if im and cur:
            front["parts"][cur].append((im.group(1), im.group(2)))
    return front


def render_front(front: dict) -> str:
    out = ["# Front page", "",
           f"<!-- rs-memory page={front['page']} next={front['next']} -->", ""]
    for k, heading, _letter, _c in PARTS:
        out.append(f"## {heading}")
        for ident, text in front["parts"][k]:
            out.append(f"- [{ident}] {text}")
        out.append("")
    return "\n".join(out)


def new_item_id(front: dict, part: str) -> str:
    ident = f"{PART_BY_KEY[part][1]}-{front['next']}"
    front["next"] += 1
    return ident


# --------------------------------------------------------------------- claims
def claim_files() -> "dict[str, tuple[str, Path]]":
    """id -> (where, path) over staged/, record/ and struck/."""
    out = {}
    for where in ("staged", "record", "struck"):
        d = mem_dir() / where
        if d.is_dir():
            for f in d.glob("*.md"):
                if CLAIM_ID_RE.match(f.stem):
                    out[f.stem] = (where, f)
    return out


def next_claim_id(prefix: str) -> str:
    nums = [int(i[2:]) for i in claim_files() if i.startswith(prefix + "-")]
    return f"{prefix}-{max(nums) + 1 if nums else 1}"


def sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def record_entries() -> "dict[str, dict]":
    out = {}
    d = mem_dir() / "record"
    if d.is_dir():
        for f in sorted(d.glob("*.md")):
            if CLAIM_ID_RE.match(f.stem):
                out[f.stem] = parse_entry(f)
    return out


def standing(rec: "dict[str, dict]") -> "dict[str, str]":
    """Standing of every accepted entry, from the relations alone."""
    st: "dict[str, str]" = {}
    withdrawn = set()
    for e in rec.values():
        if e["id"].startswith("R-"):
            withdrawn.update(e.get("withdraws", []))
    superseded = set()
    for e in rec.values():
        if e["id"] not in withdrawn:
            superseded.update(e.get("supersedes", []))
    answered = set()
    for e in rec.values():
        if e["id"] not in withdrawn and e["id"] not in superseded:
            answered.update(e.get("answers", []))
    for ident in rec:
        if ident.startswith("R-"):
            st[ident] = "retraction"
        elif ident in withdrawn:
            st[ident] = "withdrawn"
        elif ident in superseded:
            st[ident] = "superseded"
        elif ident.startswith("Q-"):
            st[ident] = "answered" if ident in answered else "open"
        else:
            st[ident] = "current"
    live = {i for i, s in st.items() if s == "current"}
    for e in rec.values():
        a = e["id"]
        for b in e.get("contradicts", []):
            if a in live and b in live:
                st[a] = st[b] = "contested"
    return st


def undermined(rec: "dict[str, dict]", st: "dict[str, str]", ident: str) -> "list[str]":
    """The entries this one depends on that no longer stand (current, or
    contested, is standing; anything else is not)."""
    out = []
    for dep in rec.get(ident, {}).get("depends-on", []):
        if st.get(dep) not in ("current", "contested"):
            out.append(f"{dep} ({st.get(dep, 'not accepted')})")
    return out


# -------------------------------------------------------------------- agents
def detect_agent(quiet: bool = False) -> "str | None":
    claude = os.environ.get("CLAUDECODE") == "1"
    pi = bool(os.environ.get("PI_SESSION_ID"))
    if claude and pi:
        if quiet:
            return None
        raise Refused("both a Claude session (CLAUDECODE) and a pi session "
                      "(PI_SESSION_ID) are in this shell's environment; pass "
                      "--agent claude or --agent pi")
    if claude:
        return "claude"
    if pi:
        return "pi"
    if quiet:
        return None
    raise Refused("cannot tell which agent is running; pass --agent claude or --agent pi")


def skill_homes() -> "list[Path]":
    homes = [Path.home() / ".claude" / "skills"]
    pi_dir = os.environ.get("PI_CODING_AGENT_DIR")
    if pi_dir:
        homes.append(Path(pi_dir) / "skills")
    return homes


# ===================================================================== verbs
def refuse_under_guard(verb: str) -> None:
    """A consolidation run writes only through consolidate --apply: the session
    owns the journal, the In-flight part, the PI's accepts and the skills."""
    if under_strict_guard():
        raise Refused(f"a referee run does not {verb}: it writes nothing, it reads its "
                      "folder and answers")
    if under_guard():
        raise Refused(f"a consolidation run does not {verb}; write the delta and run "
                      "rs-memory consolidate --apply")


def cmd_note(a) -> None:
    refuse_under_guard("write journal entries")
    if not a.headline.strip():
        raise Refused("a note needs a headline: rs-memory note \"<what happened>\" --kind <kind>")
    if a.kind not in NOTE_KINDS:
        raise Refused(f"unknown kind {a.kind!r}; use one of: {', '.join(NOTE_KINDS)}")
    with Lock():
        ident = add_journal(a.headline, a.kind, a.body or "")
    print(f"{ident} journalled ({a.kind}).")


def cmd_checkpoint(a) -> None:
    refuse_under_guard("checkpoint")
    items = [single_line(x) for x in a.items if x.strip()]
    with Lock():
        front = read_front()
        front["parts"]["inflight"] = [(new_item_id(front, "inflight"), t) for t in items]
        write_text(mem_dir() / "front.md", render_front(front))
        ident = add_journal("checkpoint", "checkpoint",
                            "\n".join(f"- {t}" for t in items) or "(nothing in flight)")
    print(f"In flight replaced ({len(items)} item(s)); {ident} journalled.")


def _claim_prefix(a) -> str:
    if a.withdraws:
        return "R"
    return "Q" if a.question else "F"


def validate_claim(statement: str, scope: str, evidence: "list[str]",
                   relations: "dict[str, list[str]]", prefix: str,
                   known: "set[str]") -> "list[tuple[str, str]]":
    """Check a claim before any write; returns its evidence as (path, sha256)."""
    if not single_line(statement):
        raise Refused("a claim needs a statement: what you found, as a sentence that could be wrong")
    if prefix != "R" and not single_line(scope):
        raise Refused("a claim needs --scope: where the statement holds (data, period, conditions)")
    if prefix == "F" and not evidence:
        raise Refused("a finding needs --evidence: the notebook, code or output it rests on")
    out = []
    for e in evidence:
        p = Path(e)
        if not p.is_absolute():
            p = Path.cwd() / p
        if p.is_symlink() or not p.is_file():
            raise Refused(f"evidence {e!r} leads nowhere: name a file that exists "
                          "(not a folder or a link)")
        out.append((str(p), sha256_file(str(p))))
    for rel, ids in relations.items():
        for i in ids:
            if i not in known:
                raise Refused(f"--{rel} {i}: no claim {i} exists (see rs-memory view)")
    if prefix == "R" and not relations.get("withdraws"):
        raise Refused("a retraction names what it withdraws: --withdraws F-<n>")
    return out


def write_claim(prefix: str, statement: str, scope: str, hedge: str,
                evidence: "list[tuple[str, str]]", relations: "dict[str, list[str]]",
                topics: "list[str]", rerun: "tuple[str, str] | None" = None) -> str:
    ident = next_claim_id(prefix)
    fields = [("kind", {"F": "finding", "Q": "question", "R": "retraction"}[prefix]),
              ("scope", scope), ("hedge", hedge or "(none stated)"),
              ("staged", now()), ("session", session_label())]
    for path, digest in evidence:
        fields.append(("evidence", f"{path} sha256={digest}"))
    if rerun:
        fields.append(rerun)
    for rel in RELATIONS:
        for i in relations.get(rel, []):
            fields.append((rel, i))
    for t in topics:
        fields.append(("topic", t))
    write_text(mem_dir() / "staged" / f"{ident}.md",
               render_entry(ident, statement, fields, ""))
    return ident


def _relations_from(a) -> "dict[str, list[str]]":
    return {r: list(getattr(a, r.replace("-", "_")) or []) for r in RELATIONS}


def rerun_field(a) -> "tuple[str, str] | None":
    """The finding's re-run command or the reason it has none, checked."""
    if a.rerun is not None:
        cmd = a.rerun.strip()
        if not cmd:
            raise Refused("--rerun needs the command that reproduces the finding")
        if "\n" in cmd or "\r" in cmd:
            raise Refused("--rerun is one line; put a longer command in a script and "
                          "give the line that runs it")
        return ("rerun", cmd)
    if a.no_rerun is not None:
        reason = single_line(a.no_rerun)
        if not reason:
            raise Refused("--no-rerun needs the reason the finding cannot be re-run")
        return ("no-rerun", reason)
    return None


def cmd_claim(a) -> None:
    refuse_under_guard("stage claims outside its delta")
    prefix = _claim_prefix(a)
    rels = _relations_from(a)
    rerun = None
    if a.rerun is not None or a.no_rerun is not None:
        require_checks("--rerun and --no-rerun")
        if prefix != "F":
            raise Refused("only a finding has a re-run command; drop --rerun / --no-rerun")
        rerun = rerun_field(a)
    elif prefix == "F" and checks_on():
        raise Refused("a finding here needs --rerun CMD, the command that reproduces it "
                      "(it writes its outputs into the folder $RS_RERUN_OUT), or "
                      "--no-rerun REASON, why it cannot be re-run")
    with Lock():
        known = set(claim_files())
        ev = validate_claim(a.statement, a.scope or "", a.evidence or [], rels, prefix, known)
        ident = write_claim(prefix, a.statement, a.scope or "", a.hedge or "", ev,
                            rels, [single_line(t) for t in (a.topic or []) if t.strip()],
                            rerun)
    print(f"{ident} staged. It enters the record when the PI accepts it "
          f"(they say \"accept {ident}\", you run rs-memory accept {ident}).")
    if rerun:
        print(f"Before the PI can accept it, it needs its checks: "
              + (f"rs-memory rerun {ident} (the re-run) and " if rerun[0] == "rerun" else "")
              + f"rs-memory referee {ident} (the referee's verdict).")


def _evidence_changed(meta: dict) -> "str | None":
    for line in meta.get("evidence", []):
        path, _, digest = line.rpartition(" sha256=")
        try:
            now_digest = sha256_file(path)
        except OSError:
            return path
        if now_digest != digest:
            return path
    return None


def cmd_accept(a) -> None:
    refuse_under_guard("accept claims (only the PI does)")
    a.ids = list(dict.fromkeys(a.ids))
    checks = checks_on()
    if a.over_objection and not checks:
        require_checks("--over-objection")
    with Lock():
        files = claim_files()
        metas = []
        for ident in a.ids:
            where, path = files.get(ident, (None, None))
            if where != "staged":
                raise Refused(f"{ident} is not a staged claim "
                              f"({'already ' + where if where else 'no such claim'})")
            meta = parse_entry(path)
            changed = _evidence_changed(meta)
            if changed:
                raise Refused(f"{ident}: its evidence {changed} changed since it was staged; "
                              "check the finding still holds and stage it again with rs-memory claim")
            # A finding's two checks, in a project that has them.
            extra = accept_checks(ident, meta, a.over_objection) \
                if checks and ident.startswith("F-") else None
            metas.append((ident, path, extra))
        stamp = now()
        objected = []
        for ident, path, extra in metas:
            dest = mem_dir() / "record" / f"{ident}.md"
            os.replace(path, dest)                      # a move: the staged file IS the record
            text = dest.read_text(encoding="utf-8")
            head, sep, rest = text.partition("\n\n")
            if extra is None:
                write_text(dest, f"{head}\naccepted: {stamp}{sep or chr(10)}{rest}", mode=0o444)
                continue
            fields, objection = extra
            head = head.rstrip("\n") + f"\naccepted: {stamp}" + "".join(
                f"\n{k}: {single_line(v)}" for k, v in fields)
            body = "\n\n".join(x for x in (rest.strip(), objection.strip()) if x)
            write_text(dest, head + "\n" + (f"\n{body}\n" if body else ""), mode=0o444)
            if objection.strip():
                objected.append(ident)
        j = add_journal("accepted " + " ".join(i for i, _p, _e in metas), "accept",
                        ("over the referee's objection: " + " ".join(objected)) if objected else "")
    print(f"Accepted into the record: {' '.join(i for i, _p, _e in metas)} ({j}).")
    if objected:
        print(f"Accepted over the referee's objection, which stays on the entry: {' '.join(objected)}.")


def cmd_strike(a) -> None:
    refuse_under_guard("strike claims (only the PI does)")
    a.ids = list(dict.fromkeys(a.ids))
    if not single_line(a.reason or ""):
        raise Refused("strike needs --reason: why the PI dropped it")
    with Lock():
        files = claim_files()
        for ident in a.ids:
            if files.get(ident, (None,))[0] != "staged":
                raise Refused(f"{ident} is not a staged claim")
        for ident in a.ids:
            os.replace(files[ident][1], mem_dir() / "struck" / f"{ident}.md")
        j = add_journal("struck " + " ".join(a.ids), "strike", a.reason)
    print(f"Struck: {' '.join(a.ids)} ({j}).")


# -------------------------------------------------------------------- checks
# A finding's two checks, in a researcher-subagents project only: a re-run of
# its stated command, and a referee's verdict on its claim and evidence. Each
# check is a folder checks/<id>/<n>/ of its own, never deleted: check.md
# (what was started, bound to the claim's and evidence's hashes), pid, a log,
# and the record the run leaves when it ends (rerun.md or verdict.md).
def claim_sha(meta: dict) -> str:
    """The claim as the PI reads it: statement, scope and hedge."""
    text = json.dumps([meta["headline"], one(meta, "scope"), one(meta, "hedge")],
                      ensure_ascii=False)
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def staged_evidence(meta: dict) -> "list[tuple[str, str]]":
    out = []
    for line in meta.get("evidence", []):
        path, _, digest = line.rpartition(" sha256=")
        out.append((path, digest))
    return out


def binding_fields(meta: dict) -> "list[tuple[str, str]]":
    return [("claim-sha256", claim_sha(meta))] + [
        ("evidence", f"{p} sha256={d}") for p, d in staged_evidence(meta)]


def bound_to(info: dict, meta: dict) -> bool:
    """Whether a check was made on the claim and evidence as staged now."""
    return (one(info, "claim-sha256") == claim_sha(meta)
            and info.get("evidence", []) == meta.get("evidence", []))


def staged_finding(ident: str) -> "tuple[Path, dict]":
    where, path = claim_files().get(ident, (None, None))
    if where != "staged":
        raise Refused(f"{ident} is not a staged claim "
                      f"({'already ' + where if where else 'no such claim'})")
    if not ident.startswith("F-"):
        raise Refused(f"{ident} is not a finding; only findings (F-) have checks")
    return path, parse_entry(path)


def refuse_changed(ident: str, meta: dict) -> None:
    changed = _evidence_changed(meta)
    if changed:
        raise Refused(f"{ident}: its evidence {changed} changed since it was staged, which voids "
                      "its checks; check the finding still holds and stage it again with "
                      "rs-memory claim")


def checks_dir(ident: str) -> Path:
    return mem_dir() / "checks" / ident


def new_check(ident: str, kind: str, fields: "list[tuple[str, str]]") -> "tuple[int, Path]":
    """A fresh numbered folder for one check; the caller holds the lock."""
    root = checks_dir(ident)
    root.mkdir(parents=True, exist_ok=True)
    nums = [int(p.name) for p in root.iterdir() if p.is_dir() and p.name.isdigit()]
    n = max(nums, default=0) + 1
    d = root / str(n)
    d.mkdir()
    write_text(d / "check.md", render_entry(f"{ident} check {n}", kind,
                                            [("kind", kind), ("started", now())] + fields, ""))
    return n, d


def child_verb(kind: str) -> str:
    return "_rerun" if kind == "rerun" else "_referee"


def check_live(d: Path, kind: str, ident: str, n: int) -> bool:
    try:
        pid = int((d / "pid").read_text().strip())
        cmd = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (OSError, ValueError):
        return False
    return f"\0{child_verb(kind)}\0{ident}\0{n}\0".encode() in cmd


def start_check(ident: str, n: int, d: Path, kind: str, log_name: str) -> Path:
    """Start the check's run detached, in a session of its own (as close
    starts a consolidation), and note its pid."""
    log = d / log_name
    fd = os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o644)
    me = os.path.realpath(sys.argv[0])
    try:
        child = subprocess.Popen([sys.executable, me, child_verb(kind), ident, str(n)],
                                 stdin=subprocess.DEVNULL, stdout=fd, stderr=fd,
                                 start_new_session=True, close_fds=True)
    finally:
        os.close(fd)
    write_text(d / "pid", f"{child.pid}\n")
    return log


def check_list(ident: str) -> "list[dict]":
    """Every check of a claim, oldest first, with its state: done (its record
    is written), running, or failed (it ended without a record)."""
    root = checks_dir(ident)
    if not root.is_dir():
        return []
    out = []
    for n in sorted(int(p.name) for p in root.iterdir() if p.is_dir() and p.name.isdigit()):
        d = root / str(n)
        try:
            info = parse_entry(d / "check.md")
        except FileNotFoundError:
            continue
        kind = one(info, "kind")
        rec_file = d / ("rerun.md" if kind == "rerun" else "verdict.md")
        rec = parse_entry(rec_file) if rec_file.is_file() else None
        if rec is not None:
            state = "done"
        elif check_live(d, kind, ident, n):
            state = "running"
        else:
            state = "failed"
        out.append({"n": n, "dir": d, "kind": kind, "info": info, "rec": rec, "state": state,
                    "log": d / ("rerun.log" if kind == "rerun" else "referee.log")})
    return out


def accepted_record_text() -> str:
    """The accepted record as a referee reads it: every entry, with its standing."""
    rec = record_entries()
    st = standing(rec)
    out = ["# The project's accepted record", ""]
    if not rec:
        out.append("(nothing accepted yet)")
    for ident, e in rec.items():
        out.append(e["path"].read_text(encoding="utf-8").rstrip())
        out.append(f"standing: {st[ident]}")
        out.append("")
    return "\n".join(out).rstrip() + "\n"


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


# --------------------------------------------------- checks: state and accept
def finding_checks(ident: str, meta: dict) -> dict:
    """What a staged finding's checks say now."""
    cs = check_list(ident)
    cmd = one(meta, "rerun")
    reruns = [c for c in cs if c["kind"] == "rerun"]
    refs = [c for c in cs if c["kind"] == "referee"]
    cur_rerun = [c for c in reruns if c["state"] == "done" and bound_to(c["info"], meta)
                 and one(c["info"], "command") == cmd and cmd]
    cur_verdicts = [c for c in refs if c["state"] == "done" and bound_to(c["info"], meta)
                    and one(c["rec"], "verdict") in VERDICTS]
    return {"reruns": reruns, "refs": refs, "cur_rerun": cur_rerun,
            "cur_verdicts": cur_verdicts, "command": cmd, "reason": one(meta, "no-rerun"),
            "changed": _evidence_changed(meta)}


def rerun_summary(c: dict) -> str:
    rec = c["rec"]
    files = []
    for line in rec.get("compare", []):
        path, _, result = line.rpartition(" -> ")
        files.append(f"{Path(path).name} {result}")
    return (f"check {c['n']}: exit {one(rec, 'exit')}"
            + (f"; {', '.join(files)}" if files else ""))


def verdict_summary(c: dict) -> str:
    rec = c["rec"]
    v = one(rec, "verdict")
    out = f"check {c['n']}: {v} ({one(rec, 'model')})"
    if one(rec, "narrower"):
        out += f"; narrower claim: {one(rec, 'narrower')}"
    if one(rec, "accepted-sha256") != sha256_text(accepted_record_text()):
        out += "; the record changed since this verdict"
    return out


def rerun_state_lines(fc: dict) -> "list[str]":
    if fc["changed"]:
        return [f"void: its evidence {fc['changed']} changed since it was staged"]
    out = []
    if fc["reason"]:
        out.append(f"none: {fc['reason']}")
    for c in fc["reruns"]:
        if c["state"] == "running":
            out.append(f"check {c['n']}: running since {one(c['info'], 'started')}; "
                       f"its log is {c['log']}")
    if fc["cur_rerun"]:
        out.append(rerun_summary(fc["cur_rerun"][-1]))
    last = fc["reruns"][-1] if fc["reruns"] else None
    if last and last["state"] == "failed":
        out.append(f"check {last['n']} failed: it ended without a record; its log is {last['log']}")
    if not out:
        if not fc["command"]:
            out.append("not run: no re-run command and no reason "
                       "(rs-memory rerun-command)")
        elif fc["reruns"]:
            out.append("not run for its current command")
        else:
            out.append("not run")
    return out


def referee_state_lines(fc: dict) -> "list[str]":
    if fc["changed"]:
        return [f"void: its evidence {fc['changed']} changed since it was staged"]
    out = []
    for c in fc["refs"]:
        if c["state"] == "running":
            out.append(f"check {c['n']}: running since {one(c['info'], 'started')}; "
                       f"its log is {c['log']}")
    out += [verdict_summary(c) for c in fc["cur_verdicts"]]
    last = fc["refs"][-1] if fc["refs"] else None
    if last and last["state"] == "failed":
        out.append(f"check {last['n']} failed: it ended without a record; its log is {last['log']}")
    elif last and last["state"] == "done" and one(last["rec"], "verdict") not in VERDICTS:
        out.append(f"check {last['n']} gave no verdict: {one(last['rec'], 'failed')}; "
                   f"its log is {last['log']}")
    if not out:
        out.append("void: the claim changed since its verdict" if fc["refs"] else "not run")
    return out


def check_lines(ident: str, meta: dict, indent: str) -> "list[str]":
    fc = finding_checks(ident, meta)
    out = []
    for label, lines in (("re-run", rerun_state_lines(fc)), ("referee", referee_state_lines(fc))):
        for line in lines:
            out.append(f"{indent}{label}: {line}")
    return out


def accept_checks(ident: str, meta: dict, over: bool) -> "tuple[list, str]":
    """Refuse a finding whose checks are missing or object (without the PI's
    --over-objection); else the fields and body its record entry gets."""
    fc = finding_checks(ident, meta)
    missing = []
    if not fc["cur_verdicts"]:
        missing.append(f"no current referee verdict (none on the claim and evidence as staged; "
                       f"run rs-memory referee {ident})")
    if not fc["cur_rerun"] and not fc["reason"]:
        missing.append(f"no re-run record for its command and no reason it cannot be re-run "
                       + (f"(run rs-memory rerun {ident})" if fc["command"] else
                          f"(give one with rs-memory rerun-command {ident} --rerun CMD "
                          "or --no-rerun REASON)"))
    if missing:
        raise Refused(f"{ident} cannot be accepted yet: " + "; ".join(missing))
    objections = [c for c in fc["cur_verdicts"] if one(c["rec"], "verdict") in OBJECTIONS]
    if objections and not over:
        raise Refused(f"{ident}: the referee objects ("
                      + "; ".join(verdict_summary(c) for c in objections)
                      + "). Accept it over the objection only when the PI says so: "
                      f"rs-memory accept {ident} --over-objection")
    fields = [("referee", verdict_summary(c) + f" [{c['dir'] / 'verdict.md'}]")
              for c in fc["cur_verdicts"]]
    if fc["cur_rerun"]:
        c = fc["cur_rerun"][-1]
        fields.append(("rerun-check", rerun_summary(c) + f" [{c['dir'] / 'rerun.md'}]"))
    body = []
    for c in objections:
        fields.append(("objection", f"check {c['n']}: {one(c['rec'], 'verdict')}"))
        body.append(f"Accepted over the referee's objection (check {c['n']}, "
                    f"{one(c['rec'], 'verdict')}, {one(c['rec'], 'model')}):")
        body.append(c["rec"]["body"].strip())       # the narrower claim and the findings
        body.append("")
    return fields, "\n".join(body)


# ------------------------------------------------------------ checks: verbs
def cmd_rerun_command(a) -> None:
    refuse_under_guard("attach a re-run command")
    require_checks("rerun-command")
    field = rerun_field(a)
    with Lock():
        path, _meta = staged_finding(a.id)
        text = path.read_text(encoding="utf-8")
        head, sep, rest = text.partition("\n\n")
        lines = [l for l in head.split("\n") if not l.startswith(("rerun: ", "no-rerun: "))]
        ev = [i for i, l in enumerate(lines) if l.startswith("evidence: ")]
        at = (ev[-1] + 1) if ev else len(lines)
        lines.insert(at, f"{field[0]}: {field[1]}")
        write_text(path, "\n".join(lines) + (sep + rest if sep else "\n"))
    if field[0] == "rerun":
        print(f"{a.id}: re-run command set; run it with rs-memory rerun {a.id}.")
    else:
        print(f"{a.id}: no re-run; the reason is recorded for the PI.")


def cmd_rerun(a) -> None:
    refuse_under_guard("start a re-run")
    require_checks("rerun")
    with Lock():
        _path, meta = staged_finding(a.id)
        refuse_changed(a.id, meta)
        cmd = one(meta, "rerun")
        if not cmd:
            raise Refused(f"{a.id} has no re-run command; give one with "
                          f"rs-memory rerun-command {a.id} --rerun CMD")
        n, d = new_check(a.id, "rerun", [("command", cmd)] + binding_fields(meta))
        (d / "rerun").mkdir()
        log = start_check(a.id, n, d, "rerun", "rerun.log")
    print(f"Re-run of {a.id} started in the background (check {n}), writing into "
          f"{d / 'rerun'}; its log is {log}. Its result shows in rs-memory view {a.id}.")


def run_rerun(ident: str, n: int) -> int:
    """The detached re-run: the command in the workspace, then its record."""
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    d = checks_dir(ident) / str(n)
    info = parse_entry(d / "check.md")
    cmd = one(info, "command")
    out_dir = d / "rerun"
    env = {k: v for k, v in os.environ.items() if k not in SESSION_VARS}
    env["RS_RERUN_OUT"] = str(out_dir)
    print(f"command: {cmd}\nRS_RERUN_OUT={out_dir}", flush=True)
    try:
        rc = str(subprocess.run(["bash", "-c", cmd], cwd=str(workspace()), env=env,
                                stdin=subprocess.DEVNULL).returncode)
    except OSError as e:
        rc = f"none (could not start bash: {e.strerror})"
    print(f"exit: {rc}", flush=True)
    compare = []
    for path, digest in staged_evidence(info):
        f = out_dir / Path(path).name
        if f.is_symlink() or not f.is_file():
            result = "not produced"
        else:
            result = "same" if sha256_file(str(f)) == digest else "differs"
        compare.append(("compare", f"{path} -> {result}"))
    fields = ([("kind", "rerun"), ("command", cmd), ("exit", rc), ("started", one(info, "started")),
               ("ended", now()), ("out", str(out_dir)), ("log", str(d / "rerun.log"))]
              + [(k, v) for k in ("claim-sha256", "evidence") for v in info.get(k, [])] + compare)
    write_text(d / "rerun.md", render_entry(f"{ident} re-run {n}", f"exit {rc}", fields, ""))
    return 0


def referee_model(agent: str) -> "list[str]":
    """The model flags for the referee, from the project's record; no model
    recorded is an error, never a fallback to the agent's default."""
    data = project_record()
    if agent == "claude":
        models = data.get("models") if isinstance(data.get("models"), dict) else {}
        pair = models.get("referee")
        m = pair.get("model") if isinstance(pair, dict) else None
        if not isinstance(m, str) or not m.strip():
            raise Refused("no referee model is set for this project: its record "
                          f"({record_path()}) has no models.referee model for Claude; the PI "
                          "sets it in the project's settings")
        e = pair.get("effort") or ""
        if not isinstance(e, str):
            raise Refused(f"the referee's effort in {record_path()} is not text: {e!r}")
        return ["--model", m.strip()] + (["--effort", e.strip()] if e.strip() else [])
    blk = data.get("pi_models") if isinstance(data.get("pi_models"), dict) else {}
    pair = blk.get("agent")
    m = pair.get("model") if isinstance(pair, dict) else None
    if not isinstance(m, str) or not m.strip():
        raise Refused("no referee model is set for this project: its record "
                      f"({record_path()}) has no pi model (pi_models.agent.model); the PI "
                      "sets pi's model in the project's settings")
    t = pair.get("thinking") or ""
    if not isinstance(t, str):
        raise Refused(f"pi's thinking level in {record_path()} is not text: {t!r}")
    return ["--model", m.strip()] + (["--thinking", t.strip()] if t.strip() else [])


def referee_argv(agent: str, prompt: str, model_flags: "list[str]") -> "list[str]":
    """The lean headless run: no RS text, no memory rules, no front page, no
    session kept, read-only tools; the model passed explicitly."""
    if agent == "claude":
        return ["claude", "-p", prompt, "--restricted", "--tools", CLAUDE_REFEREE_TOOLS,
                "--system-prompt", REFEREE_SYSTEM, "--no-session-persistence",
                "--strict-mcp-config", "--disable-slash-commands", "--output-format", "json",
                *model_flags]
    return ["pi", "-p", prompt, "-ne", "-ns", "-nc", "-np", "--no-mcp", "--offline",
            "--no-session", "--tools", PI_REFEREE_TOOLS, "--system-prompt", REFEREE_SYSTEM,
            "--mode", "json", *model_flags]


def copy_hashed(src: str, dest: Path) -> str:
    """Copy a file through a temp file and a rename, read-only; returns the
    sha256 of the bytes copied."""
    h = hashlib.sha256()
    fd, tmp = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
    try:
        with open(src, "rb") as fi, os.fdopen(fd, "wb") as fo:
            for chunk in iter(lambda: fi.read(1 << 20), b""):
                h.update(chunk)
                fo.write(chunk)
        os.chmod(tmp, 0o444)
        os.replace(tmp, dest)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return h.hexdigest()


def claim_text(ident: str, meta: dict, names: "list[str]") -> str:
    out = [f"# Claim {ident} (staged, waiting for the PI)", "",
           f"Statement: {meta['headline']}", f"Scope: {one(meta, 'scope')}",
           f"Hedge: {one(meta, 'hedge')}", ""]
    rels = [f"- {rel} {i}" for rel in RELATIONS for i in meta.get(rel, [])]
    if rels:
        out += ["Relations to other claims:"] + rels + [""]
    out.append("Evidence (a copy of each file is in this folder):")
    for (path, digest), name in zip(staged_evidence(meta), names):
        out.append(f"- {name}: the author's {path} (sha256 {digest})")
    if one(meta, "rerun"):
        out += ["", f"The command the author says reproduces it: {one(meta, 'rerun')}"]
    elif one(meta, "no-rerun"):
        out += ["", f"Why the author says it cannot be re-run: {one(meta, 'no-rerun')}"]
    return "\n".join(out) + "\n"


def cmd_referee(a) -> None:
    refuse_under_guard("start a referee run")
    require_checks("referee")
    agent = a.agent or detect_agent()
    model_flags = referee_model(agent)
    try:
        instruction = REFEREE_FILE.read_text(encoding="utf-8")
    except OSError as e:
        raise Refused(f"the referee's instruction {REFEREE_FILE} cannot be read ({e.strerror}); "
                      "this project's image predates the referee: tell the PI")
    with Lock():
        _path, meta = staged_finding(a.id)
        refuse_changed(a.id, meta)
        fc = finding_checks(a.id, meta)
        rerun = fc["reruns"][-1] if fc["reruns"] and fc["reruns"][-1]["state"] == "done" else None
        accepted = accepted_record_text()
        n, d = new_check(a.id, "referee", [("agent", agent), ("model-flags", json.dumps(model_flags))]
                         + binding_fields(meta)
                         + [("accepted-sha256", sha256_text(accepted)),
                            ("rerun-check", str(rerun["n"]) if rerun else "none")])
        snap = d / "snapshot"
        (snap / "evidence").mkdir(parents=True)
        names = [f"evidence/{i}-{Path(p).name}" for i, (p, _d) in
                 enumerate(staged_evidence(meta), 1)]
        manifest = {}
        for (path, digest), name in zip(staged_evidence(meta), names):
            got = copy_hashed(path, snap / name)
            if got != digest:
                write_verdict(a.id, n, None, f"its evidence {path} changed while the snapshot "
                              "was taken", {}, "")
                raise Refused(f"{a.id}: its evidence {path} changed while its snapshot was "
                              "taken; check the finding still holds and stage it again")
            manifest[name] = got
        texts = {"claim.md": claim_text(a.id, meta, names), "accepted.md": accepted,
                 "REFEREE.md": instruction.replace("{folder}", str(snap))}
        if rerun:
            texts["rerun.md"] = (rerun["dir"] / "rerun.md").read_text(encoding="utf-8")
        for name, text in texts.items():
            write_text(snap / name, text, mode=0o444)
            manifest[name] = sha256_text(text)
        write_text(snap / "MANIFEST.sha256",
                   "".join(f"{h}  {name}\n" for name, h in sorted(manifest.items())), mode=0o444)
        log = start_check(a.id, n, d, "referee", "referee.log")
    print(f"Referee of {a.id} started in the background (check {n}, {agent} "
          f"{' '.join(model_flags)}), reading only {snap}; its log is {log}. "
          f"Its verdict lands in {d / 'verdict.md'} and shows in rs-memory view {a.id}.")


def parse_claude_output(text: str) -> dict:
    try:
        d = json.loads(text)
    except (ValueError, RecursionError):
        return {"error": "its output is not the JSON record Claude writes"}
    if not isinstance(d, dict) or d.get("type") != "result":
        return {"error": "its output has no result record"}
    usage = d.get("usage") if isinstance(d.get("usage"), dict) else {}
    out = {"models": sorted(d.get("modelUsage") or {}) if isinstance(d.get("modelUsage"), dict) else [],
           "cost": d.get("total_cost_usd"),
           "usage": ", ".join(f"{k.replace('_input_tokens', '').replace('_tokens', '')} {usage[k]}"
                              for k in ("input_tokens", "output_tokens", "cache_read_input_tokens",
                                        "cache_creation_input_tokens") if k in usage)}
    if d.get("is_error") or not isinstance(d.get("result"), str):
        out["error"] = f"the run failed ({d.get('terminal_reason')}): {single_line(str(d.get('result')))}"
        return out
    out["answer"] = d["result"]
    return out


def parse_pi_output(text: str) -> dict:
    last = None
    totals = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
    cost = 0.0
    for line in text.splitlines():
        try:
            d = json.loads(line)
        except (ValueError, RecursionError):
            continue
        msg = d.get("message") if isinstance(d, dict) and d.get("type") == "message_end" else None
        if not isinstance(msg, dict) or msg.get("role") != "assistant":
            continue
        last = msg
        u = msg.get("usage") if isinstance(msg.get("usage"), dict) else {}
        for k in totals:
            if isinstance(u.get(k), int):
                totals[k] += u[k]
        c = u.get("cost") if isinstance(u.get("cost"), dict) else {}
        if isinstance(c.get("total"), (int, float)):
            cost += c["total"]
    if last is None:
        return {"error": "pi's output has no answer from the model"}
    out = {"models": [f"{last.get('provider')}/{last.get('model')}"], "cost": cost,
           "usage": ", ".join(f"{k} {v}" for k, v in totals.items())}
    if last.get("stopReason") in ("error", "aborted"):
        out["error"] = f"the run failed ({last.get('stopReason')}): {single_line(str(last.get('errorMessage')))}"
        return out
    content = last.get("content")
    out["answer"] = "".join(b.get("text", "") for b in content if isinstance(b, dict)
                            and b.get("type") == "text") if isinstance(content, list) else ""
    return out


def parse_verdict(answer: str) -> dict:
    """The verdict is the answer's last line, exactly; anything else is none."""
    lines = answer.rstrip().split("\n")
    m = VERDICT_RE.match(lines[-1].strip()) if lines else None
    if not m:
        return {"error": "its last line is not VERDICT: supported, overreaches or unsupported"}
    verdict = m.group(1)
    body = "\n".join(lines[:-1]).strip()
    findings, mark, narrower = body.partition(NARROWER_MARK)
    if mark:
        findings = findings.rstrip()
        # The marker's own line may carry a list number ("2.") before it.
        findings = re.sub(r"\n\W*\d*\W*\Z", "", findings).rstrip()
    narrower = single_line(narrower) if mark else ""
    if verdict == "overreaches" and not narrower:
        return {"error": f"an overreaches verdict without its narrower claim ({NARROWER_MARK})"}
    return {"verdict": verdict, "narrower": narrower if verdict == "overreaches" else "",
            "findings": findings.strip()}


def write_verdict(ident: str, n: int, result: "dict | None", failed: str, run: dict,
                  answer: str) -> None:
    d = checks_dir(ident) / str(n)
    info = parse_entry(d / "check.md")
    verdict = result["verdict"] if result else "none"
    fields = [("kind", "referee"), ("verdict", verdict)]
    if result and result["narrower"]:
        fields.append(("narrower", result["narrower"]))
    if failed:
        fields.append(("failed", failed))
    fields += [("agent", one(info, "agent")), ("asked", " ".join(json.loads(one(info, "model-flags") or "[]"))),
               ("model", ", ".join(run.get("models") or []) or "(not reported)"),
               ("cost-usd", str(run.get("cost")) if run.get("cost") is not None else "(not reported)"),
               ("usage", run.get("usage") or "(not reported)"),
               ("started", one(info, "started")), ("ended", now())]
    fields += [(k, v) for k in ("claim-sha256", "evidence", "accepted-sha256", "rerun-check")
               for v in info.get(k, [])]
    fields += [("snapshot", str(d / "snapshot")), ("output", str(d / "referee.out")),
               ("log", str(d / "referee.log"))]
    body = ""
    if result:
        body = (f"{NARROWER_MARK} {result['narrower']}\n\n" if result["narrower"] else "") \
            + "Findings:\n" + result["findings"].removeprefix("Findings:").strip()
    elif answer.strip():
        body = "The referee's answer, which gave no verdict:\n\n" + answer.strip()
    write_text(d / "verdict.md", render_entry(f"{ident} referee {n}",
                                              verdict if result else "no verdict", fields, body))


def run_referee(ident: str, n: int) -> int:
    """The detached referee: the lean agent run in the snapshot folder, its
    answer parsed, the verdict written."""
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    d = checks_dir(ident) / str(n)
    info = parse_entry(d / "check.md")
    agent = one(info, "agent")
    snap = d / "snapshot"
    prompt = (f"Read the file {snap / 'REFEREE.md'} and do exactly what it says. "
              "It is the whole task.")
    argv = referee_argv(agent, prompt, json.loads(one(info, "model-flags")))
    env = {k: v for k, v in os.environ.items() if k not in SESSION_VARS}
    env[GUARD] = "1"
    env[STRICT_GUARD] = "1"
    print("agent: " + " ".join(a if a not in (prompt, REFEREE_SYSTEM) else repr(a) for a in argv),
          flush=True)
    out_path = d / "referee.out"
    try:
        fd = os.open(str(out_path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
        with os.fdopen(fd, "wb") as out:
            rc = subprocess.run(argv, cwd=str(snap), env=env, stdin=subprocess.DEVNULL,
                                stdout=out).returncode
    except OSError as e:
        write_verdict(ident, n, None, f"could not start {argv[0]}: {e.strerror}", {}, "")
        print(f"result: no verdict (could not start {argv[0]})", flush=True)
        return 1
    print(f"agent exit: {rc}", flush=True)
    text = out_path.read_text(encoding="utf-8", errors="replace")
    run = parse_claude_output(text) if agent == "claude" else parse_pi_output(text)
    if "error" not in run and rc != 0:
        run["error"] = f"the agent exited {rc}"
    if "error" in run:
        write_verdict(ident, n, None, run["error"], run, run.get("answer", ""))
        print(f"result: no verdict ({run['error']})", flush=True)
        return 1
    result = parse_verdict(run["answer"])
    if "error" in result:
        write_verdict(ident, n, None, result["error"], run, run["answer"])
        print(f"result: no verdict ({result['error']})", flush=True)
        return 1
    write_verdict(ident, n, result, "", run, run["answer"])
    print(f"result: {result['verdict']}", flush=True)
    return 0


def cmd_check_child(a) -> None:
    refuse_under_guard("run a check")

def build_brief(delta_path: str) -> "tuple[str, int, str]":
    front = read_front()
    since = entries_since_mark()
    if not new_since_mark():
        raise Refused(NOTHING_NEW)
    through = f"J-{since[-1][0]}"
    head = (COMPANION_BRIEF_HEAD if companion_on() else BRIEF_HEAD).format(
        delta=delta_path, page=front["page"], through=through)
    body = ["", "=" * 70, f"THE FRONT PAGE (page {front['page']})", "=" * 70, "",
            render_front(front), "", "=" * 70,
            f"JOURNAL ENTRIES SINCE THE LAST CONSOLIDATION (through {through})", "=" * 70, ""]
    for _n, f in since:
        body.append(f.read_text(encoding="utf-8").rstrip())
        body.append("")
    body += ["=" * 70, "STATE OF KNOWLEDGE (accepted record; for pointers)", "=" * 70, "",
             knowledge_text(), ""]
    return head + "\n".join(body), front["page"], through


def cmd_consolidate(a) -> None:
    if under_strict_guard():
        raise Refused("a referee run does not consolidate: it writes nothing, it reads its "
                      "folder and answers")
    if a.prompt:
        delta = (str(Path(a.out).with_suffix("")) + ".delta.json" if a.out
                 else "<a file of your choice under /workspace/memory/runs/>")
        with Lock():
            text, _page, _through = build_brief(delta)
        if a.out:
            write_text(Path(a.out), text)
            print(f"brief written to {a.out}; the delta goes to {delta}")
        else:
            sys.stdout.write(text)
        return
    apply_delta(Path(a.apply))


def _as_list(v, what: str) -> list:
    if v is None:
        return []
    if not isinstance(v, list):
        raise Refused(f"delta: {what} must be a list")
    return v


def apply_delta(path: Path) -> None:
    try:
        delta = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, RecursionError) as e:
        raise Refused(f"delta {path}: cannot read it as JSON ({type(e).__name__})")
    if not isinstance(delta, dict):
        raise Refused("delta: must be a JSON object")
    unknown = sorted(k for k in delta if k not in DELTA_KEYS)
    if unknown:
        raise Refused(f"delta: unknown key(s) {', '.join(unknown)}; the keys are "
                      f"{', '.join(DELTA_KEYS)}")
    for key, allowed in DELTA_ITEM_KEYS.items():
        for item in _as_list(delta.get(key), key):
            if not isinstance(item, dict):
                raise Refused(f"delta: each entry of {key} is an object")
            bad = sorted(k for k in item if k not in allowed)
            if bad:
                raise Refused(f"delta: {key} entry has unknown key(s) {', '.join(bad)}; "
                              f"its keys are {', '.join(allowed)}")
    if type(delta.get("page")) is not int:
        raise Refused("delta: page is the front page's number as written in the brief")
    for key, fields in (("add", ("part", "text")), ("edit", ("text",)),
                        ("claims", ("kind", "title", "statement", "scope", "hedge")),
                        ("skills", ("name", "description", "body"))):
        for item in _as_list(delta.get(key), key):
            for f in fields:
                if f in item and not isinstance(item[f], str):
                    raise Refused(f"delta: {key} entry's {f} is text, not {item[f]!r}")
    for ident in _as_list(delta.get("retire"), "retire") + [
            e.get("id") for e in _as_list(delta.get("edit"), "edit")]:
        if not isinstance(ident, str):
            raise Refused(f"delta: an item id is a string such as \"B-3\", not {ident!r}")
    parts_def = front_parts()
    consolidated = consolidated_parts(parts_def)
    if parts_def is COMPANION_PARTS and _as_list(delta.get("claims"), "claims"):
        raise Refused("delta: a companion's consolidation proposes no claims: the agent stages "
                      "a claim only when the PI asks for one. Drop \"claims\" from the delta "
                      "and apply it again")
    with Lock():
        front = read_front()
        if delta.get("page") != front["page"]:
            raise Refused(f"delta built from front page {delta.get('page')!r}, but the page is now "
                          f"{front['page']}: it moved on; the next consolidation covers these entries")
        m = JOURNAL_ID_RE.match(str(delta.get("through", "")))
        ids = {n for n, _f in journal_files()}
        if not m or int(m.group(1)) not in ids:
            raise Refused(f"delta: through {delta.get('through')!r} is not a journal entry")
        through = int(m.group(1))
        if through <= consolidated_mark():
            raise Refused(f"delta: {delta.get('through')} is already consolidated")
        parts = {k: list(v) for k, v in front["parts"].items()}
        index = {ident: k for k, items in parts.items() for ident, _t in items}
        for e in _as_list(delta.get("edit"), "edit"):
            ident = e.get("id") if isinstance(e, dict) else None
            text = single_line(e.get("text", "")) if isinstance(e, dict) else ""
            if ident not in index:
                raise Refused(f"delta: edit names {ident!r}, which is not on the front page")
            if index[ident] not in consolidated:
                raise Refused(f"delta: {ident} is in In flight, which consolidation never changes")
            if not text:
                raise Refused(f"delta: edit of {ident} has no text (retire it instead)")
            k = index[ident]
            parts[k] = [(i, text if i == ident else t) for i, t in parts[k]]
        for ident in _as_list(delta.get("retire"), "retire"):
            if ident not in index:
                raise Refused(f"delta: retire names {ident!r}, which is not on the front page")
            if index[ident] not in consolidated:
                raise Refused(f"delta: {ident} is in In flight, which consolidation never changes")
            k = index[ident]
            parts[k] = [(i, t) for i, t in parts[k] if i != ident]
        changes = any(_as_list(delta.get(k), k) for k in ("add", "edit", "retire", "claims", "skills"))
        if not changes:
            # Nothing to change: the entries are covered, the page stays.
            write_text(mem_dir() / "consolidated", f"J-{through}\n")
            j = add_journal(f"consolidated through J-{through}; front page {front['page']} unchanged",
                            "consolidation")
            print(f"Nothing to change; consolidated through J-{through} ({j}).")
            return
        new_front = {"page": front["page"] + 1, "next": front["next"], "parts": parts}
        for e in _as_list(delta.get("add"), "add"):
            part = e.get("part") if isinstance(e, dict) else None
            text = single_line(e.get("text", "")) if isinstance(e, dict) else ""
            if part not in consolidated:
                raise Refused(f"delta: add to {part!r}: use one of {', '.join(consolidated)}")
            if not text:
                raise Refused("delta: an added item has no text")
            parts[part].append((new_item_id(new_front, part), text))
        for k in consolidated:
            if front["parts"][k] and not parts[k]:
                raise Refused(f"delta: it would empty \"{part_by_key(parts_def)[k][0]}\"; keep at least one item")
        # Claims and skills are validated in full before anything is written.
        known = set(claim_files())
        staged_claims = []
        for c in _as_list(delta.get("claims"), "claims"):
            if not isinstance(c, dict):
                raise Refused("delta: each claim is an object")
            prefix = {"finding": "F", "fact": "D", "question": "Q"}.get(c.get("kind"))
            if prefix is None:
                raise Refused("delta: a claim's kind is finding, fact or question")
            rels = c.get("relations") or {}
            if not isinstance(rels, dict) or any(r not in RELATIONS or r == "withdraws" for r in rels):
                raise Refused(f"delta: claim relations are among "
                              f"{', '.join(r for r in RELATIONS if r != 'withdraws')}")
            rels = {r: [str(i) for i in _as_list(v, 'relations')] for r, v in rels.items()}
            ev = validate_claim(str(c.get("statement", "")), str(c.get("scope", "")),
                                [str(x) for x in _as_list(c.get("evidence"), "evidence")],
                                rels, prefix, known)
            topics = _as_list(c.get("topics"), "topics")
            if any(not isinstance(t, str) for t in topics):
                raise Refused("delta: a claim's topics are text")
            title = single_line(c.get("title") or "")
            if not title:
                raise Refused("delta: a claim needs its title, a few words naming the result "
                              "(the pages the PI reads list claims by it)")
            staged_claims.append((prefix, title, c, ev, rels,
                                  [single_line(t) for t in topics if t.strip()]))
        skills = []
        for s in _as_list(delta.get("skills"), "skills"):
            if not isinstance(s, dict) or not single_line(str(s.get("body", ""))) \
                    or not single_line(str(s.get("description", ""))):
                raise Refused("delta: a skill needs name, description and body")
            name = skill_name(str(s.get("name", "")))
            if skill_state(name):
                raise Refused(f"delta: skill {name} exists already")
            if any(n == name for n, _s in skills):
                raise Refused(f"delta: skill {name} appears twice")
            skills.append((name, s))
        # Write: the old page first, so a crash never loses it.
        old = mem_dir() / "front" / f"{front['page']}.md"
        if front["page"] > 0 or (mem_dir() / "front.md").exists():
            if old.exists():
                # A run killed between its two writes left this page here
                # already. Its number and durable parts define it (In flight
                # belongs to the session, which may have checkpointed since):
                # the same page is kept as it is, a different one is refused.
                kept = read_front(old)
                if kept["page"] != front["page"] or any(
                        kept["parts"][k] != front["parts"][k] for k in consolidated):
                    raise Refused(f"{old} exists already and is not front.md's page "
                                  f"{front['page']}; look at both before going on")
            else:
                write_text(old, render_front(front))
        write_text(mem_dir() / "front.md", render_front(new_front))
        made = []
        for prefix, title, c, ev, rels, topics in staged_claims:
            made.append(write_claim(prefix, title, str(c["statement"]), str(c.get("scope", "")),
                                    str(c.get("hedge", "")), ev, rels, topics))
        for name, s in skills:
            d = skill_dir("candidates", name)
            write_text(d / "SKILL.md", f"---\nname: {name}\ndescription: "
                       f"{json.dumps(single_line(str(s['description'])))}\n---\n\n{str(s['body']).strip()}\n")
            j = add_journal(f"skill {name} proposed by consolidation", "consolidation",
                            str(s["description"]))
            log_skill("proposed", name, "files=SKILL.md", j)
        write_text(mem_dir() / "consolidated", f"J-{through}\n")
        j = add_journal(f"consolidated through J-{through} into front page {new_front['page']}",
                        "consolidation", ("staged: " + " ".join(made)) if made else "")
        refresh_pages()
    print(f"Front page {new_front['page']} written; consolidated through J-{through} ({j}).")



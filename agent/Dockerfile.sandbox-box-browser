FROM rs-sandbox-box:latest

# rs-sandbox-box-browser — a disposable sandbox box with a browser bundled in:
# rs-sandbox-box + @playwright/mcp + Chromium, wired into the box's claude as a
# stdio MCP. Selected by the websearcher box preset (image="browser"); Chromium
# is heavy, so base-image presets stay lean.
#
# This lifts ONLY the playwright tool bundle from the websearcher image (same
# version pins, same render-extra-mcps.py source-of-truth and deny list) — NOT
# its role.md / harness. Two modes, chosen per box at create:
#   restricted (the IMAGE DEFAULT) — the role's reviewed deny list for EVERY
#     agent in the box (claude through the managed settings below, pi through
#     the box render reading denied-tools.json), and the server starts through
#     playwright-env-clear, so no runtime PLAYWRIGHT_MCP_* variable widens its
#     tool list. A guardrail against page content steering the agent, not a
#     wall: the agent keeps its shell and sudo.
#   trusted — rs-sandbox lays an empty-deny managed-settings file over the
#     baked one (read-only, at docker run) and sets RS_BOX_BROWSER=trusted, and
#     the box render then uses extra-mcps.trusted.json (no wrapper) and hides
#     nothing from pi. rs-sandbox does that only on an image carrying the
#     research.box.browser-trust label below; anything else runs restricted.
#
# Version pins are deliberate (rebuild + project recreate to bump), same
# discipline as the websearcher image they mirror.

USER root
ARG NODE_MAJOR=22
ARG PLAYWRIGHT_MCP_VERSION=0.0.76
ARG PYYAML_VERSION=6.0.3

# Node.js (NodeSource pin) + dumb-init (subreaper for the Playwright ->
# Chromium subprocess tree, per the websearcher image's reasoning).
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs dumb-init && \
    rm -rf /var/lib/apt/lists/* && \
    node --version && npm --version && dumb-init --version

# pyyaml for the build-time render step (harmless to leave installed).
RUN /opt/conda/bin/pip install --no-cache-dir "pyyaml==${PYYAML_VERSION}"

# @playwright/mcp + Chromium, installed at build (never `npx -y` at runtime).
# PLAYWRIGHT_BROWSERS_PATH is system-wide so the runtime `worker` user reads
# the same Chromium the build-time root install wrote.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
RUN npm install -g "@playwright/mcp@${PLAYWRIGHT_MCP_VERSION}" && \
    mkdir -p ${PLAYWRIGHT_BROWSERS_PATH} && \
    cd "$(npm root -g)/@playwright/mcp" && \
    PATH="$PWD/node_modules/.bin:$PATH" \
        playwright install --with-deps chromium && \
    chmod -R a+rX ${PLAYWRIGHT_BROWSERS_PATH} && \
    rm -rf /var/lib/apt/lists/*

# The capability marker rs-sandbox and the host gate read (docker image
# inspect): this image can run a TRUSTED browser box. An image without it (one
# built before trusted boxes existed) only ever runs restricted.
LABEL research.box.browser-trust=1

# The environment-clearing wrapper the restricted server starts through. Copied
# BEFORE the render: the render starts the wrapped server to check its tools.
COPY agent/playwright-env-clear.sh /usr/local/lib/rs-box/playwright-env-clear
RUN chmod 755 /usr/local/lib/rs-box/playwright-env-clear

# Render the image-baked artifacts from the SAME source-of-truth the
# websearcher role uses (restricted = the role's deny list):
#   /opt/sandbox-box/extra-mcps.json          — the playwright MCP server decl,
#                                               started through the wrapper (the
#                                               restricted default); the box
#                                               render merges it into
#                                               /workspace/.mcp.json.
#   /opt/sandbox-box/extra-mcps.trusted.json  — the same decl without the
#                                               wrapper (a trusted box).
#   /opt/sandbox-box/playwright-mcp-config.json — Chromium launch flags
#                                               (referenced via --config).
#   /etc/claude-code/managed-settings.json    — claude's deny of the list
#                                               (highest-precedence permission
#                                               scope; a trusted box gets an
#                                               empty one laid over it).
#   /opt/sandbox-box/denied-tools.json        — the same list for pi: the box's
#                                               MCP render marks those tools
#                                               `hidden` on the server's entry
#                                               (restricted only).
COPY container/role-mcp/websearcher/extra-mcps.yaml      /tmp/extra-mcps.yaml
COPY container/role-mcp/websearcher/render-extra-mcps.py /tmp/render-extra-mcps.py
RUN /opt/conda/bin/python3 /tmp/render-extra-mcps.py \
        --yaml                 /tmp/extra-mcps.yaml \
        --bin                  "$(command -v playwright-mcp)" \
        --out-extra            /opt/sandbox-box/extra-mcps.json \
        --out-config           /opt/sandbox-box/playwright-mcp-config.json \
        --out-managed-settings /etc/claude-code/managed-settings.json \
        --out-denied           /opt/sandbox-box/denied-tools.json \
        --wrap                 /usr/local/lib/rs-box/playwright-env-clear \
        --out-extra-unwrapped  /opt/sandbox-box/extra-mcps.trusted.json && \
    chmod 644 /etc/claude-code/managed-settings.json /opt/sandbox-box/denied-tools.json \
              /opt/sandbox-box/extra-mcps.json /opt/sandbox-box/extra-mcps.trusted.json && \
    rm /tmp/extra-mcps.yaml /tmp/render-extra-mcps.py

# Entrypoint is inherited from rs-sandbox-box — its box render merges the
# baked declaration (restricted or trusted, by RS_BOX_BROWSER) into
# /workspace/.mcp.json, so no per-image entrypoint is needed.

USER worker
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]

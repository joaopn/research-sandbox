FROM rs-substrate-base:latest

# rs-sandbox-dind — the substrate for a `--workflow sandbox-dind` project: the
# sandbox flavor PLUS inner Docker (DIND), the leaf on top of rs-substrate-base
# (STAGE_SANDBOX_DIND_AGENT).
#
# The agent (claude) is dist-delivered at boot (cp from the host-staged
# /opt/agent-dist into ~/.local) — NOT baked. The rs-sandbox box-management CLI is
# likewise NOT baked: the box harness is a standing dind utility, staged into
# /usr/local/bin at create by _stage_rs_sandbox (STAGE_DIND_UNIFY). So this image
# carries the substrate + entrypoint + the MCP proxy tooling (below); what runs
# inside (agent, box harness) is delivered per-project.

# MCP proxy support (STAGE_DIND_UNIFY): extensions on a sandbox-dind project get the
# same proxy-routed upstreams as research, so bake the config renderer + the reload
# helper (which also creates the rs-inner bridge). mcp_render_config.py is stdlib —
# the shared miniconda3 base ships python3, so NO pip. Mirror of Dockerfile.supervisor.
RUN mkdir -p /opt/mcp-proxy-tools
COPY container/supervisor/mcp_render_config.py /opt/mcp-proxy-tools/mcp_render_config.py
COPY container/supervisor/mcp-reload.sh /usr/local/lib/rs/mcp-reload
RUN chmod +x /usr/local/lib/rs/mcp-reload

# Keep ~/.local/bin (where the dist-deployed agent launcher lands) on PATH,
# captured into the skel below so the restored home + every login shell sees it.
# rs-substrate-base / rs-minimal-base don't export it (mirrors Dockerfile.supervisor).
RUN su - research -c 'echo "export PATH=\"\$HOME/.local/bin:\$PATH\"" >> ~/.bashrc'

# Snapshot the home (byobu from the base + the PATH export) for first-boot restore.
RUN cp -a /home/research /etc/research-skel

# Dev-lane tooling for the dev workflow (the supervisor-level agent works the
# repo), kept in RS's folder and linked onto PATH by the host in a dev project
# only. rs-wt (one worktree per unit of work) refuses outside the dev lane: the
# discovered clone's origin remote must be the shared Gitea. rs-land
# (approval-gated landing: archive tag -> ff-only merge -> branch delete) and
# rs-board (the per-area kanban boards on the shared Gitea) exit with a remedy
# when no dev wiring is staged.
COPY container/dev/rs-wt container/dev/rs-land container/dev/rs-board /usr/local/lib/rs/
RUN chmod +x /usr/local/lib/rs/rs-wt /usr/local/lib/rs/rs-land /usr/local/lib/rs/rs-board
# rs-docs (a repository's docs site: init, check, build) and the site files it
# finds beside its own resolved path (Docker copies a folder's contents, so the
# destination names the folder).
COPY container/dev/rs-docs /usr/local/lib/rs/
COPY container/dev/docs-site /usr/local/lib/rs/docs-site/
RUN chmod +x /usr/local/lib/rs/rs-docs

# The researcher project type's memory command, kept in RS's folder and linked
# onto PATH by the host only in a project whose record says memory: true. The
# label is the command's version: the host requires its own MEMORY_KIT_VERSION
# (a researcher create or start on an image with an older command, or none,
# stops with a Rebuild-all error). Bump both together whenever the researcher
# instructions start relying on something new in rs-memory.
COPY container/researcher/rs-memory /usr/local/lib/rs/rs-memory
# The referee's instruction, read by rs-memory referee from beside the command.
COPY container/researcher/rs-memory-referee.md /usr/local/lib/rs/rs-memory-referee.md
RUN chmod 755 /usr/local/lib/rs/rs-memory && chmod 644 /usr/local/lib/rs/rs-memory-referee.md
LABEL research.memory-kit=3

COPY agent/entrypoint.sandbox-dind.sh /entrypoint.sh
# This image's boot writes nothing into /workspace/.claude/ or /workspace/.pi/
# (RS's files live in the agents' homes): the host refuses to create or start
# a sandbox-dind project on an image without this value (an older boot made
# folders there). MIRROR of rscore.INSTRUCTIONS_LAYOUT_HOME (pinned).
LABEL research.instructions-layout=home-2
RUN chmod +x /entrypoint.sh

USER research
WORKDIR /home/research

# The inner guard in this image lets a box reach the shared MCP gateway.
LABEL research.mcp-gateway-guard=1

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]

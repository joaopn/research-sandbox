FROM rs-ext-base:latest

# rs-sandbox-box — the disposable box image for the agent-less sandbox-project
# flavor (--workflow sandbox-dind, STAGE_SANDBOX_PROJECT.md). A clean, blank
# container for running un-vetted code in isolation.
#
# Rebased onto rs-ext-base (STAGE_FEATURE_STAGING lane-3): research-DECOUPLED, so
# editing rs-analysis-base no longer rebuilds boxes, and the box is registry-
# delivered (pull, not save/load). LEAN by design — it carries NONE of the
# rs-analysis-base data-science conda stack (pandas/numpy/jupyter/…); pip-install
# inside the box as needed. It also carries NONE of the PI artifact-contract
# (rs-ext-base bakes none). It inherits from rs-ext-base: conda (python), byobu,
# tini, the worker user + skel, ~/.local/bin on PATH, and /opt/pi-templates/
# greet-and-shell.sh (so the box's webui tab greet step works). Adds:
#   - git: to clone a repo you want to inspect before trusting it.
#   - iputils-ping: basic reachability checks from inside the box.
# Plus a minimal idle entrypoint (no clone, no creds, no artifact surfaces); it
# writes its own bypassPermissions settings.json + cp's the agent/editor dists at
# boot, so no claude/editor is baked here.

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        git iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# Minimal idle entrypoint (also rs-ext-base's default; re-COPYd here so the box
# image is explicit about what it runs).
COPY agent/entrypoint.sandbox-box.sh /entrypoint.sh
# The box's MCP render: run by the entrypoint at boot, and streamed by the host
# into a running box when an agent change gives it pi (one source, two callers).
COPY agent/box-render-mcp.py /usr/local/lib/rs-box/box-render-mcp.py
# This image's boot writes nothing into the box's /workspace/.claude/ or
# /workspace/.pi/ (pi's MCP settings and the skills go into the agents' homes):
# a project refuses a host box image without this value before it publishes it
# (an older boot re-creates /workspace/.pi/mcp.json at every start). The browser
# image inherits it. MIRROR of rscore.INSTRUCTIONS_LAYOUT_HOME (pinned).
LABEL research.instructions-layout=home-2
RUN chmod +x /entrypoint.sh

# Dev-lane tooling (rs-wt, rs-land, rs-board, rs-docs) — in RS's folder, deliberately
# OFF PATH (command-relevance): only a dev-preset box gets them symlinked to
# /usr/local/bin (rs-sandbox's _link_box_commands, at the box's docker run);
# on other boxes the files are inert and invisible to tab-completion.
COPY container/dev/rs-wt container/dev/rs-land container/dev/rs-board /usr/local/lib/rs/
RUN chmod +x /usr/local/lib/rs/rs-wt /usr/local/lib/rs/rs-land /usr/local/lib/rs/rs-board
# rs-docs (a repository's docs site: init, check, build) and the site files it
# finds beside its own resolved path (Docker copies a folder's contents, so the
# destination names the folder).
COPY container/dev/rs-docs /usr/local/lib/rs/
COPY container/dev/docs-site /usr/local/lib/rs/docs-site/
RUN chmod +x /usr/local/lib/rs/rs-docs

# F3 loopback forwarder (STAGE loopback-bridge): republishes a 127.0.0.1-bound
# in-box service onto the box's bridge IP so the -p <pub_super>:<app_port> publish
# (rs-sandbox expose) reaches it. Launched by rs-sandbox via docker exec -d.
COPY cli/rs_loopback_fwd.py /usr/local/lib/rs/rs-loopback-fwd
RUN chmod +x /usr/local/lib/rs/rs-loopback-fwd

# Preset web apps: rs-web-loop keeps the box's web app running at its webui
# tab's address (started by the entrypoint when RS_BOX_WEB_START is set),
# rs-web-set is the host's one call that hands it the address, rs-web-restart
# is the operator's restart command (linked onto PATH in a web box only).
# rs-sandbox probes for rs-web-loop's path to tell this image from one that
# predates web apps.
COPY agent/rs-web-loop agent/rs-web-set agent/rs-web-restart /usr/local/lib/rs/
RUN chmod +x /usr/local/lib/rs/rs-web-loop /usr/local/lib/rs/rs-web-set \
    /usr/local/lib/rs/rs-web-restart
# RS's helper-command layout: only what a person or an agent types is on
# PATH; RS's own helpers (and typed commands only some containers get, linked
# onto PATH by the host) live in /usr/local/lib/rs. The host refuses an image
# without this label (MIRROR of rscore.RS_COMMANDS_LABEL / RS_COMMANDS_LAYOUT,
# pinned).
LABEL research.rs-commands="1"

USER worker
WORKDIR /workspace
# tini (PID 1) comes from rs-ext-base.
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]

# research-sandbox configuration. Copy to .env and edit.

# Directory for project workspaces on the host.
# Each project's /workspace is bind-mounted from <PROJECTS_DIR>/<project>/workspace/.
# Default (when unset): <repo>/container_volumes/.
# `project destroy` deletes <PROJECTS_DIR>/<project>/ recursively, including
# the .claude/.credentials.json snapshot.
# Also bind-mounted RO into the optional webui container at /projects so the
# rail can render per-project worker counts, disk usage, and last-activity.
PROJECTS_DIR=./container_volumes/

# DNS servers for supervisor and worker containers (comma-separated, publicly routable).
# Defaults to Quad9. Required.
SANDBOX_DNS=9.9.9.9,149.112.112.112

# Default memory limit for supervisor containers (Docker size string, e.g. 8g).
# DEFAULT_MEMORY=

# Per-role-MCP container memory cap (Docker size string). Blast-radius
# backstop: if a runaway claude -p / Chromium / DB-MCP child triggers OOM,
# the killer takes the role container, not the supervisor. Default 2g.
# Persisted in role-mcps.json at enable time; existing entries keep their
# captured value across recreates. Override per-role at enable:
# `research project role-mcp enable <project> <role> --memory 4g`.
# DEFAULT_ROLE_MCP_MEMORY=2g

# Per-role-MCP daemon-side concurrency cap. send_job calls beyond this
# return an MCP tool error with structured `concurrency_limit` payload
# immediately — no spawn, no resource waste on calls that wouldn't run.
# 0 disables the cap. Default 3. Pair with DEFAULT_ROLE_MCP_MEMORY:
# bumping memory should bump this proportionally. Override per-role at
# enable: `--max-concurrent-calls 6`.
# DEFAULT_ROLE_MCP_MAX_CONCURRENT_CALLS=3

# Default image profile for the supervisor (only "python" in Stage 1).
DEFAULT_PROFILE=python

# DIND mode: sysbox | privileged | auto (default: auto — prefers sysbox if installed).
# Forces all supervisors to use the given runtime. CLI --dind flag overrides per-project.
# DEFAULT_DIND=auto

# Default egress policy at the host-side router: open | locked (default: open).
# Stage 1 research workloads generally need open (pip install etc.). Tighten per-project
# with `research project create --egress locked` when you want restriction.
# DEFAULT_EGRESS=open

# Webui (optional browser UI; opt-in via `research webui start`).
# Defaults bind to localhost only. Override BIND to expose on the LAN
# (e.g. WEBUI_BIND=0.0.0.0); the self-signed cert auto-rotates to cover
# the new bind. `research webui start --bind <ip>` updates this in place.
# WEBUI_BIND=127.0.0.1
# WEBUI_PORT=7777

# Per-editor browser-origin port range. Each in-project HTTP surface (the
# supervisor editor, each box editor, each exported-port app) is served on its
# own webui port so the browser gives it an isolated storage origin (layout,
# Ports view, recents no longer shared across containers). The webui container
# squats the WHOLE range for its lifetime (docker publishes it at start);
# `research webui start` fails loudly if any port here is already in use —
# free the port or move the range, then re-run. Open these alongside
# WEBUI_PORT wherever the webui is firewalled.
# WEBUI_ORIGIN_PORT_LO=10100
# WEBUI_ORIGIN_PORT_HI=10164

# Pass-through port block. Ports here can be claimed by a project (webui: the
# project's Ports section, or Management → Pass-through ports) and are then
# forwarded UNTOUCHED — raw TCP, no TLS termination, port numbers preserved —
# to the claiming project's container. For encrypted and/or multi-port software
# the page-relay tab structurally can't front (e.g. an RS instance nested
# inside a project). These connections do NOT pass the webui login; the app's
# own auth is the only lock — the claim dialog warns about this. The webui
# squats the whole range like the origin range above; `research webui start`
# fails loudly on conflicts and refuses overlap with WEBUI_PORT or the origin
# range. Open these alongside WEBUI_PORT wherever the webui is firewalled.
# WEBUI_PASSTHROUGH_PORT_LO=10200
# WEBUI_PASSTHROUGH_PORT_HI=10299

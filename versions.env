# Image version pins — the TRACKED repo baseline (kept in lockstep with the code).
#
# Every per-image `ARG <NAME>=<default>` in agent/Dockerfile.* keeps its
# default as a standalone-build fallback, but `_build_images` in research.py
# reads the EFFECTIVE pins (this base overlaid with the untracked override, see
# below) and passes each value as `docker build --build-arg`, so the numbers in
# effect win for every image the substrate builds.
#
# Two layers (load_versions merges them; override wins per-key):
#   - versions.env       (this file, TRACKED)   — the repo baseline; a maintainer
#                          edits it and COMMITS to move the baseline for everyone.
#   - versions.local.env (UNTRACKED, gitignored) — per-instance overrides; a local
#                          upgrade lands here and never touches committed source.
#
# Workflow (mirrors the DOCKER_VERSION discipline):
#   edit a pin -> `python research.py start --rebuild` -> destroy+recreate
#   affected projects (a rebuild does not reach existing projects until they
#   are recreated / _recreate_supervisor re-stages the image).
# Revert a LOCAL bump = delete its key from (or remove) versions.local.env, then
# rebuild. Revert a BASELINE change = `git checkout versions.env`. There is no
# bespoke upgrade/revert command by design — with TWO sanctioned writers, both
# targeting the UNTRACKED override: `research agent refresh` writes
# CLAUDE_CODE_VERSION (the agent-dist pin) and `research editor refresh` writes
# CODE_SERVER_VERSION (the editor-dist pin); each checks upstream, offers to bump
# the pin, and re-pulls the dist (STAGE_AGENT_DIST / STAGE_EDITOR_DIST). Because
# they write versions.local.env, there is nothing to commit.
#
# Format: KEY=VALUE, one per line, `#` comments on their own lines. Parsed by
# load_versions() with the stdlib (no TOML — research.py targets Python 3.9+).

# code-server 4.123.0 bundles VS Code 1.123.0. The EDITOR-DIST pin only — no
# longer a Dockerfile build-arg: the minimal-base bake was removed in
# STAGE_EDITOR_DIST slice 2, so no image bakes code-server. This is the version
# `research editor pull` builds into ~/.research-sandbox/editor-dist/ and that
# every interactive container deploys via `cp` at boot. `research editor refresh`
# is the sanctioned writer (checks upstream, offers to bump, re-pulls).
# Two caveats before bumping:
#   - the strip list (a fixed set of built-in extensions by directory name) now
#     lives only in rscore._CODE_SERVER_STRIP_EXTS (the dist build) — a major
#     code-server bump can rename/drop those, so revalidate the Editor tab.
#   - extensions checking `engines.vscode` (e.g. anthropic.claude-code) are
#     gated by the *bundled VS Code* version, not the code-server version.
CODE_SERVER_VERSION=4.126.0

# Inner docker-ce, installed via get.docker.com. Bumps are deliberate (inner
# dockerd runs under sysbox; crun is the inner OCI runtime).
DOCKER_VERSION=29.5.3

# Editor-bundled VS Code extensions (EDITOR-DIST pins only — not Dockerfile build
# args). The dist downloads each .vsix fresh in-container at `research editor pull`
# from Open VSX (all UNIVERSAL packages), and code-server-deploy.sh installs every
# .vsix in templates/extensions/ on first boot. Bump by hand-editing here (eyeball
# the Open VSX item page, see VERSION_SOURCES), then `research editor pull`.
PYTHON_EXT_VERSION=2026.4.0
JUPYTER_VERSION=2025.9.1
JUPYTER_CELL_TAGS_VERSION=0.1.9
JUPYTER_KEYMAP_VERSION=1.1.2
JUPYTER_RENDERERS_VERSION=1.3.0
JUPYTER_SLIDESHOW_VERSION=0.1.6

# Reader dist pins (STAGE_READER) — the mobile artifact reader supervisor service.
# DIST-PIN-ONLY (no Dockerfile ARG): like the agent/editor dists, `research reader
# pull` builds a version-pinned pip payload (nbconvert + markdown) into
# ~/.research-sandbox/reader-dist/ inside a throwaway rs-minimal-base container,
# and every reader-enabled supervisor cp's it in at boot. `research reader refresh`
# is a sanctioned writer (checks PyPI, offers to bump, re-pulls). NOTE: the webui
# IMAGE pins its own markdown copy via the MD_LIB_VERSION *Dockerfile ARG*
# (webui/Dockerfile) — a SEPARATE pin home (scoped ./webui build context); this
# MARKDOWN_LIB_VERSION is the reader-dist copy and MUST NOT be unified with it.
NBCONVERT_VERSION=7.17.1
MARKDOWN_LIB_VERSION=3.10.2

# Claude Code CLI pin for the host AGENT DIST (no longer a Dockerfile build-arg —
# the bake was removed in STAGE_AGENT_DIST slice 2; no image bakes claude). This
# is the version `research agent pull` builds into ~/.research-sandbox/agent-dist/
# and that every container (supervisor + worker/role-MCP/PI/sandbox-box) deploys
# via `cp` at boot. Bump it with `research agent refresh` (the sanctioned writer;
# it checks upstream, offers to bump, re-pulls), then re-`pull` is implicit. A
# `project update-agent` / recreate re-stages the new dist into a running project.
CLAUDE_CODE_VERSION=2.1.258

# Claude Code VS Code extension (Anthropic.claude-code) for the host AGENT DIST
# (STAGE_AGENT_EXTENSIONS). Bundled into claude's dist as
# share/rs-agent-ext/anthropic.claude-code.vsix at `research agent pull`, and
# installed by code-server-deploy.sh ONLY in containers where claude is deployed
# — so the agent-less management box never gets it. Sourced from Open VSX
# (the registry code-server defaults to), platform-pinned linux-x64.
#
# A SEPARATE key from CLAUDE_CODE_VERSION above, but no longer bumped separately:
# `research agent refresh` is a sanctioned writer for BOTH, resolving each against
# its own upstream and moving them in tandem (they are resolved independently, not
# derived from each other — Open VSX can trail the CLI release by hours, and a
# derived version would 404 the .vsix and fail the dist build inside that window).
# Like every sanctioned writer it targets the UNTRACKED versions.local.env, so a
# local bump never touches this file. Editing the value here is a maintainer
# BASELINE move for everyone; `research images outdated` resolves it live.
CLAUDE_CODE_EXT_VERSION=2.1.258

# Image-baked stdio MCP / pip pins shared across role-MCP + sandbox-box-browser
# + PI websearcher images. Single home here kills the former triplication.
PLAYWRIGHT_MCP_VERSION=0.0.76
PYYAML_VERSION=6.0.3
AIOHTTP_VERSION=3.14.1

# Node.js runtime SEED (STAGE_NODE_SEED) for node-based workflows. DIST-PIN-ONLY
# (no Dockerfile ARG). Unlike the agent/editor/reader dists, node is a SEED, not a
# managed dist: it is `cp`'d into a box once (so a node workflow works out of the
# box) and then DETACHED — RS neither tracks nor updates it, and a box that runs
# `npm i -g n` to upgrade its own node keeps it across restarts. There is
# deliberately NO sanctioned auto-writer (no `research node refresh`); bump by
# hand-editing here + `research node pull`, which re-seeds the host cache. A bump
# reaches a project only on a fresh create/recreate — a restart keeps the box's
# node, by design. LTS-pinned: `open-knowledge` (and node workflows generally)
# declare `engines: node>=24`, so this is load-bearing, not decorative. 24.x is the
# current Active LTS (Krypton); the tarball is fetched .tar.gz (rs-minimal-base has
# no xz-utils). Verify the source page (VERSION_SOURCES) before bumping.
NODE_VERSION=24.18.0

# --- Extension lane (STAGE_FEATURE_STAGING C1) ------------------------------
# Local image registry for portable EXTENSION images. A stock `registry:2`
# container on rs-sandbox, connected to each per-project network so a project's
# inner dockerd pulls extension images by container DNS (rs-registry:5000) over
# its OWN subnet — never crossing the router's RFC1918 DROP. The host PUSHES via a
# loopback-published port (127.0.0.1:<REGISTRY_HOST_PORT>), which Docker trusts as
# insecure-by-default, so NO host daemon.json change is needed; only the inner
# dockerd lists rs-registry:5000 in insecure-registries (Dockerfile.substrate-base).
# REGISTRY_HOST_PORT is the HOST loopback port ONLY — the in-container listen port
# is fixed at 5000 to match the insecure-registries entry + the pull locator.
# Override REGISTRY_HOST_PORT if 5000 is already taken on the host.
REGISTRY_VERSION=2.8.3
REGISTRY_HOST_PORT=5000

# Generic box image pins (STAGE_FEATURE_STAGING lane-3). The two blank-box images
# are GENERIC images registry-delivered via extension.GENERIC_REGISTRY_IMAGES. They
# have no upstream version, so the pin is a CONTENT-SNAPSHOT tag — bump on image
# content change, then `research start --rebuild` (rebuilds + retags + the next
# box-create re-pushes/snapshots). The pin is frozen into a project's project.json
# (box_image_pins) at create, so a bump here reaches a project only on a fresh
# box-create — a restart/recreate never silently changes the version.
SANDBOX_BOX_VERSION=0.1.0
SANDBOX_BOX_BROWSER_VERSION=0.1.0

# --- Dev lane (STAGE_DEV_GITEA S1) ------------------------------------------
# Shared host-level Gitea for the dev workflow (ADS fold-in): one standing
# rs-gitea container (registry-pattern lazy stand-up + per-project wire), stock
# upstream image pinned here — NOT a Dockerfile build, so this is a plain
# image-tag pin like REGISTRY_VERSION. Bump deliberately + management-managed
# (report via the Software panel); `research start` re-pulls on demand.
# GITEA_HOST_PORT is the HOST LOOPBACK publish port ONLY (admin API for the
# host-side dev verbs); the in-container listen port is fixed at 3000. Override
# GITEA_HOST_PORT if 3000 is already taken on the host.
GITEA_VERSION=1.25.1
GITEA_HOST_PORT=3000
